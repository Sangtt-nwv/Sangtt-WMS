[Form]
public class TFMRegexLookup extends FormRun
{
    boolean                 okButtonClicked;
    Map                     idx2text;

}
]]></Source>
			</Method>
			<Method>
				<Name>closeSelect</Name>
				<Source><![CDATA[
    public void closeSelect(str _selectString)
    {
        if(okButtonClicked)
        {
            super(_selectString);
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    public void init()
    {
        
		okButtonClicked = false;
        super();
        idx2text = new Map(Types::Integer, Types::String);
        idx2text.insert(ListView.add('Match to given value'), 'Make a regular expression that can match the value \'TFSD-10000\', where the last five digits are variable.');
        idx2text.insert(ListView.add('Match to description'), 'Make a regular expression that can match against a value consisting of four alphanumeric characters, then a dash, and then a number of varying length');
    }

]]></Source>
