        /// <summary>
        ///
        /// </summary>
        /// <param name = "_Idx"></param>
        /// <param name = "_Data"></param>
        public void selectionChanged(int _Idx, anytype _Data)
        {
            super(_Idx, _Data);
            InputField.text(idx2text.lookup(_Idx));
        }

]]></Source>
					</Method>
				</Methods>
			</Control>
