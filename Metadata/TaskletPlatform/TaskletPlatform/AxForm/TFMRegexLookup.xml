					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        /// <summary>
        ///
        /// </summary>
        public void clicked()
        {
            super();
            suggestedRegex.text(TFMRegexLookupHelper::getAIRegexSuggestion(InputField.text()));
        }

]]></Source>
