					<Method>
						<Name>active</Name>
						<Source><![CDATA[
        public int active()
        {
            int ret;            
			
            TFMPageType type;
            SysDictClass dc;
            TFMPageTypeAttribute pageAttr;
            TFMDataSourceBlock	dsBlock;
            int					i;
            DataBinding.visible(false);
            if(!TFMPageDatasources.PageID)
            {
                Info("@TFM:Nodatasourceshasbeencreatedforth");
                Fields.enabled(false);
                Filters.enabled(false);
                return 0;
            }
            Fields.enabled(true);
            Filters.enabled(true);

            page = TFMPagesProvider::getAllPages().getPage(TFMPageDatasources.PageID);
            type = page ? page.parmType() : '';
            dc = new SysDictClass(classIdGet(page));
            pageAttr = dc.getAttribute(classStr(TFMPageTypeAttribute));
            SetEnumerator extendingClasses = TFMPageDatasources.GetDataSourceBlocks(null).getEnumerator();
            Grouping.enabled(pageAttr.parmPageType() == 'OrderLines');
            ret = super();
			while (extendingClasses.moveNext())
            {
                dsBlock = extendingClasses.current();

                pageAttr = new SysDictClass(classIdGet(dsBlock)).getAttribute(classStr(TFMPageTypeAttribute));
                edt.populateGroupWithDocParms(classIdGet(dsBlock),parmGroup,pageAttr.parmLabel(), i > 0, dsBlock);
                edt.parmDataSource(TFMPageDatasources);
                i++;
            }

            
			//UpdateSortOrder
            SortOrder.selection(TFMGenericParms::getValue(TFMPageDatasources.PageID,enumStr(AscendingDescending),'',AscendingDescending::Ascending));
            SortOrder.allowEdit(TFMPageDatasources.SortingField != '');
            TFMPageDatasources_SortExpression.allowEdit(TFMPageDatasources.SortingField != '');
            AddButton.enabled(false);
            element.design().controlName(formControlStr(TFMDataSources, Filters)).visible(page.parmFilter() != '');
            if (page.parmFilter())
            {
                treeBuilder = TFMFilterTreeBuilder::Construct(DocumentTree,contentFromTree,DataBinding,page.parmFilter());
                treeBuilder.setButtons(AddButton, DeleteButton);
            
                DocumentTree.select(treeBuilder.buildTree(0,0));
            }
            return ret;
        }

]]></Source>
					</Method>
					<Method>
						<Name>menuItemIcon</Name>
						<Source><![CDATA[
        public display container menuItemIcon(TFMPageDatasources _record)
        {
            ImageReference	imgRef;
            TFMPage localpage = TFMPagesProvider::getAllPages().getPage(_record.PageID);
            if(localpage  != null)
            {
                imgRef = ImageReference::constructForUrl(TFMDocGetMedia::getURLFromIconName(localpage.parmIcon(), false));
            }
            else
            {
                imgRef = ImageReference::constructForAotResource(resourceStr(TFMMissingImage));
            }
            return imgRef.pack();
        }

]]></Source>
