				<Name>init</Name>
				<Source><![CDATA[
	public void init()
    {
        TFMDisplayLineOverrideLines::MigrateLinesToDatasource();
        super();
        edt = new TFMDatasourceParametersEdit(parmGroup);
    }

]]></Source>
			</Method>
			<Method>
				<Name>run</Name>
				<Source><![CDATA[
    public void run()
    {
        URLUtility urlUtil = new URLUtility();

        TFMPageId pageName;
        

        if (element.args().caller() && element.args().caller().name() == formStr(TFMPageOverview))
        {
            page = element.args().caller().getCurrentPage();
            pageName = page.parmId();
        }
        else
        {
            pageName = urlUtil.getQueryParamValue('PageId');
        }
        super();
        
        TFMPageDatasources_DS.queryBuildDataSource().addRange(fieldNum(TFMPageDatasources,PageId)).value(pageName ? pageName : '*');
        TFMPageDatasources_DS.executeQuery();
    }

]]></Source>
