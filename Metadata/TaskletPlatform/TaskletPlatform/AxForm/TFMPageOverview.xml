			<Method>
				<Name>run</Name>
				<Source><![CDATA[
    public void run()
    {
        TFMPageID				pageName = new URLUtility().getQueryParamValue('PageId');
        FormStringControl		filterControl;
        System.Runtime.Caching.ObjectCache memCache = System.Runtime.Caching.MemoryCache::Default;
        str cacheId = formstr(TFMPageOverview) + TFMPageOverviewFormClass::cacheTimeStamp() + strLwr(curExt());
        pagePreviews = memCache.Get(cacheId);
        if(!pagePreviews)
        {
            pagePreviews = new Map(Types::String, Types::String);
            memCache.Add(cacheId, pagePreviews, new System.Runtime.Caching.CacheItemPolicy());
        }
        
        pageOverviewClass = new TFMPageOverviewFormClass(NewGrid, TFMHtmlListCtrl_1);
        TFMHtmlListCtrl_1.setFormClass(pageOverviewClass);
        
        super();

        saveButton = this.control(this.controlId('systemdefinedsavebutton')) as FormCommandButtonControl;
        saveButton.visible(false);
        saveButton.enabled(false);       

        DevicePreview.parmSkipSanitizer(true);      

        element.setTimeoutEx(formMethodStr(TFMPageOverview,loadPagesAsync),conNull(),0);
    }

]]></Source>
