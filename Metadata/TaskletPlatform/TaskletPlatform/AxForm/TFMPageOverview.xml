			<Method>
				<Name>updateVisualAsync</Name>
				<Source><![CDATA[
    public void updateVisualAsync(AsyncTaskResult _result)
    {
        str					pageHtml;
        str                 pageId;
        this.updateGrid();
        
        pageId = pageOverviewClass.currentPage().parmId();
        str pageOutput = this.getDeviceHtml(pageId);
        if(!pageOutput)
        {
            TFMDeviceVisualization::DrawPage(pageOverviewClass.currentPage(),DevicePreview);
            pageHtml = DevicePreview.parmHtml();
            if(strScan(pageHtml, 'loading.gif', 0, 100000) == 0)
            {
                pagePreviews.insert(pageId,pageHtml);
            }
        } 
        else
        {
            DevicePreview.parmHtml(pageOutput);
        }
    }

]]></Source>
