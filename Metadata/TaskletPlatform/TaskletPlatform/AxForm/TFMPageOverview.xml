			<Method>
				<Name>getDeviceHtml</Name>
				<Source><![CDATA[
    public str getDeviceHtml(TFMPageID _pageId, boolean _forceVisualUpdate = false)
    {
        if (pagePreviews.exists(_pageId))
        {
            return pagePreviews.lookup(pageOverviewClass.currentPage().parmId());
        }
        return '';
    }

]]></Source>
