				<Fields>
					<Field>
						<DataField>OfflinePageID</DataField>
						<Methods>
							<Method>
								<Name>lookup</Name>
								<Source><![CDATA[
            /// <summary>
            ///
            /// </summary>
            /// <param name = "_formControl"></param>
            /// <param name = "_filterStr"></param>
            public void lookup(FormControl _formControl, str _filterStr)
            {
                TFMPageOfflinePages offlinePagesTable;
                TFMPages	pagesToShow = new TFMPages();
                MapEnumerator    allPagesEnum = element.pageOverviewClass.pagesOnForm.getPages().getEnumerator();

                while(allPagesEnum.moveNext())
                {
                    TFMPage page = allPagesEnum.currentValue();
                    TFMPageOrderList orderListPage = page as TFMPageOrderList;
                    if (orderListPage && orderListPage.getConfiguration())
                    {
                        TFMPageOrderListConfiguration orderListPageConf = page.getConfiguration() as TFMPageOrderListConfiguration;

                        if(orderListPageConf.parmOperationMode() == TFMOfflineModeTypes::offline)
                        {
                            // don't add if the page was added earlier
                            select firstonly offlinePagesTable where offlinePagesTable.PageID == pageOverviewClass.currentPage().parmId() && offlinePagesTable.OfflinePageID == page.parmId();
                            if(!offlinePagesTable.RecId)
                            {
                                pagesToShow.addPage(page);
                            }
                        }
                    }
                }
                
                // Add a fake adhoc registration page to show it in the list.
                TFMPage fakeAdhocRegistrationsPage = new TFMPage();
                fakeAdhocRegistrationsPage.parmId('AdhocRegistrations');
                fakeAdhocRegistrationsPage.parmTitle('AdhocRegistrations');

                select firstonly offlinePagesTable where offlinePagesTable.PageID == pageOverviewClass.currentPage().parmId() && offlinePagesTable.OfflinePageID == fakeAdhocRegistrationsPage.parmId();
                if(!offlinePagesTable.RecId)
                {
                    pagesToShow.addPage(fakeAdhocRegistrationsPage);
                }

                TFMFormLookupHelper::lookupOfflinePageNames(_formControl, element, pagesToShow);
            }

]]></Source>
