[Form]
public class TFMWorkflows extends FormRun
{
    TFMStepsSuccessionGraph graph;
}
]]></Source>
			</Method>
			<Method>
				<Name>run</Name>
				<Source><![CDATA[
    public void run()
    {
        URLUtility                      urlUtil = new URLUtility();
        Name                            wfName = urlUtil.getQueryParamValue('WorkflowName');
        TFMPageOrderLinesConfiguration	conf;
        TFMService                      service;
        TFMPageOrderLines               orderlinePage;
        TFMPage                         page;

        if (!wfName && element.args().caller() && element.args().caller().name() == formStr(TFMPageOverview))
        {
            page = element.args().caller().getCurrentPage();
            if (page is TFMPageOrderLines)
            {
                orderlinePage = page;
                conf = orderlinePage.getConfiguration();
                service = TFMServiceProvider::getServices().lookup(conf.parmId());
                wfName = service.getWorkflow();
            }
        }

        
        super();

        TFMWorkflowsTable_DS.queryBuildDataSource().addRange(fieldNum(TFMWorkflowsTable,WorkflowName)).value(wfName ? wfName : '*');
        TFMWorkflowsTable_DS.executeQuery();
    }

]]></Source>
			</Method>
		</Methods>
