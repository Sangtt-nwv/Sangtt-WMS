					<Method>
						<Name>active</Name>
						<Source><![CDATA[
        public int active()
        {
            int							ret;
            TFMWorkflowBlock			block;
            Set							dynSteps;
            SetEnumerator				collectors;
            TFMRegistrationCollector	collector;
            ClassId						classId = className2Id(TFMWorkflowSteps.CallClass);
        
            ret = super();
            delete_from TFMDocumentTmpHandlerLookup;
			if (classId)
            {
             	block = new sysDictClass(classId).makeObject();
                dynSteps = block.dynamicSteps(null,true);
                collectors = Set::union(block.steps(), dynSteps != null ? dynSteps : new Set (Types::Class)).getEnumerator();
            
				while ( collectors.moveNext())
				{
					collector = collectors.current();
					TFMDocumentTmpHandlerLookup.ClassName	= collector.parmName();
					TFMDocumentTmpHandlerLookup.Description	= strReplace(classId2Name(classidget(collector)),classStr(TFMRegistrationCollector),'');
					TFMDocumentTmpHandlerLookup.insert();
             	}
            }
            TFMDocumentTmpHandlerLookup_ds.executeQuery();
            
            return ret;
        }

]]></Source>
					</Method>
				</Methods>
				<Fields />
			</DataSource>
			<DataSource>
				<Name>TFMDocumentTmpHandlerLookup</Name>
				<Methods>
					<Method>
						<Name>active</Name>
						<Source><![CDATA[
        public int active()
        {
            int ret = super();
            TFMWorkflowBlock			block;
            SetEnumerator				collectors;
            Set							dynSteps;
            TFMRegistrationCollector	collector;
        
            if(!TFMWorkflowSteps)
            {
                return ret;
            }

            block = new sysDictClass(className2Id(TFMWorkflowSteps.CallClass)).makeObject();
            dynSteps = block.dynamicSteps(null,true);
            collectors = Set::union(block.steps(), dynSteps != null ? dynSteps : new Set (Types::Class)).getEnumerator();
			
            while ( collectors.moveNext())
            {
                collector = collectors.current();
                if (collector.parmName() == TFMDocumentTmpHandlerLookup.ClassName && strReplace(classId2Name(classidget(collector)),classStr(TFMRegistrationCollector),'') == TFMDocumentTmpHandlerLookup.Description)
                {
                    resourceNode resNode = TFMDrawFlowBlockStyleRegistrationCollector::findResourceForCollector(collector);
                    collector.PopulateGroup(BlockStepsAttributes,true,true, 'Workflow:'+TFMWorkflowsTable.WorkflowName,TFMDocumentTmpHandlerLookup.ClassName, resNode, false);
                    return ret;
                }
            }
            return ret;
        }

]]></Source>
