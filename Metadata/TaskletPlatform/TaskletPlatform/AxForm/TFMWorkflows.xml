					<Method>
						<Name>active</Name>
						<Source><![CDATA[
        public int active()
        {
            int ret;
            str xml;
            XmlDocument xmlDoc = XmlDocument::newBlank();
            XmlElement  wfs = xmlDoc.createElement('workflows');
            TFMWorkflowsTable.appendToXml(wfs);
            ExampleHtmlViewer.parmFormatAsXml('Yes');
            ExampleHtmlViewer.parmHtml(TFMFormXMLFormatter::htmlColorXML(wfs.xml()));

            xml = TFMServiceProvider::getAllServicesXML();
            ExampleServicesViewer.parmFormatAsXml('Yes');
            ExampleServicesViewer.parmHtml(TFMFormXMLFormatter::htmlColorXML(xml));
            ret = super();
            
            graph = TFMStepsSuccessionGraph::construct(FlowViewer, TFMWorkflowsTable.WorkflowName);
            graph.draw();
            return ret;
        }

]]></Source>
