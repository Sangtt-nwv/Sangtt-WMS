				<Source><![CDATA[
[Form]
public class TFMListLookup extends FormRun
{
    boolean						okButtonClicked;
    

}
]]></Source>
			</Method>
			<Method>
				<Name>closeSelect</Name>
				<Source><![CDATA[
    public void closeSelect(str _selectString)
    {
        if(okButtonClicked)
        {
            super(_selectString);
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>closeSelectRecord</Name>
				<Source><![CDATA[
    public void closeSelectRecord(Common _selectedRecord)
    {
        if (okButtonClicked)
        {
            if (element.args().caller().name() == formStr(SysTableBrowser))
            {
                element.closeSelect(int642str(_selectedRecord.RecId));
            }
            else
            {
                super(_selectedRecord);
            }
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    public void init()
    {
        
        MapEnumerator		listsEnum = TFMListsProvider::getAllLists().listMap().getEnumerator();
        TFMList				listClass;
        FormStringControl   fromControl;
		okButtonClicked = false;
        super();

        while (listsEnum.moveNext())
        {
            listClass			= listsEnum.currentValue();
            Lists.add(listClass.parmListName());                        
        }        
        if (element.selectTarget() is FormStringControl)
        {
            fromControl = element.selectTarget();
            Lists.selectText(fromControl.text());
            Lists.selectionChange();
        }
        
    }

]]></Source>
			</Method>
		</Methods>
		<DataSources xmlns="" />
		<DataControls xmlns="">
			<Control>
				<Name>Lists</Name>
				<Type>ListBox</Type>
				<Methods>
					<Method>
						<Name>selectionChange</Name>
						<Source><![CDATA[
        /// <summary>
        ///
        /// </summary>
        /// <returns></returns>
        public int selectionChange()
        {
            int ret;
    
            ret = super();

            TFMListVisualization::DrawList(HtmlViewerControl, this.getText(Lists.selection()), TFMListsVersion::newestVersion(this.getText(Lists.selection()), false), false, false, null);
    
            return ret;
        }

]]></Source>
					</Method>
				</Methods>
			</Control>
			<Control>
				<Name>OK</Name>
				<Type>CommandButton</Type>
				<Methods>
					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        void clicked()
        {
            okButtonClicked = true;

            if (element.selectTarget() is FormStringControl)
            {
                element.closeSelect(Lists.getText(Lists.selection()));
            }            
            else
            {
                element.closeSelectRecord(TFMLists::Find(Lists.getText(Lists.selection())));
            }

            super();
        }

]]></Source>
					</Method>
				</Methods>
			</Control>
