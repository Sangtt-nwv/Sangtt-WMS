						<Name>active</Name>
						<Source><![CDATA[
        /// <summary>
        ///
        /// </summary>
        /// <returns></returns>
        public int active()
        {
            TFMProcessRegistrationTmp tmpRec;
            
            int ret;
    
            ret = super();
            tmpRec = formClass.updateSessionId(TFMProcessSessions.ProcessSessionID, TFMProcessRegistrationTmp);
            TFMProcessRegistrationTmp_ds.research();
            TFMProcessRegistrationTmp_ds.executequery();
            TFMProcessRegistrationTmp_DS.refresh();

            DataResultsButton.enabled(TFMProcessSessionsDataCollected::SessionHasData(TFMProcessSessions.ProcessSessionID));
            return ret;
        }

]]></Source>
					</Method>
					<Method>
						<Name>init</Name>
						<Source><![CDATA[
        /// <summary>
        ///
        /// </summary>
        public void init()
        {
            super();
            TFMProcessSessions_DS.queryBuildDataSource().addRange(fieldNum(TFMProcessSessions, Posted)).value('Yes');
            
        }

]]></Source>
