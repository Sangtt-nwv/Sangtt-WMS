				<Source><![CDATA[
[Form]
public class TFMResourceLookup extends FormRun
{
    boolean                     okButtonClicked;
    TFMResourceLookupFormClass  formClass;

}
]]></Source>
			</Method>
			<Method>
				<Name>closeSelect</Name>
				<Source><![CDATA[
    public void closeSelect(str _selectString)
    {
        if(okButtonClicked)
        {
            super(_selectString);
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>closeSelectRecord</Name>
				<Source><![CDATA[
    public void closeSelectRecord(Common _selectedRecord)
    {
        if (okButtonClicked)
        {
            if (element.args().caller().name() == formStr(SysTableBrowser))
            {
                element.closeSelect(int642str(_selectedRecord.RecId));
            }
            else
            {
                super(_selectedRecord);
            }
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    public void init()
    {
        formClass = new TFMResourceLookupFormClass();
        okButtonClicked = false;
        super();

        formClass.setupTempTable(element.ResourcesTmp);
    }

]]></Source>
