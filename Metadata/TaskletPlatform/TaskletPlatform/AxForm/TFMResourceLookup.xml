				<Type>CommandButton</Type>
				<Methods>
					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        void clicked()
        {
            okButtonClicked = true;

            if (element.selectTarget() is FormStringControl)
            {
                element.closeSelect(ResourcesTmp.Description);
            }
            else if (element.selectTarget() is FormInt64Control)
            {
                element.closeSelect(ResourcesTmp.Description);
            }
            else
            {
                element.closeSelectRecord(ResourcesTmp);
            }

            super();
        }

]]></Source>
