public class TFMNewPageWizard extends FormRun
{
    TFMPageWizard sysWizard;


}
]]></Source>
			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    void init()
    {
        super();

        if (element.args().caller())
			sysWizard = element.args().caller();
        OrderListLinesHtml.parmHtml('<table><tr><h1>Order List And Lines</h1></tr><tr><h3>Choose this option, if you want to register data in a Order List and order lines structure</h3><br><h2>Examples of such pages include:</h2><h3>Pick<br>Receive<br>Count</h3></tr></table>');
        LookupHtml.parmHtml('<table><tr><h1>Lookup</h1></tr><tr><h3>Choose this option, if you want to display and/or register data in a single level</h3><br><h2>Examples of such pages include:</h2><h3>Location Content<br>Locate Item<br>Quarantine Orders<br>Profit/Loss Journals</h3></tr></table>');
        UIRHtml.parmHtml('<table><tr><h1>Unplanned Item Registration</h1></tr><tr><h3>Choose this option, if you want to register data directly from the filter or in a flow.</h3><br><h2>Examples of such pages include:</h2><h3>Register Barcode<br>Unplanned Move</h3></tr></table>');

    }

]]></Source>
			</Method>
			<Method>
				<Name>run</Name>
				<Source><![CDATA[
    void run()
    {
        super();

        sysWizard.nextEnabled(false);
    }

]]></Source>
