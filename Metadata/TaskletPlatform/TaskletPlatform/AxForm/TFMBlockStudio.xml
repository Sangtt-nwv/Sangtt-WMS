			<Method>
				<Name>setContextGroup</Name>
				<Source><![CDATA[
    public void setContextGroup(FormGroupControl _fgc)
    {
        
        StepsControl.setContextGroup(_fgc);
        interactClass = StepsControl.interactionClass();

        interactClass.SetCustomBlock(TFMCustomBlocks);
    }

]]></Source>
			</Method>
			<Method>
				<Name>updateBlockInfo</Name>
				<Source><![CDATA[
    /// <summary>
    ///
    /// </summary>
    protected void updateBlockInfo()
    {
        TFMPage_Icon.text(TFMCustomBlocks.icon);
        TFMGraphicsHelper::setImageHtmlWithWidth(TFMCustomBlocks.icon, HtmlViewerIcon, 60);
    }

]]></Source>
			</Method>
