						<Source><![CDATA[
        /// <summary>
        ///
        /// </summary>
        /// <returns></returns>
        public boolean modified()
        {
            boolean ret;
    
            ret = super();
            
            ttsbegin;
            TFMCustomBlocks.icon = this.text();
            TFMCustomBlocks.write();
            ttscommit;
            
            return ret;
        }

