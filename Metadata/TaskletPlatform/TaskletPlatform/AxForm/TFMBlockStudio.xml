					<Method>
						<Name>active</Name>
						<Source><![CDATA[
        /// <summary>
        ///
        /// </summary>
        /// <returns></returns>
        public int active()
        {
            int ret;
    
            ret = super();

            if (!interactClass)
            {
                interactClass = StepsControl.interactionClass();
            }
            interactClass.SetCustomBlock(TFMCustomBlocks);
            element.updateBlockInfo();
            return ret;
        }

]]></Source>
