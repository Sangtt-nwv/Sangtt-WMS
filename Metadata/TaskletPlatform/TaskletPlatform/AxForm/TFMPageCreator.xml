			<Method>
				<Name>updatePageClass</Name>
				<Source><![CDATA[
    public void updatePageClass()
    {
        
        pageClass = TFMPage::getPageClass(TFMDeltaPages.type,TFMDeltaPages.Name);
        if (!pageClass || !pageClass.getConfiguration())
        {
            return;
        }
        pageClass.parmIcon(TFMDeltaPages.Icon);
        pageClass.parmTitle(TFMDeltaPages.Title);
        pageClass.parmFilter(TFMDeltaPages.FilterName);
        Actions.visible(true);
        Offline.visible(pageClass.getConfiguration().hasOfflineOptions());
        
        XmlViewer.parmHtml(TFMFormXMLFormatter::htmlColorXML(pageClass.getXML(TFMPagesProvider::getAllPages()).xml()));
        XmlViewer.visible(true);
    }

]]></Source>
