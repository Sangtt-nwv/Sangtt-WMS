	<SourceCode>
		<Methods xmlns="">
			<Method>
				<Name>classDeclaration</Name>
				<Source><![CDATA[
[Form]
public class TFMConditionEditor extends FormRun
{
    
    TFMConditionEditorFormClass     formClass;
}
]]></Source>
			</Method>
			<Method>
				<Name>run</Name>
				<Source><![CDATA[
    public void run()
    {
        Object fr;
        super();
        formClass = TFMConditionEditorFormClass::Construct(element, DeleteConditionButton);
        element.getPartControlByName('ContextPart').SystemExpand(true);
        fr = element.getPartControlByName('ContextPart').getPartFormRun();
        element.setContextGroup(fr.getGroup());
        
    }

]]></Source>
			</Method>
			<Method>
				<Name>setContextGroup</Name>
				<Source><![CDATA[
    public void setContextGroup(FormGroupControl _fgc)
    {
        ConditionFlow.setContextGroup(_fgc);
        formClass.setContextGroup(_fgc);
    }

]]></Source>
