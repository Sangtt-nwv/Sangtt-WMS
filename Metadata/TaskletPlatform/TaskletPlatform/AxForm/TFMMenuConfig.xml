			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    public void init(){
         #SysSystemDefinedButtons

        super();

        saveButton= this.control(this.controlId(#SystemDefinedSaveButton)) as FormCommandButtonControl;
        saveButton.Caption('');
        saveButton.enabled(true);
    }

]]></Source>
			</Method>
			<Method>
				<Name>run</Name>
				<Source><![CDATA[
   /// <summary>
    ///
    /// </summary>
    public void run()
    {

        URLUtility urlUtil = new URLUtility();
        TFMPage     page;

        if (element.args().caller() && element.args().caller().name() == formStr(TFMPageOverview))
        {
            page = element.args().caller().getCurrentPage();
            pageId = page.parmId();
        }
        else
        {
            pageId = urlUtil.getQueryParamValue('PageId');
        }

        super();
        element.dataHelper().Saving += eventhandler(element.onSave);
        
        
        configurator = TFMMenuConfigurator::Construct(Categories, MenuMakerCtrl);
        configurator.setDS(UserGroupInfo_ds);
        configurator.setSelectedGroup(pageId);
        //Info (strFmt('%1 %2', classId2Name(arr.value(1)) , classId2Name(arr.value(2))));
    }

]]></Source>
			</Method>
			<Method>
				<Name>onSave</Name>
				<Source><![CDATA[
    public void onSave(FormRunServiceArgs _cancellableArgs)
    {
        configurator.requestSaveMenuSetup();
    }

]]></Source>
