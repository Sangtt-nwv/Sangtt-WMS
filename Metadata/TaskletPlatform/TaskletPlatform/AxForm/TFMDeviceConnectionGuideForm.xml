					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        /// <summary>
        ///
        /// </summary>
        public void clicked()
        {
            super();
            str clientId = formClass.CreateNewClientID();
            if(clientId)
            {
                ttsbegin;
                TFMParameters parms = TFMParameters::find(true);
                parms.reread();
                parms.SysAADClientId = clientid;

                parms.write();
                ttscommit;
                TFMParametersDS.reread();
                TFMParametersDS_ds.refresh();
                TFMParametersDS_ds.research();
                TFMParametersDS.update();

            }
        }

]]></Source>
