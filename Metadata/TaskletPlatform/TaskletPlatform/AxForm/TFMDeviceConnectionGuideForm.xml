        /// <summary>
        ///
        /// </summary>
        public void pageActivated()
        {
            TFMParameters parms = TFMParameters::find();
            str confluencePageId = '233177317';
            
            super();

            if(!parms.SysAADClientId)
            {
                FormStaticTextControl_clientID_Setup_error.visible(true);
                FormStaticTextControl_clientID_Setup_success.visible(false);
                FormStaticTextControl_header_connectdevice.text("@TFM:TheClientIDhasnotbeensetupPlease");
            }
            else{
                FormStaticTextControl_clientID_Setup_error.visible(false);
                FormStaticTextControl_clientID_Setup_success.visible(true);
                FormStaticTextControl_header_connectdevice.text(orgClientIDHeaderText);
            }

            formClass.setConfluencePageContentOnHtmlViewer(htmlViewerControl_endpoint_description, confluencePageId);
            formClass.updateBarcode(htmlViewerControl_userName, htmlViewerControl_endpoint, FormStaticTextControl_json, FormStringControl_userLoginName.text(), FormStringControl_displayName.text(), FormStringControl_tenantId.text());
        }

]]></Source>
