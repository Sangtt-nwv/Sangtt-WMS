				<Name>init</Name>
				<Source><![CDATA[
    /// <summary>
    ///
    /// </summary>
    public void init()
    {
        UserInfo userInfo;
        TFMParameters parms;
        super();

        if (element.args().caller())
        {
            sysWizard = element.args().caller();
        }
        
        parms = TFMParameters::find(false);
        TFMParameters_SysAADClientId.text(parms.SysAADClientId);
        FormStringControl_tenantId.text(parms.EndpointTenantId);
        FormStringControl_displayName.text(parms.EndpointDisplayName ? parms.EndpointDisplayName : curExt());

        userInfo = xUserInfo::find(false, curUserId());
        FormStringControl_userLoginName.text(userInfo.networkAlias);

        orgClientIDHeaderText = FormStaticTextControl_header_connectdevice.text();
    }

]]></Source>
			</Method>
			<Method>
				<Name>run</Name>
				<Source><![CDATA[
    void run()
    {
        formClass = new TFMDeviceConnectionGuideFormClass(EnvironmentFactory::GetApplicationEnvironment().Infrastructure.HostUrl);

        TFMParameters parms;
        super();
        parms = TFMParameters::find(false);
        if(parms.SysAADClientId)
        {
            sysWizard.nextEnabled(true);
            while(sysWizard.nextEnabled())
            {
                sysWizard.next();
            }
            sysWizard.back(); // go one back after the last one.
            sysWizard.backEnabled(true);
        }
        else
        {
            element.activateInitialPage();
            sysWizard.nextEnabled(true);
        }
    }

]]></Source>
