		<DataControls xmlns="">
			<Control>
				<Name>OK</Name>
				<Type>CommandButton</Type>
				<Methods>
					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        void clicked()
        {
            okButtonClicked = true;

            if (element.selectTarget() is FormStringControl)
            {
                element.closeSelect(PagesTmp.PageId);
            }
            else if (element.selectTarget() is FormInt64Control)
            {
                element.closeSelect(PagesTmp.Icon);
            }
            else
            {
                element.closeSelectRecord(PagesTmp);
            }

            super();
        }

]]></Source>
