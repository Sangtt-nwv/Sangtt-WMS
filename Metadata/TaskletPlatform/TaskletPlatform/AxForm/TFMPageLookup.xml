			<Method>
				<Name>closeSelect</Name>
				<Source><![CDATA[
    public void closeSelect(str _selectString)
    {
        if(okButtonClicked)
        {
            super(_selectString);
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>closeSelectRecord</Name>
				<Source><![CDATA[
    public void closeSelectRecord(Common _selectedRecord)
    {
        if (okButtonClicked)
        {
            if (element.args().caller().name() == formStr(SysTableBrowser))
            {
                element.closeSelect(int642str(_selectedRecord.RecId));
            }
            else
            {
                super(_selectedRecord);
            }
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    public void init()
    {
        TFMPagesTmpLookup	localTmp;
        MapEnumerator pages = TFMPagesProvider::getAllPages().getPages().getEnumerator();
        TFMPage page;
        
		okButtonClicked = false;
        super();
        localTmp.setTmp();

        while (pages.moveNext())
        {
            page = pages.currentValue();
            localTmp.PageId = page.parmId();
            localTmp.Icon = page.parmIcon();
            localTmp.Title = page.parmTitle();
            localTmp.PageType = page.parmType();
            localTmp.insert();
        }
        PagesTmp.setTmpData(localTmp);

        lookupContent = new TFMPageLookupContent(contentControl, PagesTmp, true);
    }

]]></Source>
			</Method>
