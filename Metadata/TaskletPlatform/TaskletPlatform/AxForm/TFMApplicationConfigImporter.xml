			<Method>
				<Name>updateMenuItemsPages</Name>
				<Source><![CDATA[
    public void updateMenuItemsPages()
    {
        int i;
        FormTreeControl formControl = this.FormTreeControlMenuItems;
        formControl.deleteAll();

        TFMPages pages = TFMPagesProvider::getAllPages();
        MapEnumerator pagesEnum = pages.getPages().getEnumerator();
        while(pagesEnum.moveNext())
        {
            FormTreeItem itemControl = new FormTreeItem(pagesEnum.currentKey());
            itemControl.data(pagesEnum.currentKey());
            itemControl.stateBold(true);
            formControl.addItem(0, formControl.getVisibleCount(), itemControl);
        }
        SysFormTreeControl::expandTree(this.FormTreeControlMenuItems, this.FormTreeControlMenuItems.getRoot());
    }

]]></Source>
			</Method>
			<Method>
				<Name>updateNewMenuItemsPages</Name>
				<Source><![CDATA[
    public void updateNewMenuItemsPages()
    {
        //int i;
        //FormTreeControl formControl = this.FormTreeControlNewMenuItems;
        if(!fileXmlDoc)
        {
            return;
        }

        // import the selected pages
        // set up configuration changes
        container newPagesAndChangedParameters = TFMApplicationImporter::getChangesFromApplicationConfigurationFile(fileXmlDoc);
        container menuItemsChanges;
        container peek;
        int i;
        str lastUsedPageName;
        TreeItemIdx parent;
        FormTreeControl formControl = this.FormTreeControlNewMenuItems;
        formControl.deleteAll();

        menuItemsChanges = conPeek(newPagesAndChangedParameters, 3);
    
        for (i = 1 ; i <= conLen(menuItemsChanges) ; i++)
        {
            peek = conPeek(menuItemsChanges, i);
            str pageName = conPeek(peek, 1);
    
            if(lastUsedPageName != pageName)
            {
                lastUsedPageName = pageName;
                FormTreeItem itemControl = new FormTreeItem(pageName);
                itemControl.stateBold(true);
                itemControl.data(peek);
                parent = formControl.addItem(0, formControl.getVisibleCount(), itemControl);
            }
    
            str id = conPeek(peek, 3);
            str actionType = conPeek(peek, 2);
            str info = actionType +' - ' + id;
            SysFormTreeControl::addTreeItem(this.FormTreeControlNewMenuItems, info, parent, peek);    
        }
        SysFormTreeControl::expandTree(this.FormTreeControlNewMenuItems, this.FormTreeControlNewMenuItems.getRoot());
    }

]]></Source>
