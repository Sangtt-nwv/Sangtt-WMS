			<Method>
				<Name>updateImportPagesTabPage</Name>
				<Source><![CDATA[
    public void updateImportPagesTabPage()
    {
        if(fileXmlDoc)
        {
            container newPagesAndChangedParameters = TFMApplicationImporter::getChangesFromApplicationConfigurationFile(fileXmlDoc);
            container pages;
            container peek;
            int i;
            FormTreeControl formControl = this.FormTreeControlPages;
            formControl.deleteAll();

            pages = conPeek(newPagesAndChangedParameters, 1);
            for (i = 1 ; i <= conLen(pages) ; i++)
            {
                peek = conPeek(pages, i);

                str name = conPeek(peek, 1);
                FormTreeItem itemControl = new FormTreeItem(name);
                itemControl.data(peek);
                itemControl.stateBold(true);
                formControl.addItem(0, formControl.getVisibleCount(), itemControl);
            }

            SysFormTreeControl::expandTree(this.FormTreeControlPages, this.FormTreeControlPages.getRoot());
        }
    }

]]></Source>
