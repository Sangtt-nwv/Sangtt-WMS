				<Name>selectedTreeControlItems</Name>
				<Source><![CDATA[
    /// <summary>
    /// Returns all the selected items but only leafs (no parents)
    /// </summary>
    /// <param name = "_formControl"></param>
    /// <returns></returns>
    public Set selectedTreeControlItems(FormTreeControl _formControl)
    {
        Set             selectedItems = new Set(Types::Container);
        Container       itemContainer;

        int itemIndex = _formControl.getFirstVisible();

        while(_formControl.getItem(itemIndex))
        {
            FormTreeItem item = _formControl.getItem(itemIndex);
            if(item.stateChecked() == FormTreeCheckedState::Checked)
            {
                if(item.children() < 1 )
                {
                    container d = item.data();
                    selectedItems.add(d);
                }
            }
            itemIndex = _formControl.getNextVisible(itemIndex);
        }
        return selectedItems;
    }

]]></Source>
			</Method>
			<Method>
				<Name>changeStateOnAll</Name>
				<Source><![CDATA[
    public void changeStateOnAll(FormTreeControl _formControl, FormTreeCheckedState _stateToSet)
    {
        int itemIndex = _formControl.getFirstVisible();
        FormTreeItem item;

        while(_formControl.getItem(itemIndex))
        {
            item = _formControl.getItem(itemIndex);
            item.stateChecked(_stateToSet);
            _formControl.setItem(item);
            itemIndex = _formControl.getNextVisible(itemIndex);
        }
    }

]]></Source>
