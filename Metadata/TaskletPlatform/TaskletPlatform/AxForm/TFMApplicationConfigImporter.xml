			<Method>
				<Name>updateConfigurationTabPage</Name>
				<Source><![CDATA[
    public void updateConfigurationTabPage()
    {
        if(!fileXmlDoc)
        {
            return;
        }

        // import the selected pages
        // set up configuration changes
        container newPagesAndChangedParameters = TFMApplicationImporter::getChangesFromApplicationConfigurationFile(fileXmlDoc);
        container changedParameters;
        container peek;
        int i;
        str lastUsedPageName;
        TreeItemIdx parent;
        FormTreeControl formControl = this.FormTreeControlConfigurationChanges;
        formControl.deleteAll();

        changedParameters = conPeek(newPagesAndChangedParameters, 2);
    
        for (i = 1 ; i <= conLen(changedParameters) ; i++)
        {
            peek = conPeek(changedParameters, i);
            str pageName = conPeek(peek, 1);
    
            if(lastUsedPageName != pageName)
            {
                lastUsedPageName = pageName;
                FormTreeItem itemControl = new FormTreeItem(pageName);
                itemControl.stateBold(true);
                itemControl.data(peek);
                parent = formControl.addItem(0, formControl.getVisibleCount(), itemControl);
            }
    
            str metName = conPeek(peek, 4);
            str valueToApply = conPeek(peek, 5);
            str orgValue = conPeek(peek, 6);
            str infoValue = TFMFormLookupHelper::removeParmFromName(metName) + ':: ' + "@TFM:Currentvalue" + '\'' + valueToApply + '\' >> ' + "@TFM:Valueinfile" + '\'' + orgValue + '\'';

            infoValue = strReplace(infoValue, 'General_', '');

            SysFormTreeControl::addTreeItem(this.FormTreeControlConfigurationChanges, infoValue, parent, peek);
                
        }
        SysFormTreeControl::expandTree(this.FormTreeControlConfigurationChanges, this.FormTreeControlConfigurationChanges.getRoot());
    }

]]></Source>
