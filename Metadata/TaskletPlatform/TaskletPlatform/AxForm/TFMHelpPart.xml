    public void run()
    {
        str callerName= element.args().callerName();
        TFMFormHelp	helpEnum = TFMHelper::EnumSymbol2Value(enumNum(TFMFormHelp),callerName);
        str html = new SysDictEnum(enumNum(TFMFormHelp)).value2Label(helpEnum);
        //str	html = strFmt('%1',helpEnum);
		super();
        
        HtmlViewer.parmHtml(html + strFmt("@TFM:AdditionalHelp",callerName));
    }

]]></Source>
