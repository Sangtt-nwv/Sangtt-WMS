    ///
    /// </summary>
    public void run()
    {
        super();
        TFMVersion::Construct().populateGroupWithExtensions(AddOnsGroup);

        TFMDocumentParametersEdit edt = new TFMDocumentParametersEdit(ContentFromTree);
        edt.showDocumentParametersTiles(DocParmTiles);
    }

]]></Source>
