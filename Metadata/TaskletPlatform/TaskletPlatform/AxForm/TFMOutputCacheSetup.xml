						<Name>clicked</Name>
						<Source><![CDATA[
        public void clicked()
        {
            SysDictClass			dc = new SysDictClass(TFMOutputCacheSetup.ClassOverrideID);
            TableId					tableId;
            TFMTableNameAttribute	tableNameAttr;
            TFMXMLTable				theCache;
			super();

            tableNameAttr = dc.getAttribute(classStr(TFMTableNameAttribute));
            tableId = tableName2Id(tableNameAttr.parmTableName());

            select count(RecId) from theCache where theCache.reffieldName like TFMOutputCacheSetup.OrderType && theCache.RefTableId == tableId;

            info (strFmt("@SYS113135",theCache.RecId));

            delete_from theCache where theCache.reffieldName like TFMOutputCacheSetup.OrderType && theCache.RefTableId == tableId;
		}

]]></Source>
