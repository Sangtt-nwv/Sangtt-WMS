			<Method>
				<Name>setPositionToListId</Name>
				<Source><![CDATA[
    public void setPositionToListId(str _listId)
    {
        TFMListProviderDataSource_ds.findValue(fieldName2Id(tableNum(TFMLists), 'ListId'), _listId);
        if(TFMListProviderDataSource.ListId != _listId)
        {
            TFMListProviderDataSource_ds.setPosition(0);
        }
    }

]]></Source>
