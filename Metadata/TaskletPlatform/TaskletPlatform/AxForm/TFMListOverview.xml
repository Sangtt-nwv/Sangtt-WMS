			<Method>
				<Name>updateDataSource</Name>
				<Source><![CDATA[
    public void updateDataSource()
    {
        MapEnumerator	pageMap;
        TFMPages		pages;
        TFMPage			page;
        TFMListId		listId;

        list2Pages = new Map(Types::String, Types::String);

        pageMap = TFMPagesProvider::getAllPages().getPages().getEnumerator();
        while (pageMap.moveNext())
        {
            page = pageMap.currentValue();
            listId = page.getListId();
            if (listId)
            {
                list2Pages.insert(listId,(list2Pages.exists(listId) ? list2Pages.lookup(listId) + ',' : '') + page.parmId());
            }
        }
        qbrPageId = TFMPageDatasources_DS.queryBuildDataSource().addRange(fieldNum(TFMPageDatasources,Pageid));
    }

]]></Source>
			</Method>
			<Method>
				<Name>run</Name>
				<Source><![CDATA[
    /// <summary>
    ///
    /// </summary>
    public void run()
    {
        URLUtility urlUtil = new URLUtility();

        TFMListId listName = urlUtil.getQueryParamValue('ListId');
        element.updateDataSource();
        element.populateListDatasource();
        super();

        TFMListProviderDataSource_DS.queryBuildDataSource().addRange(fieldNum(TFMLists,ListId)).value(listName ? listName : '*');
        TFMListProviderDataSource_DS.executeQuery();
    }

]]></Source>
