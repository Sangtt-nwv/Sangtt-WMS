					<Method>
						<Name>executeQuery</Name>
						<Source><![CDATA[
        public void executeQuery()
        {
            TFMPageID pageId;
            TFMPage page;
            TFMListID listId = TFMListProviderDataSource.ListId;
            

            // if there is a pageId on the calling record then find its listId
            if (!listId && element.args() && element.args())
            {              
                Common callerRecord = element.args().record();
                if(callerRecord && callerRecord.RecId)
                {
                    pageId = callerRecord.getFieldValue('PageID');
                    if(pageId)
                    {
                        page = TFMPagesProvider::getAllPages().getPage(pageId);
                        if(page)
                        {
                            listId = page.getListId();
                        }
                    }
                }
            }
            super();
            element.setPositionToListId(listId);
        }

]]></Source>
