					<Method>
						<Name>create</Name>
						<Source><![CDATA[
        public void create(boolean _append = false)
        {
            Dialog			dialog;
            DialogField		field;
            DialogField		fieldCopyFrom;
            
            ;
            dialog = new Dialog("@TFM:NewList");
            
            field = dialog.addField(ExtendedTypestr(Name),"@TFM:Nameofnewlist");
            field.mandatory_RU(true);

            fieldCopyFrom = dialog.addField(ExtendedTypestr(TFMListId),"@TFM:Listtocopyfrom");

            dialog.run();
            if (dialog.closedOk())
            {
                if(TFMListsProvider::getAllLists().getList(field.value()))
                {
                    str strMessage = "@TFM:Thelistalreadyexists";
                    str strTitle = "@TFM:Listexists";
                    Box::warning(strMessage, strTitle);
                    return;
                }

                TFMListNewVersion::makeNewList(field.value(), fieldCopyFrom.value());
                
                element.populateListDatasource();
                TFMListProviderDataSource_ds.executeQuery();

                //select the newList
                if(field.value())
                {
                    element.setPositionToListId(field.value());
                }
            }
        }

]]></Source>
