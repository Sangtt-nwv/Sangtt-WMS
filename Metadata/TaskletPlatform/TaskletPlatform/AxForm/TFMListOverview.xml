						<Name>active</Name>
						<Source><![CDATA[
        /// <summary>
        ///
        /// </summary>
        /// <returns></returns>
        public int active()
        {
            int ret;
            TFMListsVersion listVersion;
    
            ret = super();

            listVersion = TFMListsVersion::Find(TFMListProviderDataSource.ListId);
            boolean listVersionActive = !listVersion || (listVersion && listVersion.Locked);
            TFMListEdit.text(listVersionActive ? "@SYS5252" : "@SYS313067");
            LockVersion.enabled(listVersion && !listVersion.Locked);
            TFMListNewVersion.enabled(listVersionActive);

            qbrPageId.value(list2Pages.exists(TFMListProviderDataSource.ListId) ? list2Pages.lookup(TFMListProviderDataSource.ListId) : 'nonExistingPage');
            TFMPageDatasources_ds.executeQuery();
            element.updateVisual();

            this.allowDelete(listVersion.Version > 0);
   
            return ret;
        }

]]></Source>
