			<Method>
				<Name>updateVisualAsync</Name>
				<Source><![CDATA[
    public void updateVisualAsync(AsyncTaskResult _result)
    {
        if (TFMListProviderDataSource)
        {
            TFMListVisualization::DrawList(PreviewWindow,TFMListProviderDataSource.ListId,TFMListsVersion::newestVersion(TFMListProviderDataSource.ListId, false),DrawCells.value(),DrawDevice.value(),UseDataset.value() ? TFMPageDatasources : null);
        }
        else
        {
            PreviewWindow.parmHtml('');
        }
    }

]]></Source>
