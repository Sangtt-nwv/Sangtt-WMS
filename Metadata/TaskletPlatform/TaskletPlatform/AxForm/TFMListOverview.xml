				<Source><![CDATA[
    public void updateVisual()
    {
        PreviewWindow.parmHtml('<table><tr><td><img src="'
            + TFMDocGetMedia::getURLFromIconName(resourceStr(TFMLoading))
            + '"></td></tr><tr><td style="text-align: center; vertical-align: middle;"><h2>'+"@SYS4128"+'</h2></td></tr></table>' 
            );
        element.setTimeoutEx(formMethodStr(TFMListOverview,updateVisualAsync),conNull(),10);
    }

]]></Source>
