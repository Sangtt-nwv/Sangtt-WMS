					<Method>
						<Name>delete</Name>
						<Source><![CDATA[
        /// <summary>
        ///
        /// </summary>
        public void delete()
        {
            TFMListID listIdToDelete = TFMListProviderDataSource.ListId;
            super();
            ttsbegin;
            TFMLists list = TFMLists::Find(listIdToDelete, true); // OK to use the Find method.
            if(list)
            {
                list.delete();
            }
            ttscommit;
            TFMListsProvider::instance().invalidateProvider();
            element.populateListDatasource();
            TFMListProviderDataSource_ds.executeQuery();

            element.setPositionToListId(listIdToDelete);
        }

]]></Source>
