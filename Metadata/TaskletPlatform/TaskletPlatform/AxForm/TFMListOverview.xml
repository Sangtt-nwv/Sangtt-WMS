			<Method>
				<Name>populateListDatasource</Name>
				<Source><![CDATA[
    public void populateListDatasource()
    {
        TFMListProviderDataSource.setTmp();
        delete_from TFMListProviderDataSource;

        TFMListsCollection lists = TFMListsProvider::getAllLists();
        Map listMap = lists.listMap();
        MapEnumerator listMapEnumerator = listMap.getEnumerator();

        while(listMapEnumerator.moveNext())
        {
            TFMList list = listMapEnumerator.currentValue();
            TFMListProviderDataSource.clear();
            if(list.parmListName())
            {
                TFMListProviderDataSource.ListId = list.parmListName();
                TFMListProviderDataSource.Description = list.parmListName();
                TFMListProviderDataSource.insert();
            }
        }
        TFMListProviderDataSource.clear();
    }

]]></Source>
