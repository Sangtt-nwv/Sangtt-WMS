				<Source><![CDATA[
[Form]
public class TFMDrawFlow extends FormRun
{
    TFMProcess process;

}
]]></Source>
			</Method>
			<Method>
				<Name>run</Name>
				<Source><![CDATA[
    public void run()
    {
        TFMProcessVersion versionTbl;
        Common record = element.args().record();

        if (record.TableId != tableNum(TFMProcessVersion))
        {
            
            throw error (strFmt("@SYS134996",tableStr(TFMProcessVersion)));
            
        }
        else
        {
            versionTbl = element.args().record();
            process = TFMProcessProvider::GetAllProcessesImpl().getProcess(versionTbl.ProcessID, versionTbl.Version);
            
        }
        
        super();
        TFMDrawFlowControlInteractionSteps interactionClass = StepsControl.interactionClass();
        interactionClass.setProcess(process);
        if (process && process.parmLocked())
        {
            TFMProcessEditHeaders.caption("@TFM:ViewHeaders");
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>setContextGroup</Name>
				<Source><![CDATA[
    public void setContextGroup(FormGroupControl _fgc)
    {
        StepsControl.setContextGroup(_fgc);
    }

]]></Source>
			</Method>
			<Method>
				<Name>getProcess</Name>
				<Source><![CDATA[
    public TFMProcess getProcess()
    {
        return process;
    }

]]></Source>
			</Method>
