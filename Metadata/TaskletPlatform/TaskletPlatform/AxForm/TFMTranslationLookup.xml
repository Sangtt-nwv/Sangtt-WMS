			<Method>
				<Name>openTFMTranslations</Name>
				<Source><![CDATA[
    public void openTFMTranslations(Common _selectedRecord, FormStringControl _labelCtrl = element.args().callerFormControl())
    {
        FormRun formRun;
        Args    args;
        args = new args(formStr(TFMTranslations));
        formRun = new FormRun(args);
        args.caller(element.caller_RU());
        if(_selectedRecord && _selectedRecord.RecId)
        {
            args.record(_selectedRecord);
        } else
        {
            args.callerFormControl(_labelCtrl);
            args.parmEnum(2);
        }

        formRun.init();
        formRun.run();
        formRun.reload();
        formRun.wait();
    }

]]></Source>
