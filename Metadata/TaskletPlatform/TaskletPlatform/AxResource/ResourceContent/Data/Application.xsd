<?xml version="1.0" encoding="utf-8"?>
<xs:schema id="Application"
	targetNamespace="http://schemas.taskletfactory.com/TFM/Application"
    elementFormDefault="qualified"
    xmlns="http://schemas.taskletfactory.com/TFM/Application"
    xmlns:mstns="http://schemas.taskletfactory.com/TFM/Application"
    xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="application" type="ApplicationConfigurationType" />

  <xs:complexType name="ApplicationConfigurationType">
    <xs:sequence minOccurs="1" maxOccurs="1">
      <xs:element name="printer" minOccurs="0" maxOccurs="1" type="PrintEngineConfigurationType" />
      <xs:element name="resources" minOccurs="0" maxOccurs="1" type="ResourcesConfigurationType" />
      <xs:element name="services" minOccurs="0" maxOccurs="1" type="ServicesConfigurationType" />
      <xs:element name="pages" minOccurs="1" maxOccurs="1" type="PagesConfigurationType" />
    </xs:sequence>
    <xs:attribute name="runMode" type="RunModeConfigurationType" use="optional" default="Normal"/>
  </xs:complexType>

  <xs:simpleType name="RunModeConfigurationType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Normal" />
      <xs:enumeration value="StabilityTest" />
    </xs:restriction>
  </xs:simpleType>

  <!-- PrintEngine Configuration-->
  <xs:complexType name="PrintEngineConfigurationType">
    <xs:attribute name="printEncoding" use="optional" type="xs:string" default="UTF8" >
      <xs:annotation>
        <xs:documentation>The encoding that will be used when sending the information to the printer. Defaults to UTF8.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- SHARED RESOURCES -->
  <xs:complexType name="ListType" >
    <xs:all>
      <xs:element name="listConfiguration" type="ListConfiguration" minOccurs="0" maxOccurs="1" />
      <xs:element name="open" minOccurs="0" maxOccurs="1" type="BaseContextMenuConfiguration">
        <xs:annotation>
          <xs:documentation>
            Menu item for open in the menu. This will only be visible if enabled (default) and the input selector is set to double tap.

            Default for the title is @{ListOpenMenuItem}
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="refresh" minOccurs="0" maxOccurs="1" type="BaseContextMenuConfiguration">
        <xs:annotation>
          <xs:documentation>
            Menu item for refresh in the menu.

            Default for the title is @{ListUpdateMenuItem}
          </xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:all>
    <xs:attribute name="listId" use="optional" type="xs:string" />
  </xs:complexType>

  <xs:complexType name="ListsConfigurationType">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:element name="listConfiguration" type="ListConfiguration" />
    </xs:sequence>
    <xs:attribute name="useSingleSelectionDefault" type="xs:boolean" use="optional" default="false">
      <xs:annotation>
        <xs:documentation>This is the default value for the useSingleSelection found on the list configuration.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="ListConfiguration">
    <xs:all>
      <xs:element name="displayStatusConfiguration" minOccurs="0" maxOccurs="1">
        <xs:complexType>
          <xs:all>
            <xs:element name="values" minOccurs="0" maxOccurs="1">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="value" minOccurs="0" maxOccurs="unbounded">
                    <xs:complexType>
                      <xs:attribute name="dataMemberValue" type="DataMemberValue" use="required" />
                      <xs:attribute name="color" use="required" type="xs:string">
                        <xs:annotation>
                          <xs:documentation>
                          Format of color must be hex code. E.g. #040404.
                          </xs:documentation>
                        </xs:annotation>
                      </xs:attribute>
                    </xs:complexType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
          </xs:all>
          <xs:attribute name="dataMember" type="xs:string" use="required">
            <xs:annotation>
              <xs:documentation>
              The dataMember to look for in the object used with the displayStatusConfiguration. E.g. if the dataMember is set to 'LineStatus' on the list of orders then value of the LineStatus property on the order will be extracted.
              </xs:documentation>
            </xs:annotation>
          </xs:attribute>
          <xs:attribute name="placement" type="StatusBarPlacement" use="optional" default="right">
            <xs:annotation>
              <xs:documentation>
              Determines the position of the status bar on the list items, can be either 'left' or 'right'.
              </xs:documentation>
            </xs:annotation>
          </xs:attribute>
        </xs:complexType>
      </xs:element>
      <xs:element ref="listComposition" minOccurs="1" maxOccurs="1"/>
    </xs:all>
    <xs:attribute name="displayStatus" type="xs:boolean" use="optional">
      <xs:annotation>
        <xs:documentation>
          This enables the order line to display registration progress.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="id" type="xs:string" use="optional">
      <!--<xs:key name="uniqueAuthorID">
        <xs:selector xpath="author"/>
        <xs:field xpath="@aid"/>
      </xs:key>-->
    </xs:attribute>
    <xs:attribute name="useSingleSelection" type="xs:boolean" use="optional" default="false">
      <xs:annotation>
        <xs:documentation>If true then the list will perform a select action the first time an item is touched. If false (default) then it will set the focus the first time and perfor a select action the second time. In particular this is helpful for Resisitive screens</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:element name="listComposition" abstract="true"/>
  <xs:element name="rows" substitutionGroup="listComposition">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="row" minOccurs="1" maxOccurs="unbounded">
          <xs:complexType>
            <xs:all>
              <xs:element name="columns" minOccurs="1" maxOccurs="1" type="ColumnsElementType"/>
            </xs:all>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="columns" type="ColumnsElementType" substitutionGroup="listComposition"/>

  <xs:complexType name="ColumnsElementType">
    <xs:sequence>
      <xs:element name="column" minOccurs="1" maxOccurs="unbounded" >
        <xs:complexType>
          <xs:all>
            <xs:element name="elements" minOccurs="1" maxOccurs="1">
              <xs:complexType>
                <xs:sequence>
                  <xs:choice minOccurs="0" maxOccurs="unbounded">
                    <xs:element name="textElement" type="TextElementType" />
                    <xs:element name="imageElement" type="ImageElementType" />
                  </xs:choice>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
          </xs:all>
          <xs:attribute name="width" type="xs:string" use="optional" />
          <xs:attribute name="xAlign" type="XAlignType" use="optional" />
          <xs:attribute name="yAlign" type="YAlignType" use="optional" />
          <xs:attribute name="backgroundColor" type="xs:string" use="optional" />
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:simpleType name="StatusBarPlacement">
    <xs:restriction base="xs:string">
      <xs:enumeration value="left" />
      <xs:enumeration value="right" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="XAlignType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="left" />
      <xs:enumeration value="center" />
      <xs:enumeration value="right" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="YAlignType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="top" />
      <xs:enumeration value="center" />
      <xs:enumeration value="bottom" />
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="TextElementType">
    <xs:all>
      <xs:element name="values" minOccurs="0" maxOccurs="1">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="value" minOccurs="0" maxOccurs="unbounded">
              <xs:complexType>
                <xs:attributeGroup ref="TextElementCommonAttributesType" />
                <xs:attribute name="if" type="IfValueAttributeType" use="required" />
                <xs:attribute name="dataMemberValue" type="DataMemberValue" use="required" />
                <xs:attribute name="fontId" type="xs:string" use="optional" >
                  <xs:annotation>
                    <xs:documentation>
                      The fontId to use when the value's condition is met. The fontId of the value will take precedence over the fontId defined on the TextElement element.
                    </xs:documentation>
                  </xs:annotation>
                </xs:attribute>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:all>
    <xs:attributeGroup ref="TextElementFullAttributesType" />
  </xs:complexType>

  <xs:attributeGroup name="TextElementCommonAttributesType">
    <xs:attribute name="text" type="xs:string" use="optional" >
      <xs:annotation>
        <xs:documentation>The default text to use for the text element when none of the criteria for conditional values are met.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>

  <xs:attributeGroup name="TextElementFullAttributesType">
    <xs:attributeGroup ref="TextElementCommonAttributesType" />
    <xs:attribute name="dataMember" type="xs:string" use="optional" />
    <xs:attribute name="fontId" type="xs:string" use="required" >
      <xs:annotation>
        <xs:documentation>
          The default text to use when none of the criteria for conditional values are met. The color of the font will be replaced by an alternative color when used in a header e.g. when open registration of an Order Line.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="horizontalAlignment" use="optional" type="XAlignType"/>
    <xs:attribute name="verticalAlignment" use="optional" type="YAlignType"/>
  </xs:attributeGroup>

  <xs:simpleType name="IfValueAttributeType">
    <xs:annotation>
      <xs:documentation>
        Depending on the value of the 'if' attribute the actual value of dataMember property will be compared to the value provided in the dataMemberValue.

        The first value element that evaluates to true will be returned.

        NB. Only numbers can be used in combination with the lessThan and greaterThan in the 'if' attribute.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="equals" >
        <xs:annotation>
          <xs:documentation>
            When set to 'equals' the actual value of the property defined in the dataMember must match the value defined in the dataMemberValue.
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="lessThan" >
        <xs:annotation>
          <xs:documentation>
            When set to 'lessThan' the actual value of the property defined in the dataMember must be less than the value in the dataMemberValue.
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="greaterThan" >
        <xs:annotation>
          <xs:documentation>
            When set to 'greaterThan' the actual value of the property defined in the dataMember must be greater than the value in the dataMemberValue.
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="ImageElementType">
    <xs:all>
      <xs:element name="values" minOccurs="0" maxOccurs="1">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="value" minOccurs="0" maxOccurs="unbounded">
              <xs:complexType>
                <xs:attribute name="imageId" use="required" >
                  <xs:annotation>
                    <xs:documentation>
                      The imageId to use if the evaluation of the dataMember and the dataMemberValue evaluates to true.
                    </xs:documentation>
                  </xs:annotation>
                </xs:attribute>
                <xs:attribute name="dataMemberValue" type="DataMemberValue" use="required" />
                <xs:attribute name="if" use="optional" default="equals" type="IfValueAttributeType" />
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:all>
    <xs:attribute name="height" use="optional" type="xs:decimal" >
      <xs:annotation>
        <xs:documentation>
          The height is a percentage of the screen height.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="width" use="optional" type="xs:decimal" >
      <xs:annotation>
        <xs:documentation>
          The width is a percentage of the screen width.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="dataMember" use="optional" type="xs:string" >
      <xs:annotation>
        <xs:documentation>
          The dataMember to look for in the object used with the ImageElement. E.g. if the dataMember is set to 'Status' on the list of orders then value of the Status property on the order will be extracted.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="sourceId" use="optional" type="xs:string" >
      <xs:annotation>
        <xs:documentation>
          The default image sourceId used when the dataMember and dataMember values does evaluates to true.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="horizontalAlignment" use="optional" type="XAlignType"/>
    <xs:attribute name="verticalAlignment" use="optional" type="YAlignType"/>
  </xs:complexType>

  <xs:complexType name="ResourcesConfigurationType">
    <xs:sequence>
      <xs:element name="fonts" minOccurs="0" maxOccurs="1" type="FontsConfigurationType" />
      <xs:element name="images" minOccurs="0" maxOccurs="1" type="ImagesConfigurationType" />
      <xs:element name="lists" minOccurs="0" maxOccurs="1" type="ListsConfigurationType" />
      <xs:element name="headers" minOccurs="0" maxOccurs="1" type="HeadersConfigurationType" >
        <xs:annotation>
          <xs:documentation>The header configurations are most often a part of the reference data. As a fallback they can be created in this file.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="workflows" minOccurs="0" maxOccurs="1" type="WorkflowsConfigurationType" />
    </xs:sequence>
    <xs:attribute name="theme" use="optional" type="xs:string" default="Tasklet" >
      <xs:annotation>
        <xs:documentation>The Theme used by the app. The images will e.g. be read from /sdcard/mobilewms/resources/images/THEME/... </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="FontsConfigurationType">
    <xs:sequence>
      <xs:element name="font" minOccurs="0" maxOccurs="unbounded" type="FontConfigurationType" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="FontConfigurationType">
    <xs:attribute name="id" use="required" type="xs:string" />
    <xs:attribute name="size" use="optional" type="xs:string" default="medium" />
    <!-- type should be some kind of enum -->
    <xs:attribute name="bold" use="optional" type="xs:boolean" default="false" />
    <xs:attribute name="italic" use="optional" type="xs:boolean" default="false" />
    <xs:attribute name="color" use="optional" type="xs:string" />
  </xs:complexType>

  <xs:complexType name="ImagesConfigurationType">
    <xs:sequence>
      <xs:element name="image" minOccurs="0" maxOccurs="unbounded" type="ImageConfigurationType" />
    </xs:sequence>
    <xs:attribute name="diskCacheDuration" use="optional" type="xs:int" default="15">
      <xs:annotation>
        <xs:documentation>
          Number of days the images should remain in the cache (disk) on the device. The default is set to 15 days.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:simpleType name="ImageDownloadConfigurationType">
    <xs:restriction base="xs:string">
      <!-- Keep the list sorted alphabetically -->
      <xs:enumeration value="downloadOnDemand" >
        <xs:annotation>
          <xs:documentation>
            Images are downloaded from the backend if they are not already in the cache (disk or memory) on the device.
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="preDownload" >
        <xs:annotation>
          <xs:documentation>
            This will pre-download images for the services that uses images. E.g. when updating order lines then images will be fetched when the order lines are fetched from the backed.
            This is primarily used in Offline scenarios.
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="ImageConfigurationType">
    <xs:attribute name="id" use="required" type="xs:string" />
    <xs:attribute name="fileName" use="required" type="xs:string" />
  </xs:complexType>

  <xs:complexType name="HeadersConfigurationType">
    <xs:sequence>
      <xs:element name="headerConfiguration" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:all>
            <xs:element name="lines">
              <xs:complexType>
                <xs:sequence minOccurs="0" maxOccurs="unbounded">
                  <xs:element name="add" type="HeaderLineType"/>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
          </xs:all>
          <xs:attribute name="id" use="required" type="xs:string" >
            <xs:annotation>
              <xs:documentation>The id of header configuration</xs:documentation>
            </xs:annotation>
          </xs:attribute>
          <xs:attribute name="enterKeyBehaviour" use="optional" type="HeaderEnterKeyBehaviourType" default="AcceptOnCompleted">
            <xs:annotation>
              <xs:documentation>Defines which action is performed when the enter key is pressed.</xs:documentation>
            </xs:annotation>
          </xs:attribute>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  
  <xs:complexType name="HeaderLineType">
    <xs:complexContent>
      <xs:extension base="BaseInputLineType">
        <xs:attribute name="acceptBarcode" type="xs:boolean" default="true">
          <xs:annotation>
            <xs:documentation>If true, the field will accept a barcode and the line can receive the barcode.</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="clearOnClear" type="xs:boolean" default="true">
          <xs:annotation>
            <xs:documentation>If true, the field will be cleared when the clear/reset button on the header is tapped.</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="locked" type="HeaderLineLockedType" default="False">
          <xs:annotation>
            <xs:documentation>Sets the level of manual input allowed on the header field. Scans will always be accepted if acceptBarcode is set to true.</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="searchType" type="xs:string">
          <xs:annotation>
            <xs:documentation>The value added to the Type element, which is send to the backend when performing an online search. E.g. BinSearch as defined in the header configuration for BinContent.</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="defaultTo" type="DefaultToType" use="optional" default="FirstValue">
          <xs:annotation>
            <xs:documentation>When 'defaultValue' is not used in a list configuration, this configuration value determines whether to pre-select the first value in the list or start 'blank' instead. Defaults to 'FirstValue'.</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="inputType" type="BaseInputAttributeInputType" use="required"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:simpleType name="HeaderEnterKeyBehaviourType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="AcceptOnCompleted">
        <xs:annotation>
          <xs:documentation>Enter key will move selection to next mandatory field, and finally accept the header.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NextEmptyLine">
        <xs:annotation>
          <xs:documentation>Enter key will move selection to next empty line, and finally accept the header, if all mandatory lines have a value.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="HeaderLineLockedType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="False">
        <xs:annotation>
          <xs:documentation>Allows the user to manually enter a value using the keyboard.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SearchOnly">
        <xs:annotation>
          <xs:documentation>Prevents the user from manually entering values into the field, but allows using the search functionality if a SearchType is setup as an attribute on the header line.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="True">
        <xs:annotation>
          <xs:documentation>Prevents the user from manually entering values into the field.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="DefaultToType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="None" />
      <xs:enumeration value="FirstValue" />
    </xs:restriction>
  </xs:simpleType>

  <!-- SERVICES -->
  <xs:complexType name="ServicesConfigurationType">
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="service" type="ServiceConfigurationType" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ServiceConfigurationType">
    <xs:all>
      <xs:element name="offlineOrderSearch" minOccurs="0" maxOccurs="1">
        <xs:complexType>
          <xs:attribute name="allowPartialMatch" type="xs:boolean" default="false">
            <xs:annotation>
              <xs:documentation>
                Allow the search to find orders from a value which is contained in the property, and not necessarily exact like the property.
                AllowPartialMatch = true, also allows the barcode to be case insensitive.
              </xs:documentation>
            </xs:annotation>
          </xs:attribute>
          <xs:attribute name="level" type="OfflineOrderSearchLevel" default="Order">
            <xs:annotation>
              <xs:documentation>
                Define which object the scanned value belongs to, and thereby which level to search for the order in. Either Order or OrderLine.
              </xs:documentation>
            </xs:annotation>
          </xs:attribute>
          <xs:attribute name="propertyName" type="xs:string">
            <xs:annotation>
              <xs:documentation>
                Define which property to search in when scanning a value.
                E.g. ItemNumber, OrderBackendID on the Order Lines.
                E.g. DisplayLine1, BackendID on the Order.
              </xs:documentation>
            </xs:annotation>
          </xs:attribute>
        </xs:complexType>
      </xs:element>
      <xs:element name="requests" minOccurs="1" maxOccurs="1">
        <xs:complexType>
          <xs:all>
            <xs:element name="getOrders" minOccurs="1" maxOccurs="1" type="xs:string" >
              <xs:annotation>
                <xs:documentation>The document name in the request xml when fetching orders e.g. GetPutAwayOrders</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="getOrderLines" minOccurs="1" maxOccurs="1" type="xs:string" >
              <xs:annotation>
                <xs:documentation>The document name in the request xml when fetching orderlines e.g. GetPutAwayOrderLines</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="getRegistrationCollector" minOccurs="0" maxOccurs="1" type="xs:string" default="GetRegistrationConfiguration">
              <xs:annotation>
                <xs:documentation>The document name in the request xml when fetching Registration Collector Configuration e.g. GetRegistrationConfiguration</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="lockOrder" minOccurs="0" maxOccurs="1" type="xs:string" default="LockOrder" >
              <xs:annotation>
                <xs:documentation>The document name in the request xml when unlocking an order. E.g. LockOrder</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="unlockOrder" minOccurs="0" maxOccurs="1" type="xs:string" default="UnlockOrder" >
              <xs:annotation>
                <xs:documentation>The document name in the request xml when unlocking an order. E.g. UnlockOrder</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="postOrder" minOccurs="0" maxOccurs="1" type="xs:string" default="PostOrder" >
              <xs:annotation>
                <xs:documentation>The document name in the request xml when posting the order. E.g PostPickOrder</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="liveUpdate" minOccurs="0" maxOccurs="1" type="xs:string" default="RegisterRealtimeQuantity" >
              <xs:annotation>
                <xs:documentation>The document name in the request xml used when posting live updates.</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="lineSelection" minOccurs="0" maxOccurs="1" type="xs:string" default="GetLineSelectionInformation">
              <xs:annotation>
                <xs:documentation>The document name in the request XML used when fetching line selection information. Defaults to 'GetLineSelectionInformation'.</xs:documentation>
              </xs:annotation>
            </xs:element>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="validation" minOccurs="0" maxOccurs="1">
        <xs:complexType>
          <xs:all>
            <xs:element name="fromBinValidation" minOccurs="0" maxOccurs="1" type="FromBinValidationType"/>
            <xs:element name="lotNumberValidation" minOccurs="0" maxOccurs="1" type="LotNumberValidationType"/>
            <xs:element name="quantityValidation" minOccurs="0" maxOccurs="1" type="QuantityValidationType"/>
            <xs:element name="serialNumberValidation" minOccurs="0" maxOccurs="1" type="SerialNumberValidationType"/>
            <xs:element name="toBinValidation" minOccurs="0" maxOccurs="1" type="ToBinValidationType"/>
            <xs:element name="toteValidation" minOccurs="0" maxOccurs="1" type="ToteValidationType"/>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="imageDownload" minOccurs="0" maxOccurs="1">
        <xs:complexType>
          <xs:attribute name="mode" use="optional" type="ImageDownloadConfigurationType" default="downloadOnDemand" />
          <xs:attribute name="chunkSize" use="optional" type="xs:int" default="500">
            <xs:annotation>
              <xs:documentation>
                The number of images to fetch per request. If using large images there might be a problem when fetching images.
                In that case the chuck size should be reduced.
              </xs:documentation>
            </xs:annotation>
          </xs:attribute>
        </xs:complexType>
      </xs:element>
    </xs:all>
    <xs:attribute name="id" use="required" type="xs:string" />
    <xs:attribute name="type" use="required" type="ServiceTypeConfigurationType" />
    <xs:attribute name="orderFilterGs1AI" use="optional" type="xs:string">
      <xs:annotation>
        <xs:documentation>
          Attribute for setting which Gs1 AI's should be used to filter an order list, when scanning a Gs1 barcode.
          When nothing is defined here, the itemNumberAI defined in the Workflow, will be used.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="orderType" use="required" type="xs:string"/>
    <xs:attribute name="initializeOnStartup" type="xs:boolean" use="optional" default="false" />
    <xs:attribute name="lineCompletedDefinition" type="LineCompletedDefinition">
      <xs:annotation>
        <xs:documentation>
          Defines when a line is considered completely registered. Generally a line is completed when the registered quantity matches the quantity defined by the order line.
          Performing count operations are often different, as they are considered complete on any registration with any quantity.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="workflowId" type="xs:string" use="optional" default="standard" >
      <xs:annotation>
        <xs:documentation>
          The workflow that will be used along with this service. The workflowid points to a workflow that must be defined in the resources section in the application file.
          The default is set to standard but can be changed to match the customers need for a workflow.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="operationMode" type="OperationModeType">
      <xs:annotation>
        <xs:documentation>
          The operation mode for the service. Possible Operation Modes are defined in the <seealso cref="OperationModeType">OperationModeType</seealso>
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="allowChangesToFinishedOrders" type="AllowChangesToFinishedOrdersType" use="optional" default="Yes">
      <xs:annotation>
        <xs:documentation>
          Allow changes to registrations once the order has been marked as finished.
          In Offline operation mode the Finished state is when the order has been marked as finish but before it is posted.

          E.g. if a customer put a signature on an order then the allowChangesOnceOrderMarkedFinished attribue can be set to false so the registrations cannot be changed or deleted.

          NB: If there are errors when posting the order then registrations cannot be corrected if this is set to No.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="useOrderLocking" type="xs:boolean" use="optional" default="true">
      <xs:annotation >
        <xs:documentation>
          If this is set to false then orders will not be locked when the user enters the order.
          The default is true.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:simpleType name="AllowChangesToFinishedOrdersType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="No">
        <xs:annotation>
          <xs:documentation>Do not allow changes to finished orders.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="OnPostingError">
        <xs:annotation>
          <xs:documentation>Allow changes to finished orders if they have been posted, and an error was returned from the backend.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Yes">
        <xs:annotation>
          <xs:documentation>Always allow changes to finished orders. This is the default.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ServiceTypeConfigurationType">
    <xs:restriction base="xs:string">
      <!-- Keep the list sorted alphabetically -->
      <xs:enumeration value="Order" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="OfflineOrderSearchLevel">
    <xs:restriction base="xs:string">
      <!-- Keep the list sorted alphabetically -->
      <xs:enumeration value="Order" >
        <xs:annotation>
          <xs:documentation>
            Use the scanned barcode to search in the list of orders.
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="OrderLine" >
        <xs:annotation>
          <xs:documentation>
            Use the scanned barcode to search in all order lines, to find the matching orders.
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="OperationModeType">
    <xs:restriction base="xs:string">
      <!-- Keep the list sorted alphabetically -->
      <xs:enumeration value="Offline" >
        <xs:annotation>
          <xs:documentation>
            The offline mode means that all orders and their orderlines will be fetched to the device.
            Once a registration has been made it is not possible to update the list of orders and orderlines before the created registrations has been posted or deleted.
            This is especially useful in scenarios where there is no access to the backend when registrations are done.

            The useOrderLocking attribute will implicitly be set to to false in Offline Operation Mode.
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Online" >
        <xs:annotation>
          <xs:documentation>Online is the default Operation Mode. Orderlines will be fetched every time the user opens an order.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="OnlineWithLiveUpdate" >
        <xs:annotation>
          <xs:documentation>Extends the Online Operation Mode by sending a registration to the backend every time a registration has been made.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="LineCompletedDefinition">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Expected">
        <xs:annotation>
          <xs:documentation>The order line is considered completed when the registrations match the expected quantity defined on the order line.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AnyRegistration">
        <xs:annotation>
          <xs:documentation>The order line is considered completed when any registration is made. Often used when performing count operations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="WithinRange">
        <xs:annotation>
          <xs:documentation>The order line is considered completed when the registered quantity is within the range defined by the order line.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="QuantityValidationType">
    <xs:complexContent>
      <xs:extension base="OnlineOnlyValidationType">
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="SerialNumberValidationType">
    <xs:complexContent>
      <xs:extension base="OnlineValidationType">
        <xs:attribute name="validationLevel">
          <xs:simpleType>
            <xs:restriction base="SerialNumberValidationLevel"/>
          </xs:simpleType>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="FromBinValidationType">
    <xs:complexContent>
      <xs:extension base="OnlineOnlyValidationType">
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="LotNumberValidationType">
    <xs:complexContent>
      <xs:extension base="OnlineOnlyValidationType">
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:simpleType name="SerialNumberValidationLevel">
    <xs:annotation>
      <xs:documentation>
        Defines the level in which serial numbers need to be unique.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="Item">
        <xs:annotation>
          <xs:documentation>A given serial number can only be registered once per item number, on the selected order. Prevents registering the same serial number on multiple order lines carrying the same item number.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Line">
        <xs:annotation>
          <xs:documentation>A given serial number can only be registered once for each order line. Allows registering the same serial number on multiple order lines carrying the same item number.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="None">
        <xs:annotation>
          <xs:documentation>Disable local serial number validation completely, allowing the same serial number to be registered multiple times.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Order">
        <xs:annotation>
          <xs:documentation>A given serial number can only be registered once on the entire order.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="ToBinValidationType">
    <xs:complexContent>
      <xs:extension base="OnlineOnlyValidationType">
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="ToteValidationType">
    <xs:complexContent>
      <xs:extension base="OnlineOnlyValidationType">
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="OnlineOnlyValidationType">
    <xs:complexContent>
      <xs:restriction base="OnlineValidationType">
        <xs:attribute name="documentName" type="OnlineValidationDocumentNameAttribute" use="required"/>
      </xs:restriction>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="OnlineValidationType">
    <xs:annotation>
      <xs:documentation>Enables online validation of the values entered until this point.</xs:documentation>
    </xs:annotation>
    <xs:attribute name="online" type="xs:boolean" use="required">
      <xs:annotation>
        <xs:documentation>
          Enables or disables the online validation for the given type.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="documentName" type="OnlineValidationDocumentNameAttribute" use="optional"/>
    <xs:attribute name="includeCollectedValues" type="xs:boolean" default="false" use="optional">
      <xs:annotation>
        <xs:documentation>
          Defines whether to include already collected values when doing online validation.

          False - Do not include collected values.
          True - Includes the collected values until the active step in the online validation request.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:simpleType name="OnlineValidationDocumentNameAttribute">
    <xs:restriction base="xs:string">
      <xs:annotation>
        <xs:documentation>
          Defines the method to call when the online validation is triggered.
        </xs:documentation>
      </xs:annotation>
    </xs:restriction>
  </xs:simpleType>

  <!-- PAGES -->
  <xs:complexType name="PagesConfigurationType">
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="page" type="PageConfigurationType" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="PageConfigurationType">
    <xs:all >
      <xs:element name="title" minOccurs="0" maxOccurs="1" type="PageTitleConfigurationType" />
      <xs:element ref="pageTypeSpecificConfiguration" minOccurs="0" maxOccurs="1"/>
      <xs:element name="actions" minOccurs="0" maxOccurs="1">
        <xs:complexType >
          <xs:sequence>
            <xs:choice minOccurs="0" maxOccurs="unbounded" >
              <xs:element name="open" type="OpenConfigurationType" />
              <xs:element name="adhocRegistration" type="AdhocRegistrationConfigurationType" >
                <xs:annotation>
                  <xs:documentation>The adhocRegistration action addes a menu item that will call a AdhocRegistration. A call that the backend will handle.</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="print" type="PrintConfigurationType" >
                <xs:annotation>
                  <xs:documentation>The print action addes a menu item that will call a print (a special AdhocRegistration)</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="showImage" type="ShowImageConfigurationType" >
                <xs:annotation>
                  <xs:documentation>The showimage action addes a menu item that will open a page to show the image</xs:documentation>
                </xs:annotation>
              </xs:element>
            </xs:choice>
          </xs:sequence>
          <xs:attribute name="headerTitle" type="xs:string" use="optional">
            <xs:annotation>
              <xs:documentation>Header title for the menu with actions</xs:documentation>
            </xs:annotation>
          </xs:attribute>
        </xs:complexType>
      </xs:element>
      <xs:element name="shortcuts" minOccurs="0" maxOccurs="1" type="ShortcutsConfigurationType" />
      <xs:element name="typeBarcode" minOccurs="0" maxOccurs="1" type="TypeBarcodeConfigurationType">
        <xs:annotation>
          <xs:documentation>
            Menu item for the Type Barcode.

            Default for the title is @{EnterBarcodeMenuItem}
            Default menuPlacement is 21 (20 is default) so it will appear later in the menu.
            Default contextMenuPlacement is "Off" so it will not appear in the context menu. This can be adjusted by the ContextMenuPlacement to a number.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="warnOnNavigatingBack" minOccurs="0" maxOccurs="1">
        <xs:annotation>
          <xs:documentation>
            If this feature is enabled the user will be warned when navigating away from the page. Typically used to avoid going to the login page unintentionally.
          </xs:documentation>
        </xs:annotation>
        <xs:complexType >
          <xs:attribute name="warningType" type="PageExitWarningType" use="optional" >
            <xs:annotation>
              <xs:documentation>
                Utilizing this functionality will either warn or block the user when trying to exit a page.
                By default this feature is disabled (warningType = None)
              </xs:documentation>
            </xs:annotation>
          </xs:attribute>

          <xs:attribute name="enabled" type="xs:boolean" use="optional" >
            <xs:annotation>
              <xs:documentation>
                DEPRECATED! Use WarningType instead.
                If enabled, the user will be prompted about returning to the previous page.

                By default this feature is disabled (enabled = false)
              </xs:documentation>
            </xs:annotation>
          </xs:attribute>
          <xs:attribute name="title" type="xs:string" use="optional" >
            <xs:annotation>
              <xs:documentation>
                Title of the warning message displayed when the user navigates back to the previous page

                Default value is @{ReturnToPreviousPageWarningTitle}
              </xs:documentation>
            </xs:annotation>
          </xs:attribute>
          <xs:attribute name="message" type="xs:string" use="optional" >
            <xs:annotation>
              <xs:documentation>
                Warning message displayed when the user navigates back to the previous page.

                Default value is @{ReturnToPreviousPageWarningMessage}
              </xs:documentation>
            </xs:annotation>
          </xs:attribute>
        </xs:complexType>
      </xs:element>
      <xs:element name="menu" minOccurs="0" maxOccurs="1">
        <xs:annotation>
          <xs:documentation>
            Sets up the menu on the page.

            Notice that individual menu items are set up else where like the typeBarcode, postOrder, refersh etc.
          </xs:documentation>
        </xs:annotation>
        <xs:complexType >
          <xs:attribute name="title" type="xs:string" use="optional" >
            <xs:annotation>
              <xs:documentation>
                Title of the 'Menu' item that opens the menu popup.

                Default value is @{MenuDefaultHeader}
              </xs:documentation>
            </xs:annotation>
          </xs:attribute>
          <xs:attribute name="numberOfPromotedItems" type="xs:int" use="optional" default="0">
            <xs:annotation>
              <xs:documentation>
                The number of promoted items defines how many menu items will be placed on the menubar outside of the popup menu.

                The menu items will only be promoted if there is available space on the screen. If there are more menu items than added as promoted items a "Menu" menu item will be added to open the popup menu.

                The promoted items are based on the placement defined on the individual menu items.

                Set the number of promoted items to -1 to let the system place as many menu items outside the popup menu as possible.
              </xs:documentation>
            </xs:annotation>
          </xs:attribute>
        </xs:complexType>
      </xs:element>
    </xs:all>
    <xs:attribute name="id" use="required" type="xs:string" />
    <xs:attribute name="type" use="required" type="PageTypeConfigurationType" />
    <xs:attribute name="icon" use="optional" type="xs:string"/>
  </xs:complexType>

  <xs:simpleType name="PageExitWarningType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Block">
        <xs:annotation>
          <xs:documentation>Prevent the user from exiting the page.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="None">
        <xs:annotation>
          <xs:documentation>Allow the user to exit the page without warning. Default behaviour.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Warn">
        <xs:annotation>
          <xs:documentation>Ask the user whether leaving the page was intentional - and allow exiting if confirmed by the user.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:element name="pageTypeSpecificConfiguration" abstract="true"/>
  <xs:element name="lookupConfiguration" type="LookupConfigurationType" substitutionGroup="pageTypeSpecificConfiguration" />
  <xs:element name="menuConfiguration" type="MenuConfigurationType" substitutionGroup="pageTypeSpecificConfiguration" />
  <xs:element name="offlineManagementConfiguration" type="OfflineManagementConfigurationType" substitutionGroup="pageTypeSpecificConfiguration" />
  <xs:element name="orderLinesConfiguration" type="OrderLinesConfigurationType" substitutionGroup="pageTypeSpecificConfiguration"/>
  <xs:element name="orderListConfiguration" type="OrderListConfigurationType" substitutionGroup="pageTypeSpecificConfiguration"/>
  <xs:element name="pendingRegistrationsConfiguration" type="PendingRegistrationsConfigurationType" substitutionGroup="pageTypeSpecificConfiguration"/>
  <xs:element name="registrationsConfiguration" type="RegistrationsConfigurationType" substitutionGroup="pageTypeSpecificConfiguration"/>
  <xs:element name="searchConfiguration" type="SearchConfigurationType" substitutionGroup="pageTypeSpecificConfiguration"/>
  <xs:element name="settingsConfiguration" type="SettingsConfigurationType" substitutionGroup="pageTypeSpecificConfiguration"/>
  <xs:element name="unplannedItemRegistrationConfiguration" type="UnplannedItemRegistrationConfigurationType" substitutionGroup="pageTypeSpecificConfiguration"/>

  <xs:complexType name="ActionConfigurationType">
    <xs:complexContent>
      <xs:extension base="BaseContextMenuConfiguration">
        <xs:attribute name="id" type="xs:string" use="required" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="TypeBarcodeConfigurationType">
    <xs:complexContent>
      <xs:extension base="BaseContextMenuConfiguration">
        <xs:sequence>
          <xs:element name="qualifiers" minOccurs="0">
            <xs:complexType>
              <xs:sequence >
                <xs:element name="qualifier" minOccurs="1" maxOccurs="unbounded">
                  <xs:complexType >
                    <xs:attribute name="displayValue" type="xs:string" >
                      <xs:annotation>
                        <xs:documentation>
                          The value that will be displayed on the type barcode view. The field supports the @{} notation for localization.
                        </xs:documentation>
                      </xs:annotation>
                    </xs:attribute>
                    <xs:attribute name="ai" type="xs:string" use="required">
                      <xs:annotation>
                        <xs:documentation>
                          The GS1 Application Identifier (AI) that will be used to qualify the scanned barcode. The barcode will be transformed to a GS1 barcode using the provided AI.
                        </xs:documentation>
                      </xs:annotation>
                    </xs:attribute>
                  </xs:complexType>
                </xs:element>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="ShortcutsConfigurationType">
    <xs:annotation>
      <xs:documentation>Shortcuts defined for the page</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="shortcut" minOccurs="0" maxOccurs="unbounded" type="ShortcutConfigurationType" />
    </xs:sequence>
    <xs:attribute name="shortcutGs1Ai" default="94" type="xs:string" >
      <xs:annotation>
        <xs:documentation>
          The GS1 application identifier for the barcode shortcuts. Barcodes used for referencing shortcuts must be a GS1 barcode with the barcode AI and prefixed with "SC-" e.g. "SC-F1" where F1 is the KeyName in the shortcut configuration.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="ShortcutConfigurationType">
    <xs:attribute name="action" type="xs:string" use="required" >
      <xs:annotation>
        <xs:documentation>
          Shortcuts refer to items in the menu. The menu items are defined via the actions section in the page configuration and there are also some system defined menu items.
          The action attribute must refer to an id of an action or a system defined menu item.

          Some of the most common system defined menu items are:
          "openListItem" (Opens the currently select item in the list)
          "post" (Posts the order)
          "unlock" (Unlocks the selected order)
          "typeBarcode" (Opens a text field where a barcode can be entered. This will act as a normal scan)
          "update" (Updates the list)
          "openMenu" (Opens the menu)
          "pinpointItem" uses the camera for finding an item on Order Lines pages.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="keyName" type="xs:string" use="required" >
      <xs:annotation>
        <xs:documentation>The name of the key. This must match the keyCode/keyName that the device is providing</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="keyLabel" type="xs:string" use="optional" >
      <xs:annotation>
        <xs:documentation>The label of the key used when displaying the key in the menu</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="OpenConfigurationType">
    <xs:complexContent>
      <xs:extension base="ActionConfigurationType">
        <xs:sequence minOccurs="0" maxOccurs="1">
          <xs:element name="transfer" type="TransferConfigurationType" minOccurs="0" maxOccurs="unbounded">
            <xs:annotation>
              <xs:documentation>
                Transferring values between pages is setup automatically and includes any selected line, and any header values present. Return transfer still needs to be manually setup.
                If only the selected line should be transferred, then it must be setup manually.
                And if no transfer should happen, set the automaticValueTransfer attribute on the Open element to false. E.g. &lt;Open ... automaticValueTransfer="false" &gt;.
              </xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="returnTransfer" type="TransferConfigurationType" minOccurs="0" maxOccurs="unbounded">
            <xs:annotation>
              <xs:documentation>
                The return transfer configuration dictates what should happen when returning from the opened page.
                E.g. returntransfer property="UnplannedItemRegistrationCompleted" to="RefreshOnResume" would refresh the parent page when returned to, if the unplanned child page performed a successful post.
              </xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
        <xs:attribute name="automaticValueTransfer" type="xs:boolean" use="optional" default="true">
          <xs:annotation>
            <xs:documentation>
              Enable/Disable automatically transferring values from one page to the page being opened.
            </xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="TransferConfigurationType">
    <xs:attribute name="property" type="PagePropertyConfigurationType" use="required" >
      <xs:annotation>
        <xs:documentation>
          The property determine where to get the values to put in the 'to' on the receiving page.

          In general the values in property and to attribute follow to rules that the type of the page is prefixed in the attribute value.
          E.g. transfer property="OrderLinesSelectedLine" to="LookupInputValues" would be used on a OrderLines page type and navigating to a Lookup page type.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="to" type="PagePropertyConfigurationType" use="required" >
      <xs:annotation>
        <xs:documentation>
          The to attribute determine to put the values received from the 'property' attribute.

          In general the values in property and to attribute follow to rules that the type of the page is prefixed in the attribute value.
          E.g. transfer property="OrderLinesSelectedLine" to="LookupInputValues" would be used on a OrderLines page type and navigating to a Lookup page type.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="AdhocRegistrationConfigurationType">
    <xs:complexContent>
      <xs:extension base="ActionConfigurationType">
        <xs:sequence>
          <xs:element name="onSuccessfulPost" minOccurs="0" maxOccurs="1" type="OnSuccessfulPostType" >
            <xs:annotation>
              <xs:documentation>Determine what to do after a successful submit of the adHoc registration</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
        <xs:attribute name="registrationType" type="xs:string"  >
          <xs:annotation>
            <xs:documentation>The registration type that will be sent to in the request. It is optional.</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="documentName" type="xs:string" >
          <xs:annotation>
            <xs:documentation>The default documentName is "PostAdHocRegistration" but if needed this can be overwritten. Document Name is also referred to as Document Type</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="sendRegistrationData" type="SendRegistrationDataType" default="None">
          <xs:annotation>
            <xs:documentation>
              If set to 'Order' then all registrations made on the order will be included in the request sent to the server. This will include order level registrations, order line registrations and order line extra registrations.
              The order tag will be added to the response.

              If set to 'OrderLine' then only the registrations for the selected order line (Order line registration and extra information) will be included in the request sent to the server.
              The order tag will be added to the response but only contain information about the selected order line. This is only valid on a Order Line Page.

              The default is None.

              In general the attribute is only valid on Order and Order Line Pages.
            </xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:simpleType name="SendRegistrationDataType">
    <xs:restriction base="xs:string">
      <!-- Keep the list sorted alphabetically -->
      <xs:enumeration value="None" >
        <xs:annotation>
          <xs:documentation>
            No order registrations will be sent with the adhoc request.
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Order" >
        <xs:annotation>
          <xs:documentation>
            All order registrations will be included in the request sent to the server. This will include order level registrations, order line registrations and order line extra registrations.
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="OrderLine" >
        <xs:annotation>
          <xs:documentation>
            Registrations for the selected order line (Order line registrations and extra information) will be included in the request sent to the server.
            This is only valid on a Order Line Page.
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="PrintConfigurationType">
    <xs:complexContent>
      <xs:extension base="ActionConfigurationType">
        <xs:sequence>
          <xs:element name="onSuccessfulPost" minOccurs="0" maxOccurs="1" type="OnSuccessfulPostType" >
            <xs:annotation>
              <xs:documentation>Determine what to do after a successful submit of the call to print</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
        <xs:attribute name="registrationType" type="xs:string"  >
          <xs:annotation>
            <xs:documentation>The registration type that will be sent to in the request. It could be Label, SalesReceipt etc.</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="documentName" type="xs:string" >
          <xs:annotation>
            <xs:documentation>Defines the document name to call for printing. Defaults to "Print".</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="sendRegistrationData" type="SendRegistrationDataType" default="None">
          <xs:annotation>
            <xs:documentation>
              If set to 'Order' then all order registrations will be included in the request sent to the server. This will include order level registrations, order line registrations and order line extra registrations.
              The order tag will be added to the response.

              If set to 'OrderLine' then only the registrations for the selected order line (Order line registration and extra information) will be included in the request sent to the server.

              The default is None and the attribute is only valid in OrderPages and OrderLinesPages
            </xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="PinpointItemConfigurationType">
    <xs:complexContent>
      <xs:extension base="BaseContextMenuConfiguration">
        <xs:attribute name="useFoundBarcodeAsScan" type="xs:boolean" default="true">
          <xs:annotation>
            <xs:documentation>
              If set to true, the found barcode will be used as a scan.
            </xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="imageId" type="xs:string">
          <xs:annotation>
            <xs:documentation>
              Use this attribute to decide which property to use when getting the image displayed next to the barcode. The default is ItemNumber, which is translated into the actual item number of the selected order line.
            </xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="ShowImageConfigurationType">
    <xs:complexContent>
      <xs:extension base="ActionConfigurationType">
        <xs:attribute name="registrationType" type="xs:string" use="optional">
          <xs:annotation>
            <xs:documentation>The registration type that will be sent to in the request. It could be Image, Details, All etc.</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="imageProperty" type="xs:string" use="required">
          <xs:annotation>
            <xs:documentation>The property on the selected object (e.g. OrderLine) that contains the id of the image. </xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:simpleType name="PagePropertyConfigurationType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="LookupInputValues"/>
      <xs:enumeration value="LookupPostCompleted"/>
      <xs:enumeration value="LookupSelectedResult"/>
      <xs:enumeration value="OrderLinesSelectedLine" />
      <xs:enumeration value="OrderListInputValues" />
      <xs:enumeration value="OrderListSelectedOrder" />
      <xs:enumeration value="UnplannedItemRegistrationInputValue" />
      <xs:enumeration value="UnplannedItemRegistrationCompleted" />
      <xs:enumeration value="RefreshOnResume" />
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="PageTitleConfigurationType">
    <xs:attribute name="enabled" use="optional" type="xs:boolean" default="true" />
    <xs:attribute name="labelId" use="optional" type="xs:string" default="null" />
    <xs:attribute name="defaultValue" use="required" type="xs:string" />
  </xs:complexType>

  <xs:simpleType name="PageTypeConfigurationType">
    <xs:restriction base="xs:string">
      <!-- Keep the list sorted alphabetically -->
      <xs:enumeration value="AdhocRegistrations" />
      <xs:enumeration value="Lookup" />
      <xs:enumeration value="Menu" />
      <xs:enumeration value="OfflineManagement" />
      <xs:enumeration value="OrderLines" />
      <xs:enumeration value="OrderList" />
      <xs:enumeration value="Registrations" />
      <xs:enumeration value="ScanInfo" />
      <xs:enumeration value="Search" />
      <xs:enumeration value="Settings" />
      <xs:enumeration value="ShowImage" />
      <xs:enumeration value="UnplannedItemRegistration" />
    </xs:restriction>
  </xs:simpleType>

  <!-- MENU -->
  <xs:complexType name="MenuConfigurationType">
    <xs:all>
      <xs:element name="menuItems" minOccurs="0" maxOccurs="1">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="menuItem" minOccurs="0" maxOccurs="unbounded">
              <xs:complexType>
                <xs:attribute name="id" type="xs:string" use="required" />
                <xs:attribute name="displayName" type="xs:string" use="optional" />
                <xs:attribute name="icon" type="xs:string" use="optional" />
                <xs:attribute name="alwaysEnabled" type="xs:boolean" use="optional" >
                  <xs:annotation>
                    <xs:documentation>
                      If true the menu item will be enabled even if not present in the enabled list in the backend.
                      This should only be used for development of new pages.
                    </xs:documentation>
                  </xs:annotation>
                </xs:attribute>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="FilterConfigurationType" >
    <xs:complexContent>
      <xs:extension base="BaseConfigurableHeaderConfigurationType">
        <xs:attribute name="enabled" type="xs:boolean" use="optional" default="true">
          <xs:annotation>
            <xs:documentation>
              Defines whether the page can restrict returned orders by using a filter.
            </xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!-- ORDER LIST -->
  <xs:complexType name="OrderListConfigurationType">
    <xs:all>
      <xs:element name="cancelOrder" minOccurs="0" maxOccurs="1" type="BaseContextMenuConfiguration">
        <xs:annotation>
          <xs:documentation>
            Enabling this, allows the user to cancel an entire order. Accessed through a menu item on the order list.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="service" minOccurs="1" maxOccurs="1">
        <xs:complexType>
          <xs:attribute name="id" type="xs:string" use="required" />
        </xs:complexType>
      </xs:element>
      <xs:element name="filter" minOccurs="0" maxOccurs="1" type="FilterConfigurationType"/>
      <xs:element name="list" type="ListType" minOccurs="1" />
      <xs:element name="onOrderSelected" minOccurs="0" maxOccurs="1">
        <xs:complexType>
          <xs:attribute name="navigateTo" type="xs:string" use="required" />
        </xs:complexType>
      </xs:element>
      <xs:element name="registerOrder" minOccurs="0" maxOccurs="1" type="BaseContextMenuConfiguration">
        <xs:annotation>
          <xs:documentation>
            Enabling this, allows the user to register an entire order with the default values provided by the order lines. Accessed through a menu item on the order list.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="unlockOrder" minOccurs="0" maxOccurs="1" type="BaseContextMenuConfiguration">
        <xs:annotation>
          <xs:documentation>Menu item for unlock order</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="search" minOccurs="0" maxOccurs="1" type="SearchNavigationType" >
        <xs:annotation>
          <xs:documentation>Search configuration used by the search icon in the header</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="postAllOrders" minOccurs="0" maxOccurs="1" type="BaseContextMenuConfiguration">
        <xs:annotation>
          <xs:documentation>
            If enabled the post all orders option will appear in the menu. The default text for the menu item is 'Post Orders'
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="viewErrorMessage" minOccurs="0" maxOccurs="1" type="BaseContextMenuConfiguration">
        <xs:annotation>
          <xs:documentation>
            Menu item for View Error message used in offline scenario.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="clearCompletedOrders" minOccurs="0" maxOccurs="1" type="BaseContextMenuConfiguration">
        <xs:annotation>
          <xs:documentation>
            Menu item for Clear completed orders used in offline scenario.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="toggleShowPostedOrders" minOccurs="0" maxOccurs="1" type="ToggleShowPostedOrdersContextMenuConfiguration">
        <xs:annotation>
          <xs:documentation>
            Optional element for hiding and showing Posted orders.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="flagOrder" minOccurs="0" maxOccurs="1" type="FlagOrderConfigurationType">
        <xs:annotation>
          <xs:documentation>The order flagging feature allows a user to flag an order for follow-up inspection. If the 'flagOrder' element is included, the order flagging feature is automatically enabled.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:all>
    <xs:attribute name="automaticOrderSelectionAfterFilter" type="xs:boolean" use="optional" default="false">
      <xs:annotation>
        <xs:documentation>Enables automatic order selection if only one order exists in the list after a filter scan.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- ORDER LINES -->
  <xs:complexType name="OrderLinesConfigurationType">
    <xs:all>
      <xs:element name="service" minOccurs="1" maxOccurs="1">
        <xs:complexType>
          <xs:attribute name="id" type="xs:string" use="required" />
        </xs:complexType>
      </xs:element>
      <xs:element name="extraInformationConfiguration" minOccurs="0" maxOccurs="1">
        <xs:complexType>
          <xs:attribute name="source" use="optional" default="ReferenceData">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:enumeration value="Online" />
                <xs:enumeration value="ReferenceData" />
              </xs:restriction>
            </xs:simpleType>
          </xs:attribute>
          <xs:attribute name="stepSorting" use="optional" default="AfterBin">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:enumeration value="AfterBin" >
                  <xs:annotation>
                    <xs:documentation>The steps retrieved as extra information will be inserted after the last "To Bin" or "From bin" collector step.</xs:documentation>
                  </xs:annotation>
                </xs:enumeration>
                <xs:enumeration value="ById" >
                  <xs:annotation>
                    <xs:documentation>
                      The steps retrieved as extraInformation will be sorted by id along with the steps configured in the workflow.
                      Thereby the extra steps can be injected different places in the workflow.
                    </xs:documentation>
                  </xs:annotation>
                </xs:enumeration>
              </xs:restriction>
            </xs:simpleType>
          </xs:attribute>
        </xs:complexType>
      </xs:element>
      <xs:element name="list" type="ListType" minOccurs="1" />
      <xs:element name="viewRegistrations" type="NavigationContextMenuConfiguration" minOccurs="0" maxOccurs="1">
        <xs:annotation>
          <xs:documentation>The menu item for Viewing registrations</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="deleteOrderRegistrations" minOccurs="0" maxOccurs="1" type="BaseContextMenuConfiguration">
        <xs:annotation>
          <xs:documentation>
            Delete all registrations on the chosen order including order line registrations and order level registrations.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="postOrder" minOccurs="0" maxOccurs="1" type="BaseContextMenuConfiguration">
        <xs:annotation>
          <xs:documentation>
            If enabled the post order option will appear in the menu. The default text for the menu item is 'Post'
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="cancelRemainingLineQuantity" minOccurs="0" maxOccurs="1" type="BaseContextMenuConfiguration">
        <xs:annotation>
          <xs:documentation>
            Cancels the remaining quantity on the currently selected/highlighted order line. This generates a 'cancel' registration on the device which is posted just like any other registration. The feature is disabled by default and must be explicitly enabled.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="finishOrder" minOccurs="0" maxOccurs="1" type="FinishOrderMenuConfiguration">
        <xs:annotation>
          <xs:documentation>
            Menu item for marking an order as finished and ready to be posted used in offline scenario.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="orderLevelRegistrations" minOccurs="0" maxOccurs="1" type="OrderLevelRegistrationMenuConfiguration">
        <xs:annotation>
          <xs:documentation>
            Menu item for the default order level registration, which is send out as part of the order lines response, and always opened when an order is posted.
            Any additional order level registrations are locally defined, and optional, so they will not be automatically opened when posting an order.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="onOrderPosted" minOccurs="0" maxOccurs="1">
        <xs:complexType>
          <xs:attribute name="clearOrderLevelRegistrations" type="xs:boolean" use="optional" default="false">
            <xs:annotation>
              <xs:documentation>Determines if order level registrations should be cleared after successfully posting an order. The default value is false.</xs:documentation>
            </xs:annotation>
          </xs:attribute>
        </xs:complexType>
      </xs:element>
      <xs:element name="pinpointItem" minOccurs="0" maxOccurs="1" type="PinpointItemConfigurationType">
        <xs:annotation>
          <xs:documentation>
            Pinpoints an item using the camera on the devices. The feature is disabled by default and must be explicitly enabled.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="totePicking" minOccurs="0" maxOccurs="1">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="currentTote" minOccurs="0" maxOccurs="1" >
              <xs:complexType>
                <xs:attribute name="show" type="xs:boolean" default="false">
                  <xs:annotation>
                    <xs:documentation>Determines if the barcode or name of the tote which was last used, should be displayed when collecting the tote value.</xs:documentation>
                  </xs:annotation>
                </xs:attribute>
                <xs:attribute name="useLabelPrefix" type="xs:boolean" default="true">
                  <xs:annotation>
                    <xs:documentation>Visually prefix the last accessed tote with the tote label. The default label is 'Tote:'</xs:documentation>
                  </xs:annotation>
                </xs:attribute>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
          <xs:attribute name="allowManualSelection" type="xs:boolean" default="true">
            <xs:annotation>
              <xs:documentation>Allows the user to select from the list of registered totes. Scanning is always possible.</xs:documentation>
            </xs:annotation>
          </xs:attribute>
        </xs:complexType>
      </xs:element>
      <xs:element name="scanToSelectBehaviour" minOccurs="0" maxOccurs="1">
        <xs:complexType>
          <xs:choice>
            <xs:element name="converter" minOccurs="0" maxOccurs="1">
              <xs:annotation>
                <xs:documentation>
                  A converter is a way to transform a regular barcode into a Gs1 barcode. This is done when a non-Gs1 barcode is scanned and matches the regular expression defined in the converter.
                  The given example transforms all scanned barcodes, containing between 8 and 21 characters in length, into a serial number.
                  That converter will look as follows. &lt; converter expression=&quot;^(\S{8,21})$&quot; expressionAis=&quot;21&quot;/&gt;
                </xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="convertGS1Input" type="xs:boolean" use="optional" default="false">
                  <xs:annotation>
                    <xs:documentation>
                      If this is set to true, the custom converter will also look into the raw value of Gs1 barcodes to find a match.
                      E.g. (01)1234567890 can be translated to 90011234567890 (using the 90 as the application identifier).
                      This means that a wrongfully configured Gs1 barcode can be stripped of application identifiers and recreated as intended.

                      The converter will work on the raw values retrieved from the scan barcode excluding the AIM identifier.
                    </xs:documentation>
                  </xs:annotation>
                </xs:attribute>
                <xs:attribute name="expression" type="xs:string" use="optional">
                  <xs:annotation>
                    <xs:documentation>
                      Regular expression for separating one barcode into a Gs1 barcode.
                      Each regular match group is mapped to one ai, defined in the expressionAi attribute.
                    </xs:documentation>
                  </xs:annotation>
                </xs:attribute>
                <xs:attribute name="expressionAis" type="xs:string" use="optional">
                  <xs:annotation>
                    <xs:documentation>
                      Application identifiers to be prepended to the match group value. The number and order of the ai's must match the number of groups expected by the regular expression.
                      Separate the ai's by a comma. E.g. 90,91,92
                    </xs:documentation>
                  </xs:annotation>
                </xs:attribute>
              </xs:complexType>
            </xs:element>
          </xs:choice>
          <xs:attribute name="behaviour" type="ScanToSelectBehaviourType">
            <xs:annotation>
              <xs:documentation>Determines the behaviour on how to select the order line.</xs:documentation>
            </xs:annotation>
          </xs:attribute>
          <xs:attribute name="gs1SearchTerm" use="optional" default="Item">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>
                  Search term defines which terms should be used when searching for the order line(s) in GS1. In non-GS1 barcodes the search term has no effect.

                  "All" means that all values in the barcode i.e. SerialNumber, Lot and (ItemNumber or ItemBarcode) are used to find a matching order line.
                  E.g. If both Serial Number and Item Number is in the barcode both values are used to find the order line with exact match.

                  "Item" means that if the barcode has Item Number in it and an order line has the ItemBarCode or ItemNumber then there is a match regardless of other values.
                  E.g. if SerialNumber and Item Number is in the barcode it will match the order line on the Item Number.
                </xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:string">
                <xs:enumeration value="All" />
                <xs:enumeration value="Item" />
              </xs:restriction>
            </xs:simpleType>
          </xs:attribute>
        </xs:complexType>
      </xs:element>
      <xs:element name="lineSelection" minOccurs="0" maxOccurs="1">
        <xs:complexType>
          <xs:attribute name="type" use="optional" default="OnlineFirst">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>The type attribute determines the behaviour of the application when searching for/selecting order lines by scanning GS1 barcodes. The default value is 'OnlineFirst'.</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:string">
                <xs:enumeration value="LocalFirst">
                  <xs:annotation>
                    <xs:documentation>Searches for lines locally on the device. If unable to find a matching line it will send the scanned value to the backend for translation.</xs:documentation>
                  </xs:annotation>
                </xs:enumeration>
                <xs:enumeration value="LocalOnly">
                  <xs:annotation>
                    <xs:documentation>Searches for lines using only line data that already exists on the device. No online calls are made.</xs:documentation>
                  </xs:annotation>
                </xs:enumeration>
                <xs:enumeration value="OnlineFirst">
                  <xs:annotation>
                    <xs:documentation>Sends the scanned value to the backend, allowing it to translate it and then use that value when searching for an order line.</xs:documentation>
                  </xs:annotation>
                </xs:enumeration>
              </xs:restriction>
            </xs:simpleType>
          </xs:attribute>
        </xs:complexType>
      </xs:element>
      <xs:element name="search" minOccurs="0" maxOccurs="1" type="NavigationContextMenuConfiguration" >
        <xs:annotation>
          <xs:documentation>Search configuration used by the 'search for order lines' menu item</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="flagOrder" minOccurs="0" maxOccurs="1" type="FlagOrderConfigurationType">
        <xs:annotation>
          <xs:documentation>The order flagging feature allows a user to flag an order for follow-up inspection. If the 'flagOrder' element is included, the order flagging feature is automatically enabled.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="toggleOrderLineGrouping" minOccurs="0" maxOccurs="1" type="ToggleOrderLineGroupingMenuConfiguration"/>
      <xs:element name="pinnableRegistrationValues" minOccurs="0" maxOccurs="1" type="OrderLinesPinnableValuesConfiguration"/>
    </xs:all>
    <xs:attribute name="actionOnEmptyList" use="optional" default="ClosePage">
      <xs:simpleType>
        <xs:annotation>
          <xs:documentation>
            Action for what to do after a successful update and there are no order lines.
          </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
          <xs:enumeration value="ClosePage">
            <xs:annotation>
              <xs:documentation>Close the order lines page and return to the order list.</xs:documentation>
            </xs:annotation>
          </xs:enumeration>
          <xs:enumeration value="StayOnPage">
            <xs:annotation>
              <xs:documentation>Stay on the order lines page even if it is empty. </xs:documentation>
            </xs:annotation>
          </xs:enumeration>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="actionWhenMaxMoveQtyReached" use="optional" default="ShowRegistrations">
      <xs:simpleType>
        <xs:annotation>
          <xs:documentation>
            Dictates what to do when selecting a line, and all registrations have been completed while performing a move action.
          </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
          <xs:enumeration value="CreateRegistration">
            <xs:annotation>
              <xs:documentation>Open the registration collector to allow more registrations to be made.</xs:documentation>
            </xs:annotation>
          </xs:enumeration>
          <xs:enumeration value="PromptToShowRegistrations">
            <xs:annotation>
              <xs:documentation>Ask the user to display the registrations.</xs:documentation>
            </xs:annotation>
          </xs:enumeration>
          <xs:enumeration value="ShowRegistrations">
            <xs:annotation>
              <xs:documentation>Show the registrations made for the order line.</xs:documentation>
            </xs:annotation>
          </xs:enumeration>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="promptUserToPostWhenAllLinesComplete" type="xs:boolean" use="optional" default="true">
      <xs:annotation>
        <xs:documentation>
          If true then the user will be prompted with a dialog whether to post the order when all registrations has been done on all orderlines. The default value is true.

          This attribute has been deprecated use the postingTrigger instead.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="postingTrigger" use="optional" default="PostWhenAllLinesCompleteShowDialog" >
      <xs:annotation>
        <xs:documentation>
          Defines when to trigger the posting and when to prompt the user to trigger posting.
        </xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="UserInitiated">
            <xs:annotation>
              <xs:documentation>Only post when the users selects the menu item to perform the posting.</xs:documentation>
            </xs:annotation>
          </xs:enumeration>
          <xs:enumeration value="PostWhenAllLinesComplete">
            <xs:annotation>
              <xs:documentation>Posts the order when all registrations has been done on all orderlines without prompting.</xs:documentation>
            </xs:annotation>
          </xs:enumeration>
          <xs:enumeration value="PostWhenAllLinesCompleteShowDialog">
            <xs:annotation>
              <xs:documentation>The user will be prompted with a dialog whether to post the order when all registrations has been done on all orderlines</xs:documentation>
            </xs:annotation>
          </xs:enumeration>
          <xs:enumeration value="PostAfterEachRegistration">
            <xs:annotation>
              <xs:documentation>Posts after each registration is performed.</xs:documentation>
            </xs:annotation>
          </xs:enumeration>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="suggestQuantity" type="xs:boolean" default="true">
      <xs:annotation>
        <xs:documentation>Determines if the suggested quantity value should be pre-filled into the quantity step. Default value is true.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="verifySingleScanRegistrations" type="xs:boolean" default="false">
      <xs:annotation>
        <xs:documentation>Determines if single scan registration is allowed, or if the user needs to verify and save the registration manually. Formerly known as singleScanRegistration.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="forceScanToSelect" type="xs:boolean" default="false">
      <xs:annotation>
        <xs:documentation>Determines whether or not a line can only be selected by scanning a barcode. When set to 'true' lines can only be selected by scan. Defaults to 'false', i.e. the user can select a line either by tapping it or scanning a barcode.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="BaseMenuItemConfigurationType">
    <xs:attribute name="menuPlacement" type="xs:string" default="20">
      <xs:annotation>
        <xs:documentation>
          The value of the attribute determines the placement of the menu item in the menu. The menu is the one that opens when you click the menu icon in the right buttom corner of the views.
          Less is more. The lower the placement value the higher it will be placed in the menu.

          The default value for the placement is 20.

          Enable/disable
          If the value provided cannot be assigned to a number (integer) then the menu item will be removed from the menu. E.g. setting the value to "Off"
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="BaseContextMenuConfiguration">
    <xs:complexContent>
      <xs:extension base="BaseMenuItemConfigurationType">
        <xs:attribute name="enabled" type="MenuItemEnabledState" use="optional">
          <xs:annotation>
            <xs:documentation>
              Dictates whether or not the menu item is present in the menu on the page.
              **Important:** If the attribute dataMember is used, then data will decide if the menu item is present or not.
            </xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="title" type="xs:string" use="optional" >
          <xs:annotation>
            <xs:documentation>
              The title of the element in the menu.
            </xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="icon" type="xs:string" use="optional" >
          <xs:annotation>
            <xs:documentation>The Icon of the menu pointing to the imageId in the ImageConfigurationType</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="contextMenuPlacement" type="xs:string" default="20">
          <xs:annotation>
            <xs:documentation>
              The value of this attribute determines the placement of the menu item in the context menu. The context menu is the menu that opens when you long press/tap e.g. a order in the order list.
              Less is more. The lower the placement value the higher the menu item will be placed in the menu.

              The default value for the placement is 20.

              Enable/disable
              If the value provided cannot be assigned to a number (integer) then the menu item will be removed from the menu. E.g. setting the value to "Off"
            </xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="dataMember" type="xs:string" use="optional">
          <xs:annotation>
            <xs:documentation>
              Determines whether or not to show a menu item based on the presence of a specific data member/property, e.g. only include the "Show image" menu item if the dateMember of this item is set to "imageAvailable" and the order line has a data member/property called "imageAvailable".

              Whether to show the menu item or not is based solely on the presence of the data member, i.e. its value is _not_ interpreted!

              The 'dataMember' and 'enabled' settings are mutually exclusive and 'dataMember' takes precedence.
            </xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:simpleType name="MenuItemEnabledState">
    <xs:restriction base="xs:string">
      <!-- Keep the list sorted alphabetically -->
      <xs:enumeration value="false" >
        <xs:annotation>
          <xs:documentation>
            Removes the menu item from both menus.
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="OnEmptyListUtilizingDataMember" >
        <xs:annotation>
          <xs:documentation>
            Makes the menu item appear if no data is present, and the dataMember attribute is set.
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="true" >
        <xs:annotation>
          <xs:documentation>
            Makes the menu item appear in both menus.
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="FlagOrderConfigurationType">
    <xs:all>
      <xs:element name="setFlag" minOccurs="0" maxOccurs="1" type="FlagOrderContextMenuConfiguration" />
      <xs:element name="clearFlag" minOccurs="0" maxOccurs="1" type="FlagOrderContextMenuConfiguration" />
    </xs:all>
    <xs:attribute name="enabled" use="optional" default="true" />
  </xs:complexType>

  <xs:complexType name="FlagOrderContextMenuConfiguration">
    <xs:annotation>
      <xs:documentation>Optional element which is only explicitely needed when the flagging mechanism should prompt the user when setting and clearing the flag, or when default values for title and placement should be changed.</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="BaseContextMenuConfiguration">
        <xs:attribute name="workflowId" type="xs:string" use="optional" default="null">
          <xs:annotation>
            <xs:documentation>When this attribute is set, the set/clear flag actions will result in a registration collector being displayed to the user. Not enabled by default, i.e. the flag will simply be toggled on/off.</xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="FinishOrderMenuConfiguration">
    <xs:complexContent>
      <xs:extension base="BaseContextMenuConfiguration">
        <xs:attribute name="alwaysEnabled" type="xs:boolean">
          <xs:annotation>
            <xs:documentation>Setting this option to true, makes the finish button always enabled. Even if no registrations have been made.</xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="OrderLevelRegistrationMenuConfiguration">
    <xs:complexContent>
      <xs:extension base="BaseContextMenuConfiguration">
        <xs:sequence>
          <xs:element name="additionalRegistration" minOccurs="0" maxOccurs="unbounded" type="AdditionalOrderLevelType"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="AdditionalOrderLevelType">
    <xs:annotation>
      <xs:documentation>
        Additional order level registration which is send in when posting the order registrations, wrapped in an element named after the Id.
      </xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="BaseContextMenuConfiguration">
        <xs:attribute name="id" type="xs:string" use="required">
          <xs:annotation>
            <xs:documentation>
              The Id is used as the name of the Elemement containing the registrations when posting. It is also used when setting up a shortcut for the menu item.
            </xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="workflowId" type="xs:string" use="required">
          <xs:annotation>
            <xs:documentation>
              Reference to a workflow defined in the configuration file.
            </xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="ToggleShowPostedOrdersContextMenuConfiguration">
    <xs:annotation>
      <xs:documentation>Optional element for hiding and showing Posted orders.</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="BaseContextMenuConfiguration">
        <xs:attribute name="hiddenTitle" type="xs:string" use="optional" default="">
          <xs:annotation>
            <xs:documentation>The hidden title is used as the title when posted orders are hidden else the title is used.</xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="ToggleOrderLineGroupingMenuConfiguration">
    <xs:annotation>
      <xs:documentation>Optional element for splitting and grouping order lines. The title and icon are used when an order line is grouped.</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="BaseContextMenuConfiguration">
        <xs:attribute name="title" type="xs:string">
          <xs:annotation>
            <xs:documentation>The title displayed for splitting a grouped order line.</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="groupIcon" type="xs:string" use="optional" default="">
          <xs:annotation>
            <xs:documentation>The icon used when a grouped order line is split into it's parts.</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="groupTitle" type="xs:string" use="optional" default="">
          <xs:annotation>
            <xs:documentation>The title displayed when a grouped order line is split into its parts, and the user can group them again.</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="disableOnRegistration" type="xs:boolean" default="false">
          <xs:annotation>
            <xs:documentation>Disables toggling between grouped and individual order line, when a registration is made on any of the order lines in that specific group.</xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="OrderLinesPinnableValuesConfiguration">
    <xs:annotation>
      <xs:documentation>Values that will be added to the order lines list and applied to all following registrations.</xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="pinnableByAi">
        <xs:annotation>
          <xs:documentation>A value that is based on a specific AI.</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:complexContent>
            <xs:extension base="BasePinnableRegistrationValuesConfiguration">
              <xs:attribute name="eanAi" type="mstns:StepAttributeGs1Ai" use="required"/>
            </xs:extension>
          </xs:complexContent>
        </xs:complexType>
      </xs:element>
      <xs:element name="pinnableByFormat">
        <xs:annotation>
          <xs:documentation>A value that is based on a specific format.</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:complexContent>
            <xs:extension base="BasePinnableRegistrationValuesConfiguration">
              <xs:attribute name="format" type="xs:string" use="required">
                <xs:annotation>
                  <xs:documentation>Regular expression used to define the format of this value.</xs:documentation>
                </xs:annotation>
              </xs:attribute>
            </xs:extension>
          </xs:complexContent>
        </xs:complexType>
      </xs:element>
    </xs:choice>
  </xs:complexType>

  <xs:complexType name="BasePinnableRegistrationValuesConfiguration">
    <xs:attribute name="displayLabel" type="xs:string" use="optional">
      <xs:annotation>
        <xs:documentation>Optional value prefixing when the pinnable value is shown.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="icon" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="NavigationContextMenuConfiguration">
    <xs:complexContent>
      <xs:extension base="BaseContextMenuConfiguration">
        <xs:attribute name="navigateTo" type="xs:string" use="required">
          <xs:annotation>
            <xs:documentation>
              The id of the page that shows the registrations performed on this page.
              The page must exist in the pages section.
            </xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:simpleType name="ScanToSelectBehaviourType">
    <xs:restriction base="xs:string">
      <!-- Keep the list sorted alphabetically -->
      <xs:enumeration value="Auto" >
        <xs:annotation>
          <xs:documentation>
            If there are more than one orderline matching the scan the MobileWMSWms will automatically select best matched orderline.
            The criterias are:
            Incomplete registrations with the ItemBarCode/ItemNumber, SerialNumber, Lot.
            Complete registrations with the ItemBarCode/ItemNumber, SerialNumber, Lot.

            It will select the first orderline it finds in the search-order listed above.

            The GS1SearchTerm can alter the matching of orderlines for GS1.
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="User" >
        <xs:annotation>
          <xs:documentation>
            If there are more than one orderline matching the scan:
            The user will be prompted to select the order line in a list.
            All matching orderlines where the scanned value can be found in the ItemBarCode/ItemNumber, SerialNumber and Lot.

            If the GS1SearchTerm is set to All then only order lines where all values in the barcode match will be presented in the list.
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <!-- Registrations-->
  <xs:complexType name="RegistrationsConfigurationType">
    <xs:all>
      <xs:element name="list" type="ListType" minOccurs="1" />
      <xs:element name="deleteRegistration" minOccurs="0" maxOccurs="1" type="BaseContextMenuConfiguration">
        <xs:annotation>
          <xs:documentation>
            The menu item for deleting a single registration.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="deleteAllRegistrations" minOccurs="0" maxOccurs="1" type="BaseContextMenuConfiguration">
        <xs:annotation>
          <xs:documentation>The menu item for deleting all registrations</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:all>
  </xs:complexType>

  <!-- PendingRequests-->
  <xs:complexType name="PendingRegistrationsConfigurationType">
    <xs:annotation>
      <xs:documentation>If there are any pending registrations the first screen that the user will see in the unplanned scenario is the Pending Registration view.</xs:documentation>
    </xs:annotation>
    <xs:all>
      <xs:element name="viewErrorMessage" minOccurs="0" maxOccurs="1" type="BaseContextMenuConfiguration">
        <xs:annotation>
          <xs:documentation>
            The menu item for viewing error messages for a pending registration.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="deleteRegistration" minOccurs="0" maxOccurs="1" type="BaseContextMenuConfiguration">
        <xs:annotation>
          <xs:documentation>The delete registrations configures the menu item for "Delete registration"</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="resubmitRegistration" minOccurs="0" maxOccurs="1" type="BaseContextMenuConfiguration">
        <xs:annotation>
          <xs:documentation>The resubmit registration configures the menu item for "Resubmit registration"</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="postAllRegistrations" minOccurs="0" maxOccurs="1" type="BaseContextMenuConfiguration">
        <xs:annotation>
          <xs:documentation>Enables a menu item allowing the user to post all registrations. Each registration is sent in a separate posting request.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="list" type="ListType" minOccurs="1" />
      <xs:element name="onSuccessfulPost" minOccurs="0" maxOccurs="1" type="OnSuccessfulPostType" />
    </xs:all>
    <xs:attribute name="allRegistrationTypes" use="optional" type="xs:boolean">
      <xs:annotation>
        <xs:documentation>
          If true, then the page will show all pending registrations regardless of the registration type. Especially useful in offline scenario to see all the registrations that has been made.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- Settings-->
  <xs:complexType name="SettingsConfigurationType">
  </xs:complexType>

  <!-- Unplanned Item Registration -->
  <xs:complexType name="UnplannedItemRegistrationConfigurationType">
    <xs:all>
      <xs:element name="header" minOccurs="0" maxOccurs="1" type="ConfigurableHeaderConfigurationType"/>
      <xs:element name="onSuccessfulPost" minOccurs="0" maxOccurs="1" type="OnSuccessfulPostType" />
      <xs:element name="requests" minOccurs="0" maxOccurs="1">
        <xs:complexType>
          <xs:all>
            <xs:element name="getRegistrationConfiguration" minOccurs="0" maxOccurs="1" type="xs:string" >
              <xs:annotation>
                <xs:documentation>The name of the document type to use when fetching the Registration Configuration. The default document type is GetRegistrationConfiguration</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="submit" minOccurs="0" maxOccurs="1" type="xs:string" >
              <xs:annotation>
                <xs:documentation>The name of the document type to use when posting from an unplanned item registration page. The default document type is PostAdhocRegistration</xs:documentation>
              </xs:annotation>
            </xs:element>
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="offlineRegistrationService" minOccurs="0" maxOccurs="1" type="OfflineRegistrationServiceConfigurationType"/>
      <xs:element name="search" minOccurs="0" maxOccurs="1" type="SearchNavigationType" >
        <xs:annotation>
          <xs:documentation>Search configuration used by the search icon in the header</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="postAllRegistrations" minOccurs="0" maxOccurs="1" type="BaseContextMenuConfiguration">
        <xs:annotation>
          <xs:documentation>Enables a menu item allowing the user to post all registrations. Each registration is sent in a separate posting request.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:all>
    <xs:attribute name="type" type="xs:string" use="required" />
    <xs:attribute name="useRegistrationCollector" type="UseRegistrationCollectorType" use="optional" default="true"/>
    <xs:attribute name="includeInputDataRowInSubmitRequest" type="xs:boolean" use="optional" default="false">
      <xs:annotation>
        <xs:documentation>Define if the input values from the previous page should be included in the submit. Default is false.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:simpleType name="UseRegistrationCollectorType">
    <xs:annotation>
      <xs:documentation>
        Possible values for the Use Registration Collector.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="true">
        <xs:annotation>
          <xs:documentation>A registration collector is used. This is required for the application to be able to fetch the configuration for the registration collector either online or locally</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="false">
        <xs:annotation>
          <xs:documentation>A registration collector will not be used.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="auto">
        <xs:annotation>
          <xs:documentation>If a registration collector configuration is returned in the post call then the registration collector will be displayed.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <!-- LOOKUP -->
  <xs:complexType name="LookupConfigurationType">
    <xs:all>
      <xs:element name="header" minOccurs="0" maxOccurs="1" type="LookupHeaderConfigurationType"/>
      <xs:element name="onSuccessfulPost" minOccurs="0" maxOccurs="1" type="OnSuccessfulPostType" />
      <xs:element name="requests" minOccurs="0" maxOccurs="1">
        <xs:complexType>
          <xs:all>
            <xs:element name="lookup" minOccurs="0" maxOccurs="1" type="xs:string" />
            <xs:element name="submit" minOccurs="0" maxOccurs="1" type="xs:string" />
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="list" type="ListType" />
      <xs:element name="search" minOccurs="0" maxOccurs="1" type="SearchNavigationType" />
      <xs:element name="onResultSelected" minOccurs="0" maxOccurs="1" type="OnResultSelectedType"/>
    </xs:all>
    <xs:attribute name="type" type="xs:string" use="required" />
    <xs:attribute name="includeInputDataRowInSubmitRequest" type="xs:boolean" use="optional" default="false">
      <xs:annotation>
        <xs:documentation>Define if the input values from the previous page should be included in the submit. Default is false.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="useRegistrationCollector" type="UseRegistrationCollectorType" use="optional" default="false">
      <xs:annotation>
        <xs:documentation>Define if the registration collector should be displayed on the page. Default is false.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="selectionAI" type="xs:string" use="optional" default="01,02,91">
      <xs:annotation>
        <xs:documentation>The Application Identifier for selecting the lookup result</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="BaseConfigurableHeaderConfigurationType" abstract="true">
    <xs:attribute name="automaticAcceptAfterLastScan" type="xs:boolean" use="optional" default="true">
      <xs:annotation>
        <xs:documentation>Accept the header when a scan causes the last mandatory field to be filled out.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="automaticAcceptOnOpen" type="xs:boolean" use="optional" default="true">
      <xs:annotation>
        <xs:documentation>Define if values in the header should be accepted on page open. Property was renamed from automaticAcceptOnStartup or updateOnActivate on Windows versions. Only make use of this configuration option when the RefreshOnResume data transfer option does not get the job done.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="configurationKey"  type="xs:string">
      <xs:annotation>
        <xs:documentation>The key, referencing a header configuration in either reference data or application.cfg.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- Configurable header configuration -->
  <xs:complexType name="ConfigurableHeaderConfigurationType" >
    <xs:complexContent>
      <xs:extension base="BaseConfigurableHeaderConfigurationType">
        <xs:attribute name="clearAfterPost" type="xs:boolean" use="optional" default="false">
          <xs:annotation>
            <xs:documentation>Clears any header fields if their clearOnClear attribute is set to true.</xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="LookupHeaderConfigurationType" >
    <xs:complexContent>
      <xs:extension base="ConfigurableHeaderConfigurationType">
        <xs:attribute name="hideAfterAccept" type="xs:boolean" use="optional" default="false">
          <xs:annotation>
            <xs:documentation>If true, hide the header after accept</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="automaticAccept" type="AutomaticAcceptType" use="optional">
          <xs:annotation>
            <xs:documentation>Enables the header to accept header values if all mandatory fields are filled out. Replaces automaticAcceptOnOpen, which is deprecated.</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="automaticAcceptOnOpen" type="xs:boolean" use="optional" default="true">
          <xs:annotation>
            <xs:documentation>
              DEPRECATED: Use automaticAccept instead.
              Define if values in the header should be accepted on page open. Property was renamed from automaticAcceptOnStartup or updateOnActivate on Windows versions.
            </xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:simpleType name="AutomaticAcceptType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Always" >
        <xs:annotation>
          <xs:documentation>
            Always accept the header, causing a data refresh every time the page is entered, whether opened from a page or returned to by closing another page.
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="OnOpen" >
        <xs:annotation>
          <xs:documentation>
            Automatically accept the header when the page is opened. This replaces the attribute AutomaticAcceptOnOpen.
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Never" >
        <xs:annotation>
          <xs:documentation>
            Never automatically accept the header.
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="OnSuccessfulPostType">
    <xs:annotation>
      <xs:documentation>The action to do after the Post method returns successful. This was formerly known as PostAction.</xs:documentation>
    </xs:annotation>
    <xs:attribute name="close" type="xs:boolean" use="optional" default="false" >
      <xs:annotation>
        <xs:documentation>This will close the page after successful post. This will take presedence over the other attributes</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="navigateTo" type="xs:string" use="optional" >
      <xs:annotation>
        <xs:documentation>This will navigate to a page id defined in the spine.cfg on successful post</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="refreshOnSuccess" type="xs:boolean" use="optional" default="false">
      <xs:annotation>
        <xs:documentation>
          Define if the page should refresh after a successful adhoc request. Generally it is similar to tapping the accept button on the filter or the update button in the menu.
          On order and order lines pages the list will refresh.
          On UnplannedItemRegistration and Lookup pages the filter will be applied again.

          If the close or navigateTo action has been setup the refreshOnSuccess will not be run.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="ignoreSuccessMessage" type="xs:boolean" use="optional" default="false">
      <xs:annotation>
        <xs:documentation>Allows 'posted succesfully' messages to be suppressed, i.e. the user will only be prompted if interaction is needed or errors occur during 'post all'. Defaults to false.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="OnResultSelectedType">
    <xs:complexContent>
      <xs:extension base="OnSuccessfulPostType">
        <xs:attribute name="enabled" type="xs:boolean" use="optional" default="false" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="OfflineRegistrationServiceConfigurationType" >
    <xs:annotation>
      <xs:documentation>The offline registration service will store the information in the database and can then be sent later.</xs:documentation>
    </xs:annotation>
    <xs:all>
      <xs:element name="viewRegistrations" type="NavigationContextMenuConfiguration" minOccurs="0" maxOccurs="1">
        <xs:annotation>
          <xs:documentation>The menu item for Viewing registrations</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="displayLineConfiguration" type="ListType" minOccurs="0" maxOccurs="1">
        <xs:annotation>
          <xs:documentation>The list configuration to use when displaying the line</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:all>
    <xs:attribute name="enabled" type="xs:boolean" use="optional" default="false" >
      <xs:annotation>
        <xs:documentation>If true, the offline registration service is enabled</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="workflowId" type="xs:string" use="optional" default="standard" >
      <xs:annotation>
        <xs:documentation>
          The workflow that will be used along with this service. The workflowid points to a workflow that must be defined in the resources section in the application file.
          The default is set to standard but can be changed to match the customers need for a workflow.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- Search -->
  <xs:complexType name="SearchConfigurationType">
    <xs:all>
      <xs:element name="header" minOccurs="0" maxOccurs="1">
        <xs:complexType>
          <xs:attribute name="automaticAcceptOnOpen" type="xs:boolean" use="optional" default="true">
            <xs:annotation>
              <xs:documentation>
                Define if values in the header should be accepted on page open. Property was renamed from updateOnActivate on older versions.
              </xs:documentation>
            </xs:annotation>
          </xs:attribute>
        </xs:complexType>
      </xs:element>
      <xs:element name="requests" minOccurs="0" maxOccurs="1">
        <xs:complexType>
          <xs:all>
            <xs:element name="search" minOccurs="0" maxOccurs="1" type="xs:string" default="Search" />
          </xs:all>
        </xs:complexType>
      </xs:element>
      <xs:element name="onResultSelected" type="OnResultSelectedType" />
      <xs:element name="list" type="ListType" />
    </xs:all>
  </xs:complexType>

  <xs:complexType name="SearchNavigationType">
    <xs:attribute name="navigateTo" type="xs:string" use="optional" default="Search" />
  </xs:complexType>

  <!-- Offline Management-->
  <xs:complexType name="OfflineManagementConfigurationType">
    <xs:sequence>
      <xs:element name="offlineServices" minOccurs="1" maxOccurs="1">
        <xs:annotation>
          <xs:documentation>Offline services that will appear in the list on the page.</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:choice minOccurs="1" maxOccurs="unbounded">
            <xs:element name="offlineService" minOccurs="0" maxOccurs="unbounded" type="OfflineManagementOrderServiceConfigurationType" />
            <xs:element name="adhocRegistrationService" minOccurs="0" maxOccurs="1" type="OfflineManagementAdhocRegistrationServiceConfigurationType" />
          </xs:choice>
        </xs:complexType>
      </xs:element>

      <!-- DEPRECATED: use navigateToButton instead -->
      <xs:element name="navigationButton" minOccurs="0" maxOccurs="1" type="NavigationContextMenuConfiguration">
        <xs:annotation >
          <xs:documentation>
            DEPRECATED: Use navigateToButton instead.

            If enabled, this option will appear in the menu to ease navigating to a define page. This would often be the MainMenu where the user can carry out work from.

            The default text for the menu item is 'Continue'
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <!-- Button used as "continue" added in SPN-2604 -->
      <xs:element name="navigateToButton" minOccurs="0" maxOccurs="1" type="NavigationContextMenuConfiguration">
        <xs:annotation>
          <xs:documentation>
            If enabled, this option will appear in the menu to ease navigating to a define page. This would often be the MainMenu where the user can carry out work from.

            The default text for the menu item is 'Continue'
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="postAll" minOccurs="0" maxOccurs="1" type="BaseContextMenuConfiguration">
        <xs:annotation>
          <xs:documentation>
            If enabled, the post all option will appear in the menu. The default text for the menu item is 'Upload all'
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="refresh" minOccurs="0" maxOccurs="1" type="BaseContextMenuConfiguration">
        <xs:annotation>
          <xs:documentation>
            Menu item for refresh in the menu.

            Default for the title is @{ListUpdateMenuItem}
          </xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="updateMode" type="OfflineUpdateModeType" use="optional" default="Always">
      <xs:annotation>
        <xs:documentation>
          The updateMode defines when the offline order services update their content.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="OfflineManagementServiceConfigurationType">
    <xs:sequence>
      <xs:element name="list" type="ListType" minOccurs="1" maxOccurs="1" >
        <xs:annotation>
          <xs:documentation>The list configuration for the offline service. This defines the appearance of the offline service in the list</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="onItemSelected" minOccurs="0" maxOccurs="1" type="OnItemSelectedType">
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="OfflineManagementAdhocRegistrationServiceConfigurationType">
    <xs:complexContent >
      <xs:extension base="OfflineManagementServiceConfigurationType">
        <xs:sequence>
          <xs:element name="requests" minOccurs="0" maxOccurs="1">
            <xs:complexType>
              <xs:all>
                <xs:element name="submit" minOccurs="0" maxOccurs="1" type="xs:string" >
                  <xs:annotation>
                    <xs:documentation>
                      The document name used when submitting the adhoc registrations. Default name is PostAdhocRegistration
                    </xs:documentation>
                  </xs:annotation>
                </xs:element>
              </xs:all>
            </xs:complexType>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="OfflineManagementOrderServiceConfigurationType">
    <xs:complexContent >
      <xs:extension base="OfflineManagementServiceConfigurationType">
        <xs:attribute name="serviceId" type="xs:string" use="required" >
          <xs:annotation>
            <xs:documentation>
              Id of the service to add to the list. Eg. a "Receive" for the receive service. Use "AdhocRegistrationService" for adhoc registrations.
              The service must be a service set in Offline operation mode
            </xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:simpleType name="OfflineUpdateModeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Always" >
        <xs:annotation>
          <xs:documentation>
            The services will call their update methods when entering the page, unless there are unposted registrations.
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="OnNoOrders">
        <xs:annotation>
          <xs:documentation>
            Update the services when entering the page, unless there are unposted registrations.
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Manual">
        <xs:annotation>
          <xs:documentation>
            Update the services only when the user manually initiates the update, unless there are unposted registrations.
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="OnItemSelectedType" >
    <xs:attribute name="navigateTo" type="xs:string" use="required" />
  </xs:complexType>


  <!-- Workflows -->
  <xs:complexType name="WorkflowsConfigurationType">
    <xs:sequence>
      <xs:element name="workflow" minOccurs="0" maxOccurs="unbounded" type="WorkflowConfigurationType" />
    </xs:sequence>
  </xs:complexType>

  <!-- Workflow -->
  <xs:complexType name="WorkflowConfigurationType">
    <xs:all minOccurs="1" maxOccurs="1">
      <xs:element name="configuration" minOccurs="1" maxOccurs="1" type="RegistrationCollectorConfigurationType" />
    </xs:all>
    <xs:attribute name="id" use="required" type="xs:string" />
    <xs:attribute name="itemNumberAI" use="optional" type="xs:string" />
    <xs:attribute name="toteDisplayNameGs1Ai" use="optional" type="xs:string">
      <xs:annotation>
        <xs:documentation>Application identifier for getting the tote display name from a Gs1 barcode.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- ===================================================================
       Base input related configuration BEGIN
       =================================================================== -->

  <xs:simpleType name="BaseInputAttributeInputType">
    <xs:restriction base="InputTypeConfigurationType">
      <xs:annotation>
        <xs:documentation>The input type defining the expected input for the field.</xs:documentation>
      </xs:annotation>
    </xs:restriction>
  </xs:simpleType>

  <!-- ===================================================================
       Base input related configuration END
       =================================================================== -->

  <!-- ===================================================================
       WORKFLOW related configuration BEGIN
       =================================================================== -->

  <!-- Individual step attributes – mandatory ones -->
  <xs:simpleType name="StepAttributeId">
    <xs:restriction base="xs:unsignedInt">
      <xs:annotation>
        <xs:documentation>
          An integer value representing a unique step identifier. Typical values are '10', '20', '30' etc to allow easy addition of new steps at a later point.
          It is important to note, that steps occur in order sorted by this value.
        </xs:documentation>
      </xs:annotation>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="StepAttributeName">
    <xs:restriction base="xs:string">
      <xs:annotation>
        <xs:documentation>The name of the step to add, used to map the input and the entered value.</xs:documentation>
      </xs:annotation>
      <!-- A step _has_ to have a name -->
      <xs:minLength value="1" />
    </xs:restriction>
  </xs:simpleType>

  <!-- Individual step attributes – optional ones (all step types) -->
  <xs:simpleType name="StepAttributeAutoForwardAfterScan">
    <xs:restriction base="xs:boolean">
      <xs:annotation>
        <xs:documentation>Determines whether a scan will make the step continue to the next. Default value is true.</xs:documentation>
      </xs:annotation>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="StepAttributeHeader">
    <xs:restriction base="xs:string">
      <xs:annotation>
        <xs:documentation>A header/title text to display above the step. Optimally this is descriptive enough to instruct the user which value to collect without having to read the (optional) help text</xs:documentation>
      </xs:annotation>
      <!-- If including the header, then do a decent job -->
      <xs:minLength value="3" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="StepAttributeVisible">
    <xs:restriction base="xs:boolean">
      <xs:annotation>
        <xs:documentation>If visible is set to false, then the registration step will not be visible, however, the value will be added to the registration. Default value is true.</xs:documentation>
      </xs:annotation>
    </xs:restriction>
  </xs:simpleType>

  <!-- Individual step attributes – optional ones (limited applicability) -->
  <xs:simpleType name="StepAttributeDataDisplayColumn">
    <xs:restriction base="xs:string">
      <xs:annotation>
        <xs:documentation></xs:documentation>
      </xs:annotation>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="StepAttributeDataKeyColumn">
    <xs:restriction base="xs:string">
      <xs:annotation>
        <xs:documentation></xs:documentation>
      </xs:annotation>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="StepAttributeDataTable">
    <xs:restriction base="xs:string">
      <xs:annotation>
        <xs:documentation></xs:documentation>
      </xs:annotation>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="StepAttributeGs1Ai">
    <xs:restriction base="xs:string">
      <xs:annotation>
        <xs:documentation>Comma separated string with application identifiers.</xs:documentation>
      </xs:annotation>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="StepAttributeHelpLabel">
    <xs:restriction base="xs:string">
      <xs:annotation>
        <xs:documentation>Guiding text displayed next to the step.</xs:documentation>
      </xs:annotation>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="StepAttributeLabel">
    <xs:restriction base="xs:string">
      <xs:annotation>
        <xs:documentation></xs:documentation>
      </xs:annotation>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="StepAttributeLength">
    <xs:restriction base="xs:nonNegativeInteger">
      <xs:annotation>
        <xs:documentation>Length expresses the number of characters/digits that an input can maximum have.</xs:documentation>
      </xs:annotation>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="StepAttributeListSeparator">
    <xs:restriction base="xs:string">
      <xs:annotation>
        <xs:documentation>Character or string used as separator character between list values. Default value is ';'.</xs:documentation>
      </xs:annotation>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="StepAttributeListValues">
    <xs:restriction base="xs:string">
      <xs:annotation>
        <xs:documentation>String containing values used to populate the list of accepted values. Separated by the list separator.</xs:documentation>
      </xs:annotation>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="StepAttributeDate">
    <xs:restriction base="xs:string">
      <xs:annotation>
        <xs:documentation>String representing a date in the format 'dd-MM-yyyy'.</xs:documentation>
      </xs:annotation>
      <xs:pattern value="[0-9]{2}-[0-9]{2}-[0-9]{4}" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="StepAttributeOptional">
    <xs:restriction base="xs:boolean">
      <xs:annotation>
        <xs:documentation>
          When 'true' the step can have an empty value.
          When 'false' the step must have a value before the user is able to proceed.
        </xs:documentation>
      </xs:annotation>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="StepAttributePerformCalculation">
    <xs:restriction base="xs:boolean">
      <xs:annotation>
        <xs:documentation>When enabled a step will perform calculus operations when detecting mathematical symbols. Default value is 'true'.</xs:documentation>
      </xs:annotation>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="StepAttributeValidationCaseSensitive">
    <xs:restriction base="xs:boolean">
      <xs:annotation>
        <xs:documentation>Set to 'true' to enable case sensitive validation. Default value is 'false'.</xs:documentation>
      </xs:annotation>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="StepAttributeValidationValues">
    <xs:restriction base="xs:string">
      <xs:annotation>
        <xs:documentation>If set, only the values defined are accepted. Separated by the list separator. E.g. 3661103036043;7610400074520</xs:documentation>
      </xs:annotation>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="StepAttributeInputFormat">
    <xs:restriction base="xs:string">
      <xs:annotation>
        <xs:documentation>Use Regular expressions on the input to follow a specific pattern, e.g. prevent the user from typing certain characters.</xs:documentation>
      </xs:annotation>
    </xs:restriction>
  </xs:simpleType>

  <xs:attributeGroup name="StepAttributesAllCommon">
    <xs:attribute name="id" type="mstns:StepAttributeId" use="required"/>
    <xs:attribute name="name" type="mstns:StepAttributeName" use="required" />
    <xs:attribute name="autoForwardAfterScan" type="mstns:StepAttributeAutoForwardAfterScan" use="optional" />
    <xs:attribute name="header" type="mstns:StepAttributeHeader" use="required" />
  </xs:attributeGroup>

  <xs:attributeGroup name="StepAttributesAllCommonVisible">
    <xs:attributeGroup ref="mstns:StepAttributesAllCommon" />
    <xs:attribute name="visible" type="mstns:StepAttributeVisible" use="optional" />
  </xs:attributeGroup>

  <xs:attributeGroup name="StepAttributesTextCommon">
    <xs:attribute name="length" type="mstns:StepAttributeLength" use="optional" />
    <xs:attribute name="listSeparator" type="mstns:StepAttributeListSeparator" />
    <xs:attribute name="optional" type="mstns:StepAttributeOptional" use="optional" default="false" />
    <xs:attribute name="performCalculation" type="mstns:StepAttributePerformCalculation" use="optional" default="false" />
    <xs:attribute name="primaryInputMethod" type="mstns:PrimaryInputMethodType" use="optional" default="Scan"/>
    <xs:attribute name="validationCaseSensitive" type="mstns:StepAttributeValidationCaseSensitive" use="optional" default="false" />
    <xs:attribute name="validationValues" type="mstns:StepAttributeValidationValues" use="optional" />
    <xs:attribute name="visible" type="mstns:StepAttributeVisible" use="optional" default="true"/>
  </xs:attributeGroup>

  <!-- Steps - standard workflow - attribute aggregations -->
  <xs:complexType name="BaseStepElement" >
    <xs:sequence>
      <xs:element name="onlineValidation" type="OnlineOnlyValidationType" minOccurs="0" maxOccurs="1"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="StepFromBin">
    <xs:complexContent>
      <xs:annotation>
        <xs:documentation>
          Adds a 'from bin' step to the workflow.
          Contains default values that match those of the 'standard workflow' but all can be changed to allow the step to be used in any workflow.
        </xs:documentation>
      </xs:annotation>
      <xs:extension base="BaseStepElement">
        <xs:attribute name="id" type="mstns:StepAttributeId" default="10" />
        <xs:attribute name="name" type="mstns:StepAttributeName" default="FromBin" />
        <xs:attribute name="autoForwardAfterScan" type="mstns:StepAttributeAutoForwardAfterScan" default="true" />
        <xs:attribute name="header" type="mstns:StepAttributeHeader" default="@{RegistrationCollectorFromBinHeader}" />
        <xs:attribute name="helpLabel" type="mstns:StepAttributeHelpLabel" default="@{RegistrationCollectorFromBinHelpLabel}" />
        <xs:attribute name="label" type="mstns:StepAttributeLabel" default="'{FromBin}'" />
        <xs:attribute name="defaultValue" type="xs:string" default="{FromBin}">
          <xs:annotation>
            <xs:documentation>In a standard setup, the 'from bin' value will be pre-populated with the 'FromBin' value of the selected order line.</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="eanAi" type="mstns:StepAttributeGs1Ai" use="optional" default="00"/>
