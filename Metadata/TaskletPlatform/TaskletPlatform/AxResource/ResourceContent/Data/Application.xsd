        <xs:attribute name="id" type="mstns:StepAttributeId" default="35" />
        <xs:attribute name="name" type="mstns:StepAttributeName" default="ToteId" />
        <xs:attribute name="autoForwardAfterScan" type="mstns:StepAttributeAutoForwardAfterScan" />
        <xs:attribute name="header" type="mstns:StepAttributeHeader" default="@{RegistrationCollectorToteHeader}"/>
        <xs:attribute name="helpLabel" type="mstns:StepAttributeHelpLabel" default="@{RegistrationCollectorToteHelpLabel}" />
        <xs:attribute name="label" type="mstns:StepAttributeLabel" use="optional" />
        <xs:attribute name="defaultValue" type="xs:string" use="optional" />
        <xs:attribute name="eanAi" type="mstns:StepAttributeGs1Ai" use="optional" default="98"/>
        <xs:attributeGroup ref="mstns:StepAttributesTextCommon" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="StepSerialNumber">
    <xs:complexContent>
      <xs:annotation>
        <xs:documentation>
          Adds a 'serial number' step to the workflow.
          Contains default values that match those of the 'standard workflow' but all can be changed to allow the step to be used in any workflow.
        </xs:documentation>
      </xs:annotation>
      <xs:extension base="BaseStepElement">
        <xs:attribute name="id" type="mstns:StepAttributeId" default="40" />
        <xs:attribute name="name" type="mstns:StepAttributeName" default="SerialNumber" />
        <xs:attribute name="autoForwardAfterScan" type="mstns:StepAttributeAutoForwardAfterScan" />
        <xs:attribute name="header" type="mstns:StepAttributeHeader" default="@{RegistrationCollectorSerialNumberHeader}"/>
        <xs:attribute name="helpLabel" type="mstns:StepAttributeHelpLabel" default="@{RegistrationCollectorSerialNumberHelpLabel}" />
        <xs:attribute name="label" type="mstns:StepAttributeLabel" default="'{SerialNumber}'" />
        <xs:attribute name="defaultValue" type="xs:string" default="{SerialNumber}">
          <xs:annotation>
            <xs:documentation>In a standard setup, the 'serial number' value will be pre-populated with the 'SerialNumber' value of the selected order line.</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="eanAi" type="mstns:StepAttributeGs1Ai" use="optional" default="21"/>
        <xs:attribute name="validationWarningType" type="ValidationWarningType" use="optional">
          <xs:annotation>
            <xs:documentation>
              Determines the validation behaviour when errors occur.
            </xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="splitBarcodeBySeparator" type="xs:string" use="optional" default="">
          <xs:annotation>
            <xs:documentation>
              Provide this separator character to support barcodes that contains multiple values separated by a character.

              If the barcode contains several serial numbers then all the serial numbers will be split and registered as single registrations.
              E.g. 1232414-123;535235235-213;523452345-54 will result in three registrations.

              If no separator character is provided then the barcode will be treated as one barcode.

              NB. This is only eligable for non-Gs1 barcodes.
            </xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attributeGroup ref="mstns:StepAttributesTextCommon" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="StepQuantity">
    <xs:complexContent>
      <xs:annotation>
        <xs:documentation>
          Adds a 'quantity' step to the workflow of type decimal.
          Contains default values that match those of the 'standard workflow' but all can be changed to allow the step to be used in any workflow.
        </xs:documentation>
      </xs:annotation>
      <xs:extension base="BaseStepElement">
        <xs:attribute name="id" type="mstns:StepAttributeId" default="50" />
        <xs:attribute name="name" type="mstns:StepAttributeName" default="Quantity" />
        <xs:attribute name="autoForwardAfterScan" type="mstns:StepAttributeAutoForwardAfterScan" />
        <xs:attribute name="defaultValue" type="xs:string">
          <xs:annotation>
            <xs:documentation>Sets a default value for the step. This is overridden if suggestQuantity is enabled on the order lines page.</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="header" type="mstns:StepAttributeHeader" default="@{RegistrationCollectorQuantityHeader}"/>
        <xs:attribute name="helpLabel" type="mstns:StepAttributeHelpLabel" default="@{RegistrationCollectorQuantityHelpLabel}" />
        <xs:attribute name="label" type="mstns:StepAttributeLabel" use="optional" />
        <xs:attribute name="length" type="mstns:StepAttributeLength" use="optional"/>
        <xs:attribute name="performCalculation" type="mstns:StepAttributePerformCalculation" use="optional" default="false" />
        <xs:attribute name="visible" type="mstns:StepAttributeVisible" use="optional" />
        <xs:attribute name="eanAi" type="mstns:StepAttributeGs1Ai" use="optional" default="310,30,37"/>
        <xs:attribute name="minValue" type="xs:decimal" />
        <xs:attribute name="maxValue" type="xs:decimal" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="StepQuantityByScan">
    <xs:complexContent>
      <xs:annotation>
        <xs:documentation>
          Adds a 'quantity by scan' step to the workflow.
          Contains default values that match those of the 'standard workflow' but all can be changed to allow the step to be used in any workflow.
        </xs:documentation>
      </xs:annotation>
      <xs:extension base="BaseStepElement">
        <xs:attribute name="id" type="mstns:StepAttributeId" default="51" />
        <xs:attribute name="name" type="mstns:StepAttributeName" default="Quantity" />
        <xs:attribute name="autoForwardAfterScan" type="mstns:StepAttributeAutoForwardAfterScan" />
        <xs:attribute name="header" type="mstns:StepAttributeHeader" default="@{RegistrationCollectorQuantityByScanHeader}" />
        <xs:attribute name="helpLabel" type="mstns:StepAttributeHelpLabel" default="@{RegistrationCollectorQuantityByScanHelpLabel}" />
        <xs:attribute name="label" type="mstns:StepAttributeLabel" use="optional" />
        <xs:attribute name="visible" type="mstns:StepAttributeVisible" />
        <xs:attribute name="dataKeyColumn" type="mstns:StepAttributeDataKeyColumn" />
        <xs:attribute name="dataTable" type="mstns:StepAttributeDataTable" />
        <xs:attribute name="eanAi" type="mstns:StepAttributeGs1Ai" use="optional" />
        <xs:attribute name="listSeparator" type="mstns:StepAttributeListSeparator" default=";" />
        <xs:attribute name="listValues" type="mstns:StepAttributeListValues" />
        <xs:attribute name="overDeliveryValidation" type="mstns:ValidationWarningType" />
        <xs:attribute name="minValue" type="xs:decimal" default="0.0000000001" />
        <xs:attribute name="maxValue" type="xs:decimal" />
        <xs:attribute name="validationValues" type="mstns:StepAttributeValidationValues" />
        <xs:attribute name="primaryInputMethod" type="mstns:PrimaryInputMethodType"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!-- Steps - the various input types - attribute aggregations -->
  <xs:complexType name="StepDate">
    <xs:complexContent>
      <xs:annotation>
        <xs:documentation>Adds a date step into the workflow. The collected value is the date alone without a time-of-day component.</xs:documentation>
      </xs:annotation>
      <xs:extension base="BaseStepElement">
        <xs:attributeGroup ref="mstns:StepAttributesAllCommonVisible" />
        <xs:attribute name="defaultValue" type="mstns:StepAttributeDate" />
        <xs:attribute name="eanAi" type="mstns:StepAttributeGs1Ai" use="optional" />
        <xs:attribute name="format" type="xs:string" use="optional" />
        <xs:attribute name="helpLabel" type="mstns:StepAttributeHelpLabel" use="optional" />
        <xs:attribute name="label" type="mstns:StepAttributeLabel" use="optional" />
        <xs:attribute name="maxDate" type="mstns:StepAttributeDate" use="optional" />
        <xs:attribute name="minDate" type="mstns:StepAttributeDate" use="optional" />
        <xs:attribute name="optional" type="mstns:StepAttributeOptional" use="optional" default="false" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="StepDateTime">
    <xs:annotation>
      <xs:documentation>Adds a datetime step to the workflow. The collected value includes both a date and time component and should be preferred over a regular date step when the time-of-day is of importance.</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="mstns:StepDate" />
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="StepDecimal">
    <xs:complexContent>
      <xs:annotation>
        <xs:documentation>Adds a decimal step to the workflow. Typically used when registering (measured) quantities.</xs:documentation>
      </xs:annotation>
      <xs:extension base="BaseStepElement">
        <xs:attributeGroup ref="mstns:StepAttributesAllCommonVisible" />
        <xs:attribute name="defaultValue" type="xs:decimal" use="optional" />
        <xs:attribute name="eanAi" type="mstns:StepAttributeGs1Ai" />
        <xs:attribute name="helpLabel" type="mstns:StepAttributeHelpLabel" use="optional" />
        <xs:attribute name="label" type="mstns:StepAttributeLabel" use="optional" />
        <xs:attribute name="length" type="mstns:StepAttributeLength" use="optional" />
        <xs:attribute name="minValue" type="xs:decimal" default="0" use="optional" />
        <xs:attribute name="maxValue" type="xs:decimal" use="optional" />
        <xs:attribute name="optional" type="mstns:StepAttributeOptional" use="optional" default="false" />
        <xs:attribute name="performCalculation" type="mstns:StepAttributePerformCalculation" use="optional" default="false" />
        <xs:attribute name="primaryInputMethod" type="mstns:PrimaryInputMethodType"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="StepInteger">
    <xs:complexContent>
      <xs:annotation>
        <xs:documentation>Adds an integer step to the workflow. Typically used when registering quantities where decimals are not allowed.</xs:documentation>
      </xs:annotation>
      <xs:extension base="BaseStepElement">
        <xs:attributeGroup ref="mstns:StepAttributesAllCommonVisible" />
        <xs:attribute name="defaultValue" type="xs:integer" use="optional" />
        <xs:attribute name="eanAi" type="mstns:StepAttributeGs1Ai" />
        <xs:attribute name="helpLabel" type="mstns:StepAttributeHelpLabel" use="optional" />
        <xs:attribute name="label" type="mstns:StepAttributeLabel" use="optional" />
        <xs:attribute name="length" type="mstns:StepAttributeLength" use="optional" />
        <xs:attribute name="minValue" type="xs:integer" default="0" use="optional" />
        <xs:attribute name="maxValue" type="xs:integer" use="optional" />
        <xs:attribute name="optional" type="mstns:StepAttributeOptional" use="optional" default="false" />
        <xs:attribute name="performCalculation" type="mstns:StepAttributePerformCalculation" use="optional" default="false" />
        <xs:attribute name="primaryInputMethod" type="mstns:PrimaryInputMethodType"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="StepImage">
    <xs:complexContent>
      <xs:annotation>
        <xs:documentation>Adds an image step to the workflow. This is for displaying an image only, no values are collected as part of the step.</xs:documentation>
      </xs:annotation>
      <xs:extension base="BaseStepElement">
        <xs:attributeGroup ref="mstns:StepAttributesAllCommonVisible" />
        <xs:attribute name="defaultValue" type="xs:string" use="required">
          <xs:annotation>
            <xs:documentation>Specifies the path to the image. This can be in the form '/local/image/file.png' or 'http://example.org/image.png'.</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="helpLabel" type="mstns:StepAttributeHelpLabel" use="optional" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="StepImageCapture">
    <xs:complexContent>
      <xs:annotation>
        <xs:documentation>Adds an image capture step to the workflow. It allows the user to capture multiple images and add comments to each. Typically used in scenarios where documenting the state of goods is relevant.</xs:documentation>
      </xs:annotation>
      <xs:extension base="BaseStepElement">
        <xs:attributeGroup ref="mstns:StepAttributesAllCommonVisible" />
        <xs:attribute name="helpLabel" type="mstns:StepAttributeHelpLabel" use="optional" />
        <xs:attribute name="imageSavePath" type="xs:string" use="required">
          <xs:annotation>
            <xs:documentation>Specifies the output folder where captured images will be stored on the device. The root folder is TFM, which is where images are stored if a path is not added here. Format: \Path\To\CapturedImages</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="label" type="mstns:StepAttributeLabel" />
        <xs:attribute name="listSeparator" type="mstns:StepAttributeListSeparator" default=";">
          <xs:annotation>
            <xs:documentation>
              The output/result of the image capture step is a list of image path/comment pairs represented by a string in the following format: image-path1;comment1§image-path2;comment2, where ';' is the default list separator value.
              The list separator represents the separator character/string separating the image path from the comment in each pair. The '§' sign separating pairs from pairs is set in stone and cannot be changed.
            </xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="defaultValue" type="xs:string" use="optional" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="StepInformation">
    <xs:complexContent>
      <xs:annotation>
        <xs:documentation>Adds an information step to the workflow. This can be used for displaying instructions or heads-up messages to the user. No values are collected in this step.</xs:documentation>
      </xs:annotation>
      <xs:extension base="BaseStepElement">
        <xs:attributeGroup ref="mstns:StepAttributesAllCommonVisible" />
        <xs:attribute name="helpLabel" type="xs:string" use="required">
          <xs:annotation>
            <xs:documentation>Contains the text that is displayed in the information step.</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="label" type="mstns:StepAttributeLabel" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="StepList">
    <xs:complexContent>
      <xs:annotation>
        <xs:documentation>Adds a list step to the workflow. Allows the user to make a choice from a pre-populated list of values. These values can come from reference data or be supplied directly as part of the step configuration.</xs:documentation>
      </xs:annotation>
      <xs:extension base="BaseStepElement">
        <xs:attributeGroup ref="mstns:StepAttributesAllCommonVisible" />
        <xs:attribute name="dataDisplayColumn" type="mstns:StepAttributeDataDisplayColumn" use="optional" />
        <xs:attribute name="dataKeyColumn" type="mstns:StepAttributeDataKeyColumn" use="optional" />
        <xs:attribute name="dataTable" type="mstns:StepAttributeDataTable" use="optional">
          <xs:annotation>
            <xs:documentation>
              When using the 'dataTable' over 'listValues', make sure to also configure 'dataKeyColumn' and 'dataDisplayColumn'.
            </xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="defaultValue" type="xs:string" use="optional" />
        <xs:attribute name="defaultTo" type="DefaultToType" use="optional" default="FirstValue">
          <xs:annotation>
            <xs:documentation>When 'defaultValue' is not used, this configuration value determines whether to pre-select the first value in the list or start 'blank' instead. Defaults to 'FirstValue'.</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="filterColumn" type="xs:string" use="optional" />
        <xs:attribute name="eanAi" type="mstns:StepAttributeGs1Ai" use="optional" />
        <xs:attribute name="helpLabel" type="mstns:StepAttributeHelpLabel" use="optional" />
        <xs:attribute name="label" type="mstns:StepAttributeLabel" use="optional" />
        <xs:attribute name="linkColumn" type="xs:string" use="optional" />
        <xs:attribute name="linkedElement" type="xs:integer" use="optional">
          <xs:annotation>
            <xs:documentation>The 'id' value of the linked element which will be manipulated when the list value changes.</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="listSeparator" type="mstns:StepAttributeListSeparator" use="optional" />
        <xs:attribute name="listValues" type="mstns:StepAttributeListValues" use="optional">
          <xs:annotation>
            <xs:documentation>The use of 'listValues' cannot be combined with the use of 'dataTable'.</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="optional" type="mstns:StepAttributeOptional" use="optional" default="false" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="StepMultiLineText">
    <xs:complexContent>
      <xs:annotation>
        <xs:documentation>Adds a multi-line text step to the workflow. For collecting larger amounts of text where a normal one-line text field is simply too restricted in appearance.</xs:documentation>
      </xs:annotation>
      <xs:extension base="BaseStepElement">
        <xs:attributeGroup ref="mstns:StepAttributesAllCommonVisible" />
        <xs:attribute name="defaultValue" type="xs:string" use="optional" />
        <xs:attribute name="eanAi" type="mstns:StepAttributeGs1Ai" use="optional" />
        <xs:attribute name="length" type="mstns:StepAttributeLength" use="optional" />
        <xs:attribute name="optional" type="mstns:StepAttributeOptional" use="optional" />
        <xs:attribute name="helpLabel" type="mstns:StepAttributeHelpLabel" use="optional" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="StepMultiScan">
    <xs:complexContent>
      <xs:annotation>
        <xs:documentation>Adds a multi-scan step to the workflow. Allows the user to collect a series of scanned values in a single step.</xs:documentation>
      </xs:annotation>
      <xs:extension base="BaseStepElement">
        <xs:attributeGroup ref="mstns:StepAttributesAllCommonVisible" />
        <xs:attribute name="defaultValue" type="xs:string" use="optional" />
        <xs:attribute name="eanAi" type="mstns:StepAttributeGs1Ai" use="optional" />
        <xs:attribute name="label" type="mstns:StepAttributeLabel" use="optional" />
        <xs:attribute name="listSeparator" type="mstns:StepAttributeListSeparator" use="optional" />
        <xs:attribute name="optional" type="mstns:StepAttributeOptional" use="optional" />
        <xs:attribute name="uniqueValues" type="xs:boolean" use="optional" default="false">
          <xs:annotation>
            <xs:documentation>Determines whether to use unique values, i.e. whether the same value will be accepted as input more than once.</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="validationCaseSensitive" type="xs:boolean" use="optional">
          <xs:annotation>
            <xs:documentation>
              Determines whether the input should be validated with case sensitivity. Only applies to the MultiScan step, when uniqueValues is enabled.
            </xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="helpLabel" type="mstns:StepAttributeHelpLabel" use="optional" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="StepRadioButton">
    <xs:complexContent>
      <xs:annotation>
        <xs:documentation>Adds a radio button step to the workflow. Functionally equivalent to having a list with just two values, but the layout is that of a pair of radio buttons for the user to select between.</xs:documentation>
      </xs:annotation>
      <xs:extension base="BaseStepElement">
        <xs:attributeGroup ref="mstns:StepAttributesAllCommonVisible" />
        <xs:attribute name="defaultValue" type="xs:string" use="optional">
          <xs:annotation>
            <xs:documentation>When used, the value must match one of those represented by 'listValues'.</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="eanAi" type="mstns:StepAttributeGs1Ai" use="optional" />
        <xs:attribute name="label" type="mstns:StepAttributeLabel" use="optional" />
        <xs:attribute name="listSeparator" type="mstns:StepAttributeListSeparator" use="optional" />
        <xs:attribute name="listValues" type="mstns:StepAttributeListValues">
          <xs:annotation>
            <xs:documentation>Two (and only two) values separated by 'listSeparator'.</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="dataDisplayColumn" type="mstns:StepAttributeDataDisplayColumn" use="optional" />
        <xs:attribute name="dataKeyColumn" type="xs:string" use="optional" />
        <xs:attribute name="dataTable" type="xs:string" use="optional" />
        <xs:attribute name="helpLabel" type="mstns:StepAttributeHelpLabel" use="optional" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="StepSignature">
    <xs:complexContent>
      <xs:annotation>
        <xs:documentation>Adds a signature step to the workflow. Allows capturing a handwritten signature on-screen.</xs:documentation>
      </xs:annotation>
      <xs:extension base="BaseStepElement">
        <xs:attributeGroup ref="mstns:StepAttributesAllCommon" />
        <xs:attribute name="label" type="mstns:StepAttributeLabel" use="optional"/>
        <xs:attribute name="applyBackground" type="xs:boolean" default="false">
          <xs:annotation>
            <xs:documentation>
              If true, a white background will be applied to the created signature image.
              If false, the background is transparent.
            </xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="optional" type="mstns:StepAttributeOptional" use="optional" />
        <xs:attribute name="helpLabel" type="mstns:StepAttributeHelpLabel" use="optional" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="StepSummary">
    <xs:complexContent>
      <xs:annotation>
        <xs:documentation>Adds a summary step to the workflow. Typically added as the last step to display an overview of all the values collected in the previous steps.</xs:documentation>
      </xs:annotation>
      <xs:extension base="BaseStepElement">
        <xs:attributeGroup ref="mstns:StepAttributesAllCommonVisible" />
        <xs:attribute name="helpLabel" type="mstns:StepAttributeHelpLabel" use="optional" />
        <xs:attribute name="label" type="mstns:StepAttributeLabel" use="optional"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="StepText">
    <xs:complexContent>
      <xs:annotation>
        <xs:documentation>Adds a text step to the workflow. Collects a text/string value, typically a short(er) one like a barcode or just a few words.</xs:documentation>
      </xs:annotation>
      <xs:extension base="BaseStepElement">
        <xs:attributeGroup ref="mstns:StepAttributesAllCommon" />
        <xs:attributeGroup ref="mstns:StepAttributesTextCommon" />
        <xs:attribute name="defaultValue" type="xs:string" use="optional" />
        <xs:attribute name="helpLabel" type="mstns:StepAttributeHelpLabel" use="optional" />
        <xs:attribute name="label" type="mstns:StepAttributeLabel" use="optional" />
        <xs:attribute name="eanAi" type="xs:string" use="optional" >
          <xs:annotation>
            <xs:documentation>
              Comma separated string containing Gs1 application identifiers. E.g. 01,02 for item identifiers.
            </xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="validationWarningType" type="ValidationWarningType" use="optional">
          <xs:annotation>
            <xs:documentation>
              Determines the validation behaviour when errors occur.
            </xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!-- ===================================================================
       WORKFLOW related configuration END
       =================================================================== -->

  <!-- Registration Collector -->
  <xs:complexType name="RegistrationCollectorConfigurationType">
    <xs:sequence>
      <xs:element name="steps">
        <xs:complexType>
          <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="add" minOccurs="0" maxOccurs="unbounded" type="AddStepType">
              <xs:annotation>
                <xs:documentation>Generic way of adding a step where type is defined by the 'inputType' attribute.</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="date" type="mstns:StepDate" minOccurs="0" maxOccurs="unbounded" />
            <xs:element name="dateTime" type="mstns:StepDateTime" minOccurs="0" maxOccurs="unbounded" />
            <xs:element name="decimal" type="mstns:StepDecimal" minOccurs="0" maxOccurs="unbounded" />
            <xs:element name="expirationDate" type="mstns:StepExpirationDate" minOccurs="0" maxOccurs="unbounded" />
            <xs:element name="fromBin" type="mstns:StepFromBin" minOccurs="0" maxOccurs="unbounded" />
            <xs:element name="image" type="mstns:StepImage" minOccurs="0" maxOccurs="unbounded" />
            <xs:element name="imageCapture" type="mstns:StepImageCapture" minOccurs="0" maxOccurs="unbounded" />
            <xs:element name="information" type="mstns:StepInformation" minOccurs="0" maxOccurs="unbounded" />
            <xs:element name="integer" type="mstns:StepInteger" minOccurs="0" maxOccurs="unbounded" />
            <xs:element name="list" type="mstns:StepList" minOccurs="0" maxOccurs="unbounded" />
            <xs:element name="lotNumber" type="mstns:StepLotNumber" minOccurs="0" maxOccurs="unbounded" />
            <xs:element name="multiLineText" type="mstns:StepMultiLineText" minOccurs="0" maxOccurs="unbounded" />
            <xs:element name="multiScan" type="mstns:StepMultiScan" minOccurs="0" maxOccurs="unbounded" />
            <xs:element name="quantity" type="mstns:StepQuantity" minOccurs="0" maxOccurs="unbounded" />
            <xs:element name="quantityByScan" type="mstns:StepQuantityByScan" minOccurs="0" maxOccurs="unbounded" />
            <xs:element name="radioButton" type="mstns:StepRadioButton" minOccurs="0" maxOccurs="unbounded" />
            <xs:element name="serialNumber" type="mstns:StepSerialNumber" minOccurs="0" maxOccurs="unbounded" />
            <xs:element name="toBin" type="mstns:StepToBin" minOccurs="0" maxOccurs="unbounded" />
            <xs:element name="tote" type="mstns:StepTote" minOccurs="0" maxOccurs="unbounded" />
            <xs:element name="typeAndQuantity" type="TypeAndQuantityStepConfigurationType" minOccurs="0" maxOccurs="unbounded" />
            <xs:element name="text" type="mstns:StepText" minOccurs="0" maxOccurs="unbounded" />
            <xs:element name="signature" type="mstns:StepSignature" minOccurs="0" maxOccurs="unbounded" />
            <xs:element name="summary" type="mstns:StepSummary" minOccurs="0" maxOccurs="unbounded" />
          </xs:choice>
        </xs:complexType>
      </xs:element>
      <xs:element name="additionalValues" minOccurs="0" maxOccurs="1">
        <xs:annotation>
          <xs:documentation>Additional values will be added to the registration. These are values that should be a part of the registration but does not require a step.</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:sequence minOccurs="0" maxOccurs="unbounded">
            <xs:element name="additionalValue" minOccurs="0" maxOccurs="unbounded">
              <xs:complexType>
                <xs:attribute name="name" type="xs:string" use="required">
                  <xs:annotation>
                    <xs:documentation>The name of the additional value. The name will be used when storing and transferring the registration. If the name has already been added in the steps then they will not be added again. The steps takes precedence.</xs:documentation>
                  </xs:annotation>
                </xs:attribute>
                <xs:attribute name="value" type="xs:string" use="required">
                  <xs:annotation>
                    <xs:documentation>The value used with the name. The value attribute supports property translations similar to the default value of a step e.g. {Quantity}</xs:documentation>
                  </xs:annotation>
                </xs:attribute>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="prefillExpectedValueOnLocationScan" type="xs:boolean" use="optional">
      <xs:annotation>
        <xs:documentation>Transfer expected value to the input field when manual entry is selected.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="scanBehaviourWhenRegisteringQuantity" type="ScanBehaviourWhenRegisteringQuantityType" use="optional">
      <xs:annotation>
        <xs:documentation>
          The property dictates what to do when scanning a barcode in the quantity step in the registration collector.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="includeHiddenStepsInSummary" type="xs:boolean" use="optional" default="false">
      <xs:annotation>
        <xs:documentation>This allows hidden (visible=false) steps to be included in summary steps. This is particularly useful in conjunction with the order flagging feature.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="cancelBehaviour" type="CancelBehaviourType" use="optional" default="Close">
      <xs:annotation>
        <xs:documentation>The behaviour when cancelling the registration collector.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="autoSave" type="xs:boolean" use="optional" default="false">
      <xs:annotation>
        <xs:documentation>When enabled, registrations are automatically saved as drafts allowing the user to exit a registration and return to it later without starting over. Off by default, i.e. value is 'false'.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fastForwardMode" type="FastForwardModeType" use="optional" default="OnlyScanValues">
      <xs:annotation>
        <xs:documentation>
          Determines which values can be used for fast forward.
          Fast forward is a feature for stepping over a step if a value is provided in either the input or scan values.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="BaseInputLineType">
    <xs:attribute name="dataDisplayColumn" type="xs:string" use="optional" />
    <xs:attribute name="dataKeyColumn" type="xs:string" use="optional" />
    <xs:attribute name="dataTable" type="xs:string" use="optional" />
    <xs:attribute name="defaultValue" type="xs:string" use="optional" >
      <xs:annotation>
        <xs:documentation>The default value for the step. Notice that for decimal values the decimal must adhere to the backend decimal separator set in the protocol.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="defaultTo" type="DefaultToType" use="optional" default="FirstValue">
          <xs:annotation>
            <xs:documentation>When 'defaultValue' is not used, this configuration value determines whether to pre-select the first value in the list or start 'blank' with none selected instead. Defaults to 'FirstValue'.</xs:documentation>
          </xs:annotation>
        </xs:attribute>
    <xs:attribute name="eanAi" type="xs:string" use="optional" >
      <xs:annotation>
        <xs:documentation>
          Comma separated string with application identifiers. Defaults to 01,02 for item identifiers.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="filterColumn" type="xs:string" use="optional">
      <xs:annotation>
        <xs:documentation>Used to specify the column in the data table which should be used for filtering the contents of the list. E.g. A reference in the slave tabel to the master key.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="id" type="xs:unsignedInt" use="required">
      <xs:annotation>
        <xs:documentation>The id of line configuration used</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="inputFormat" type="xs:string" use="optional">
      <xs:annotation>
        <xs:documentation>
          Used to make sure input follows a specific pattern, defined by a regular expression.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="label" type="xs:string" >
      <xs:annotation>
        <xs:documentation>The label of the line</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="length" type="xs:unsignedInt" use="optional" />
    <xs:attribute name="linkedElement" type="xs:unsignedByte" use="optional">
      <xs:annotation>
        <xs:documentation>References another element which should be notified on changes to this element. Also used when list filtering is enabled.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="linkColumn" type="xs:string" use="optional" />
    <xs:attribute name="listSeparator" type="xs:string" use="optional" />
    <xs:attribute name="listValues" type="xs:string" use="optional" />
    <xs:attribute name="maxDate" use="optional">
      <xs:annotation>
        <xs:documentation>
          Define a date which cannot be exceeded. However, if optional is set to true, the date can be left out.
          Make sure to use the format dd-MM-yyyy.
        </xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="^([0-9]{2}-[0-9]{2}-[0-9]{4})$"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="maxValue" type="xs:decimal" use="optional" />
    <xs:attribute name="minDate" use="optional">
      <xs:annotation>
        <xs:documentation>
          Define a date which cannot be preceded. However, if optional is set to true, the date can be left out.
          Make sure to use the format dd-MM-yyyy.
        </xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="^([0-9]{2}-[0-9]{2}-[0-9]{4})$"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="minValue" type="xs:decimal" use="optional" >
      <xs:annotation>
        <xs:documentation>The minimum value of the step. Only positive numbers including zero are valid.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="name" type="StepNameType" use="required" >
      <xs:annotation>
        <xs:documentation>
          The name of the step to add, used to map the input and the entered value.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="optional" type="xs:string" use="optional">
      <xs:annotation>
        <xs:documentation>Determines if the line must have a value</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="validationValues" type="xs:string" use="optional">
      <xs:annotation>
        <xs:documentation>If set, only the values defined are accepted. Separated by the list separator. E.g. 3661103036043;7610400074520</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:simpleType name="StepNameType">
    <xs:annotation>
      <xs:documentation>
        A step name must begin with a letter.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z].*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="StepConfigurationType">
    <xs:complexContent>
      <xs:extension base="BaseInputLineType">
        <xs:choice>
          <xs:element name="onlineValidation" type="OnlineOnlyValidationType" minOccurs="0" maxOccurs="1"/>
        </xs:choice>
        <xs:attribute name="autoForwardAfterScan" type="xs:boolean" use="optional">
          <xs:annotation>
            <xs:documentation>Determines whether a scan will make the step continue to the next. Default is true.</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="editable" type="xs:string" use="optional" >
          <xs:annotation>
            <xs:documentation>Determines whether or not the step can be edited.</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="header" type="xs:string" use="required">
          <xs:annotation>
            <xs:documentation>Text to display above the step.</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="helpLabel" type="xs:string" use="optional">
          <xs:annotation>
            <xs:documentation>Guiding text displayed next to the step.</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="overDeliveryValidation" type="ValidationWarningType" use="optional">
          <xs:annotation>
            <xs:documentation>
              When using QuantityByScan, this value can be used to Block or Warn the user when the maxValue in the configuration has been reached.
            </xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="performCalculation" type="xs:boolean" use="optional">
          <xs:annotation>
            <xs:documentation>
              Determines whether the input can handle calculations.
              If enabled, it is possible to write an equation which will be executed when the user presses the next or accept button.
              E.g. 10 / 3
            </xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="primaryInputMethod" type="PrimaryInputMethodType" use="optional"/>
        <xs:attribute name="uniqueValues" type="xs:boolean" use="optional">
          <xs:annotation>
            <xs:documentation>
              Determines whether values need to be unique. This only applies to the MultiScan step.
            </xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="validationCaseSensitive" type="xs:boolean" use="optional">
          <xs:annotation>
            <xs:documentation>
              Determines whether the input should be validated with case sensitivity. Only applies to the MultiScan step, when uniqueValues is enabled.
            </xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="validationWarningType" type="ValidationWarningType" use="optional">
          <xs:annotation>
            <xs:documentation>
              Determines the validation behaviour when errors occur.
            </xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="visible" type="xs:boolean" use="optional">
          <xs:annotation>
            <xs:documentation>
              If visible is set to false, then the registration step will not be visible, however, the value will be added to the registration.
            </xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!--
    Middle class in inheritance hierarchy to avoid XSD validation errors.
    It contains overrides only, no additions!
    The "magic" happens through use of 'xs:restriction' instead of 'xs:extension'.
  -->
  <xs:complexType name="_TypeAndQuantityStepBase">
    <xs:complexContent>
      <xs:restriction base="StepConfigurationType">
        <xs:attribute name="defaultValue" type="xs:string" use="optional" >
          <xs:annotation>
            <xs:documentation>
              Defaults values can be added as a string in this format "Type1=0;Type2=12". Types defined in the default values will be added to the list when opening the step.
              Types defined in default values will be added even though the type is not in the the reference data.
            </xs:documentation>
          </xs:annotation>
        </xs:attribute>

        <xs:attribute name="eanAi" type="mstns:StepAttributeGs1Ai" >
          <xs:annotation>
            <xs:documentation>
              Defines the AI for getting the Quantity portion of a barcode.
            </xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:restriction>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="TypeAndQuantityStepConfigurationType">
    <xs:complexContent>
      <xs:extension base="_TypeAndQuantityStepBase">
        <xs:all>
          <xs:element name="list" type="ListType" minOccurs="0" maxOccurs="1" />
          <!-- The online element should not be needed as the StepConfigurationType also has it which the _TypeAndQuantityStepBase restricts, however, it does not work without. -->
          <xs:element name="onlineValidation" type="OnlineValidationType" minOccurs="0" maxOccurs="1"/>
        </xs:all>
        <xs:attribute name="scanBehavior" type="TypeAndQuantityScanBehaviourType" use="optional" default="CandidatesOnly" />
        <xs:attribute name="quantityAi" type="xs:string">
          <xs:annotation>
            <xs:documentation>
              Defines which AI to use for the type value is a Gs1 barcode.
            </xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="_AddStepBase">
    <xs:complexContent>
      <xs:restriction base="StepConfigurationType">
        <xs:attribute name="helpLabel" type="xs:string" use="required"/>
      </xs:restriction>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="AddStepType">
    <xs:complexContent>
      <xs:extension base="_AddStepBase">
        <xs:all minOccurs="0" maxOccurs="1">
          <xs:element name="onlineValidation" type="OnlineOnlyValidationType" minOccurs="0" maxOccurs="1"/>
        </xs:all>
        <xs:attribute name="inputType" type="BaseInputAttributeInputType" use="required"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:simpleType name="TypeAndQuantityScanBehaviourType">
    <xs:annotation>
      <xs:documentation>The behaviour of what should happen when scanning on a TypeAndQuantity step</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="Add" >
        <xs:annotation>
          <xs:documentation>
            The scanned value will be added as a type and the quantity set to 1.
            If the value was already on the list in the step then the quantity will be set to quantity + 1.
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CandidatesOnly" >
        <xs:annotation>
          <xs:documentation>
            The scanned value must exist in the candidate list (fetched from the reference data),
            if the scanned value exists it will be added as a type to the list and the quantity will be set to 1.

            If the scanned value was already on the list the quantity will be set to quantity + 1.

            It is possible to add values to the default value e.g. "Type1=3" in this case the Type1 will be a part of the candidates.
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="InputTypeConfigurationType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Date" />
      <xs:enumeration value="DateTime" />
      <xs:enumeration value="Decimal" />
      <xs:enumeration value="Image" />
      <xs:enumeration value="ImageCapture" />
      <xs:enumeration value="Information" />
      <xs:enumeration value="Integer" />
      <xs:enumeration value="List" />
      <xs:enumeration value="MultiLineText"/>
      <xs:enumeration value="MultiScan"/>
      <xs:enumeration value="QuantityByScan"/>
      <xs:enumeration value="RadioButton"/>
      <xs:enumeration value="Summary" />
      <xs:enumeration value="Signature" >
        <xs:annotation>
          <xs:documentation>This input type presents a 'Sign here' view and saves the result as a Base64 encoded string (originally a png image)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Text" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PrimaryInputMethodType">
    <xs:annotation>
      <xs:documentation>The primary input method for the step. The step will use the Control as default but can be modified to e.g. ask the user to scan</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="Control" >
        <xs:annotation>
          <xs:documentation>The normal control will be shown.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Scan" >
        <xs:annotation>
          <xs:documentation>The primary input will be scan and the step element can act accordingly e.g. the InputLineType.Text will show a SCAN icon with the possibility to manually enter the value.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ScanOnly" >
        <xs:annotation>
          <xs:documentation>
            The 'ScanOnly' differs from the 'Scan' in the way that the user cannot enter a value manually. The SCAN icon is displayed but it will not show the edit field.
            This is only applicable for InputLineType.Text.
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ScanBehaviourWhenRegisteringQuantityType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="ScanNextItem">
        <xs:annotation>
          <xs:documentation>Accept the entered value, and look for a new order line to start registering values on.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ValidateCurrentItem">
        <xs:annotation>
          <xs:documentation>Validate the scanned item against the selected order line.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="FastForwardModeType">
    <xs:annotation>
      <xs:documentation>
        Fast forward is a feature for stepping over a step if a value is provided in either the input or scanned values.
        The fast forward mode determines which values can be used in the fast forward.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="OnlyScanValues" >
        <xs:annotation>
          <xs:documentation>Only the values in the scan can be used for stepping over a step if the value is provided</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="InputAndScanValues" >
        <xs:annotation>
          <xs:documentation>
            Both the Input and scanned values can be used for stepping over a step if the value for the step is in the values.

            Input values are header values (filter) and properties from the selected item.
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="CancelBehaviourType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Warn" >
        <xs:annotation>
          <xs:documentation>Prompt the user whether to close the registration collector or not.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Close" >
        <xs:annotation>
          <xs:documentation>The registration collector closes on cancel.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="ConditionParameterType">
    <xs:annotation>
      <xs:documentation>Define which properties need to contain a certain value. The key and value attributes are case sensitive.</xs:documentation>
    </xs:annotation>
    <xs:attribute name="key" type="xs:string" use="required"/>
    <xs:attribute name="value" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:simpleType name="ValidationWarningType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Block">
        <xs:annotation>
          <xs:documentation>Do not allow the user to enter a different value than the suggested value.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="None">
        <xs:annotation>
          <xs:documentation>Allow the user to enter a different value than the one suggested.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Warn">
        <xs:annotation>
          <xs:documentation>Warn the user if an other value than the suggested is entered. Allowing the user to change it by accepting the prompt.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="DataMemberValue">
    <xs:restriction base="xs:string">
      <xs:annotation>
        <xs:documentation>
        The value to compare with the actual value of the property defined in the DataMember attribute.
        E.g. If DataMember of the element is set to Status, and the value of the Status property of the list object is 1, then the value element with the dataMemberValue attribute matching that value will control the appearance.
        </xs:documentation>
      </xs:annotation>
    </xs:restriction>
  </xs:simpleType>

</xs:schema>
