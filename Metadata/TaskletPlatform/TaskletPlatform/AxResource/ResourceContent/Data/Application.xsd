            <xs:documentation>
              Determines the validation behaviour when errors occur. Warning: Overrides the AllowBinChange attribute defined on the order line.
            </xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attributeGroup ref="mstns:StepAttributesTextCommon" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

