}
]]></Declaration>
		<Methods>
			<Method>
				<Name>render</Name>
				<Source><![CDATA[
    /// <summary>
    /// Traverses the list and by calling all nodes in the tree.
    /// </summary>
    /// <param name = "_listElement">The list element to traverse</param>
    public void render(TFMListBase _listElement)
    {
        MapEnumerator	mEnum = _listElement.getChildren().getEnumerator();
        while(mEnum.moveNext())
        {
            TFMListBase listElement = mEnum.currentValue();
            listElement.render(this);
        }
    }

]]></Source>
			</Method>
