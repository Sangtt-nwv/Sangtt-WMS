				<Source><![CDATA[
    public void renderCustomComponent(TFMListCustomComponent _customComponentElement)
    {
        MapEnumerator cmEnum = _customComponentElement.SubComponents().getEnumerator();
        while(cmEnum.moveNext())
        {
            TFMListBase customSub = cmEnum.currentValue();
            customSub.render(this);
        }
    }

