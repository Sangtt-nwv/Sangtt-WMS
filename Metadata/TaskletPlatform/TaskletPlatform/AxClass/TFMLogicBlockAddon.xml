				<Name>listOfAddonsAvailable</Name>
				<Source><![CDATA[
    public static Map listOfAddonsAvailable(TFMLogicBlock _block)
    {
        ListEnumerator      lEnum = new SysDictClass(classNum(TFMLogicBlockAddon)).extendedBy(true).getEnumerator();
        SysDictClass        sdc;
        Map                 ret = new Map(Types::String, Types::String);
        TFMLogicBlockAddon  addon;
        while (lEnum.moveNext())
        {
            sdc = new SysDictClass(lEnum.current());
            addon = sdc.makeObject();
            if (addon.compatibleWithBlock(_block))
            {
                ret.add(sdc.name(), addon.addonName());
            }
        }
        return ret;
    }

]]></Source>
