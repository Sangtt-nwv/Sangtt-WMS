    public Map getCollectorMap()
    {        
        TFMPostOrderPromptOverrideLineFields    fields;
        Map                                     fieldMap = new Map ( Types::String, Types::String);
        #tfm
        fieldMap.insert(TFMConstants::AttributeName(),this.Name);
        fieldMap.insert(TFMConstants::AttributeId(),int2Str(this.LineID));
        fieldMap.insert(TFMConstants::AttributeInputType(),enum2Symbol(enumNum(TFMInputTypes),this.InputType));
        while select fields where fields.LinesRecId == this.RecId
        {
            fieldMap.insert(fields.FieldName, fields.Value);
        }
        return fieldMap;
    }

