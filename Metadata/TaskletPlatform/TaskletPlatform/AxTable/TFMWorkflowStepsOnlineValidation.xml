		<Methods>
			<Method>
				<Name>servicesUsingValidation</Name>
				<Source><![CDATA[
	public static Set servicesUsingValidation(TFMWorkflowName _wfName, Name _stepName)
    {
        TFMWorkflowStepsOnlineValidation	onlineVal;
        Set									pages = new Set (Types::String);
        while select onlineVal where onlineVal.WorkflowName == _wfName//
        {
            if (strScan(onlineVal.ValidationType, strReplace(_stepName,'id',''),1,100))
            {
                pages.add(onlineVal.PageID);
            }
        }


        return pages;
    }

]]></Source>
			</Method>
