			<Method>
				<Name>lineOverride</Name>
				<Source><![CDATA[
    public edit TFMMethodname lineOverride(boolean _set, Methodname _methodName)
    {
        if (_set)
        {
            this.MethodName = subStr(_methodName,1,4) == 'parm' ? _methodName : ('parm'+_methodName);
        }
        return subStr(this.MethodName,5,strLen(this.MethodName));
    }

]]></Source>
			</Method>
			<Method>
				<Name>moveUp</Name>
				<Source><![CDATA[
    /// <summary>
    ///
    /// </summary>
    public void moveUp()
    {
        TFMDisplayLineOverrideLines relatedline;
        ttsbegin;
        select forupdate firstonly relatedline order by LineNumber desc where relatedline.TFMPageDataSourcesRefRecID == this.TFMPageDataSourcesRefRecID && relatedline.LineNumber < this.LineNumber;
        if (!relatedline)
        {
            ttsabort;
            return;
        }
        relatedline.LineNumber = this.LineNumber;
        this.selectForUpdate();
        this.LineNumber = relatedline.orig().LineNumber;
        relatedline.doUpdate();
        this.doUpdate();
        ttscommit;
    }

]]></Source>
			</Method>
			<Method>
				<Name>moveDown</Name>
				<Source><![CDATA[
    public void moveDown()
    {
        TFMDisplayLineOverrideLines relatedline;
        ttsbegin;
        select forupdate firstonly relatedline order by LineNumber asc where relatedline.TFMPageDataSourcesRefRecID == this.TFMPageDataSourcesRefRecID && relatedline.LineNumber > this.LineNumber;
        if (!relatedline)
        {
            ttsabort;
            return;
        }
        relatedline.LineNumber = this.LineNumber;
        this.selectForUpdate();
        this.LineNumber = relatedline.orig().LineNumber;
        relatedline.doUpdate();
        this.doUpdate();
        ttscommit;
    }

]]></Source>
			</Method>
			<Method>
				<Name>insert</Name>
				<Source><![CDATA[
    /// <summary>
    ///
    /// </summary>
    public void insert()
    {
        TFMDisplayLineOverrideLines relatedline;
        
        select forupdate firstonly relatedline order by LineNumber desc where relatedline.TFMPageDataSourcesRefRecID == this.TFMPageDataSourcesRefRecID;
        
        this.LineNumber = relatedline.LineNumber + 1;
        
        super();
    }

]]></Source>
			</Method>
			<Method>
				<Name>MigrateLinesToDatasource</Name>
				<Source><![CDATA[
	public static void MigrateLinesToDatasource()
    {
        TFMDisplayLineOverrideLines overrideLines;
        SysDictClass				dictClass;
        TFMTableNameAttribute		attributeCls = dictClass ? dictClass.getAttribute(classStr(TFMTableNameAttribute)) : null;
        

        ttsbegin;
        while select forupdate overrideLines where !overrideLines.TFMPageDataSourcesRefRecID
        {
            dictClass   = new SysDictClass(overrideLines.ClassOverrideID);
            attributeCls = dictClass ? dictClass.getAttribute(classStr(TFMTableNameAttribute)) : null;
            if (attributeCls && attributeCls is TFMTableNameAttribute)
            {
                overrideLines.TFMPageDataSourcesRefRecID = TFMPageDatasources::FindOrCreate('',attributeCls.parmTableName(),attributeCls.parmOrderType()).RecId;
                overrideLines.update();
            }
        }
        
        ttscommit;
    }

]]></Source>
			</Method>
			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[
    public boolean validateWrite()
    {
        boolean ret;
    
        ret = super();

		if (!tableName2Id(this.RefTableName))
        {
            warning(strFmt("@SYS75357",this.RefTableName));
            ret = false;
        }

        if (this.RefFieldName && !fieldName2Id(tableName2Id(this.RefTableName),this.RefFieldName))
        {
            warning(strfmt("@SYS77716",this.RefFieldName+' ',this.RefTableName));
            ret = false;
        }

        if (this.DisplayMethodName && !(new SysDictTable(tableName2Id(this.RefTableName)).doesMethodExist(this.DisplayMethodName)))
        {
            warning(strfmt(strReplace("@SYS90314","@SYS1129","@SYS8868"),this.DisplayMethodName,this.RefTableName));
            ret = false;
        }
    
        return ret;
    }

]]></Source>
