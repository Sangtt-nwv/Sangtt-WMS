	<SourceCode>
		<Declaration><![CDATA[
public class TFMListsVersion extends common
{
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>Find</Name>
				<Source><![CDATA[
    public static TFMListsVersion Find(TFMListId _listId, Version _version = 0, boolean _selectForUpdate = false)
    {
        TFMListsVersion listVersion;

        listVersion.selectForUpdate(_selectForUpdate);

        select firstonly listVersion order by Version desc where listVersion.ListId == _listId && (listVersion.Version == _version || !_version);

        return listVersion;
    }

]]></Source>
			</Method>
			<Method>
				<Name>newestVersion</Name>
				<Source><![CDATA[
    public static TFMListsVersion newestVersion(TFMListId	_listId, boolean _newestLocked = true)
    {
        TFMListsVersion listVersion;
        select firstonly listVersion order by Version desc where listVersion.ListId == _listId && (listVersion.Locked || !_newestLocked);
        return listVersion;
    }

]]></Source>
			</Method>
			<Method>
				<Name>lockVersion</Name>
				<Source><![CDATA[
    public static void lockVersion(TFMListID _listId)
    {
        ttsbegin;
        TFMListsVersion lVersion = TFMListsVersion::Find(_listId,TFMListsVersion::newestVersion(_listId, false).Version,true);

        lVersion.locked = true;
        lVersion.update();
        ttscommit;

        TFMListsProvider::instance().invalidateProvider();
        TFMPagesProvider::updateVersion(); // makes sure a new version is generated once the approved button is pressed.
    }

]]></Source>
			</Method>
		</Methods>
	</SourceCode>
