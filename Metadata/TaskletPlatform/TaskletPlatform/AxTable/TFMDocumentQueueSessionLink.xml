{
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>addLink</Name>
				<Source><![CDATA[
    /// <summary>
    ///
    /// </summary>
    public static void addLink(TFMDocumentMessageId _messageId, TFMProcessSessionID _session, Description _desc, boolean _isPost, TFMDocumentDeviceId _device)
    {
        TFMDocumentQueueSessionLink linkTable;
        
        linkTable.MessageId = _messageId;
        linkTable.SessionID = _session;
        linkTable.insert();

        TFMProcessSessions::createIfNotExist(_session, _desc,_isPost, _device);
    }

]]></Source>
			</Method>
			<Method>
				<Name>delete</Name>
				<Source><![CDATA[
    /// <summary>
    ///
    /// </summary>
    public void delete()
    {
        TFMProcessSessions processSessions;

        super();

        // Delete related work log if session ID does not exists in links
        if(!TFMDocumentQueueSessionLink::existSessionLink(this.SessionID))
        {
            delete_from processSessions
                where processSessions.ProcessSessionID == this.SessionID;
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>existSessionLink</Name>
				<Source><![CDATA[
    public static boolean existSessionLink(TFMProcessSessionID _sessionId)
    {
        TFMDocumentQueueSessionLink sessionLink;

        select firstonly sessionLink where sessionLink.SessionID == _sessionId;

        return sessionLink.RecId != 0;
    }

]]></Source>
			</Method>
		</Methods>
