		<Methods>
			<Method>
				<Name>AddOrUpdateFont</Name>
				<Source><![CDATA[
    public static void AddOrUpdateFont(TFMFontID _fontId, TFMFontSizes _size, Noyes _bold, NoYes _italic, SysColorHex _color)
    {
        TFMFonts fonts;
        ttsbegin;
        select forupdate firstonly fonts where fonts.Id == _fontId;

        fonts.Id	= _fontId;
        fonts.size	= _size;
        fonts.bold	= _bold;
        fonts.italic= _italic;
        fonts.color	= _color;
        fonts.write();
        ttscommit;
    }

]]></Source>
			</Method>
			<Method>
				<Name>FindOrCreateFromProperties</Name>
				<Source><![CDATA[
    public static TFMFonts FindOrCreateFromProperties(TFMFontID _fontId, TFMFontSizes _size, Noyes _bold, NoYes _italic, SysColorHex _color)
    {
        TFMFonts fonts;

        ttsbegin;        
        
        fonts = TFMFonts::Find(_fontId, true);
         //select firstonly fonts where fonts.size == _size && fonts.bold == _bold && fonts.italic == _italic && fonts.color == _color;

		if (!fonts)
        {
            fonts.Id	= _fontId ? _fontId : strFmt('%1%2%3%4',_size,_bold?'Bold':'',_italic?'Italic':'', new System.Drawing.ColorConverter().ConvertFromString(_color).ToString());
            fonts.size	= _size;
            fonts.bold	= _bold;
            fonts.italic= _italic;
            fonts.color	= _color;
            fonts.write();
        }

        ttscommit;
        return fonts;
    }

]]></Source>
			</Method>
			<Method>
				<Name>Find</Name>
				<Source><![CDATA[
    public static TFMFonts Find(TFMFontID _fontId, boolean _selectForUpdate = true)
    {
        TFMFonts fonts;
        
        fonts.selectForUpdate(_selectForUpdate);
        select firstonly fonts where fonts.Id == _fontId;

        return fonts;
    }

]]></Source>
			</Method>
