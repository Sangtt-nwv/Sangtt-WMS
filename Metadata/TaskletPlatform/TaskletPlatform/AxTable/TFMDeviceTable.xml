		<Methods>
			<Method>
				<Name>FindOrCreateDevice</Name>
				<Source><![CDATA[
    public static TFMDeviceTable FindOrCreateDevice(TFMDocumentDeviceId _deviceID)
    {
        TFMDeviceTable devTable;

        select firstonly devTable where devTable.DeviceId == _deviceID;

        if (devTable)
        {
            return devTable;
        }
        devTable.DeviceId   = _deviceID;
        devTable.Name       = _deviceID;
        devTable.insert();

        return devTable;
    }

]]></Source>
			</Method>
			<Method>
				<Name>lastCapabilitiesUpdate</Name>
				<Source><![CDATA[
    public display utcdatetime lastCapabilitiesUpdate()
    {
        TFMDeviceCapabilities deviceCapabilities;
        select firstonly ModifiedDateTime from deviceCapabilities
            order by deviceCapabilities.ModifiedDateTime desc
            where deviceCapabilities.DeviceId == this.DeviceId;
        return deviceCapabilities.ModifiedDateTime;
    }

]]></Source>
			</Method>
