			<Method>
				<Name>Find</Name>
				<Source><![CDATA[
    /// <summary>
    ///
    /// </summary>
    public static TFMImageTable Find(ImageName _imageName, boolean _select4Update = false)
    {
        TFMImageTable imgTbl;

        imgTbl.selectForUpdate(_select4Update);

        select firstonly imgTbl where imgTbl.ImageName == _imageName;
        return imgTbl;
    }

]]></Source>
