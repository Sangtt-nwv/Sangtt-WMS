		<Methods>
			<Method>
				<Name>insert</Name>
				<Source><![CDATA[
    public void insert()
    {
        super();
        if (TFMProcessBlockchainLinks::loopCheck(this.ToBlock))
        {
            throw Error("@TFM:Cycledetected");
        }
        
    }

]]></Source>
			</Method>
			<Method>
				<Name>loopCheck</Name>
				<Source><![CDATA[
	public static boolean loopCheck(RefRecId _fromLink)
    {
        Set setVisited = new Set(Types::Int64);
        Set setStack = new Set(Types::Int64);
        return TFMProcessBlockchainLinks::hasLoop(_fromLink,setVisited, setStack);
    }

]]></Source>
			</Method>
			<Method>
				<Name>hasLoop</Name>
				<Source><![CDATA[
    protected static boolean hasLoop(RefRecId _fromLink, Set _setVisited, Set _setStack)
    {
        
        TFMProcessBlockchainLinks   blockLinks;
        
        _setVisited.add(_fromLink);
        _setStack.add(_fromLink);

        while select blockLinks where blockLinks.FromBlock == _fromLink
        {
            
            if (!_setVisited.in(blockLinks.ToBlock))
            {
                if (TFMProcessBlockchainLinks::hasLoop(blockLinks.ToBlock, _setVisited, _setStack))
                    return true;
            }
            else if (_setStack.in(blockLinks.ToBlock))
            {
                return true;
            }
        }

        _setStack.remove(_fromLink);
        return false;
    }

]]></Source>
			</Method>
			<Method>
				<Name>processId</Name>
				<Source><![CDATA[
    public display TFMProcessID processId()
    {
        TFMProcessBlocks blocks;

        select firstonly ProcessID, RecId from blocks where blocks.RecId == this.FromBlock;
        return blocks.ProcessID;
    }

]]></Source>
