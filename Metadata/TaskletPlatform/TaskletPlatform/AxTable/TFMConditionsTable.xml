			<Method>
				<Name>versionIncrement</Name>
				<Source><![CDATA[
    public static void versionIncrement(TFMProcessID _processId, Version _oldVersion, Version _newVersion)
    {
        TFMConditionsTable  cTbl;
        RecId               oldRecId;

        while select cTbl where cTbl.DomainKey == _processId && cTbl.Version == _oldVersion
        {
            oldRecId = cTbl.recId;
            cTbl.Version = _newVersion;
            cTbl.insert();
            TFMConditionsParameters::versionIncrement(oldRecId, cTbl.RecId);
        }

    }

]]></Source>
			</Method>
			<Method>
				<Name>deleteCondition</Name>
				<Source><![CDATA[
    /// <summary>
    /// 
    /// </summary>  
    public static void deleteCondition(str _domain, TFMProcessId _domainKey, str _methodName, Version _version)
    {
        TFMConditionsTable conditionsTable;

        delete_from conditionsTable where
                conditionsTable.Domain == _domain &&
                conditionsTable.DomainKey == _domainKey &&
                conditionsTable.Method == _methodName &&
                conditionsTable.Version == _version;
    }

]]></Source>
