				<Name>FindOrCreate</Name>
				<Source><![CDATA[
    public static TFMPageDatasources FindOrCreate(TFMPageID _pageId, TableName _tableName, TFMOrderTypes _orderType, boolean _selectforUpdate = false)
    {
        TFMPageDatasources dataSource;
		
        dataSource.selectForUpdate(_selectforUpdate);

        select firstonly dataSource where dataSource.PageID == _pageId && dataSource.TableName == _tableName && dataSource.OrderType == _orderType;

		if (!dataSource)
        {
            dataSource.PageID		= _pageId;
            dataSource.TableName	= _tableName;
            dataSource.OrderType	= _orderType;
            dataSource.insert();
        }
        return dataSource;
    }

]]></Source>
