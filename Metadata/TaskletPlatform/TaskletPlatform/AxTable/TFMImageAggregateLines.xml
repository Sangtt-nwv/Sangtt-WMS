{
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>initValue</Name>
				<Source><![CDATA[
    public void initValue()
    {
        this.Height = 100;
        this.Width = 100;
        this.xCenterPct = 50;
        this.yCenterPct = 50;
        super();
    }

]]></Source>
			</Method>
			<Method>
				<Name>insert</Name>
				<Source><![CDATA[
    public void insert()
    {
        this.LineNum = TFMImageAggregateLines::nextLineNum(this.IconID);
        super();
    }

]]></Source>
			</Method>
			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[
    public boolean validateWrite()
    {
        boolean ret;
        

        ret = super();

        if (this.IconID == this.IconToUse || TFMImageAggregateLines::testForCyclicRedundancy(this.IconToUse,this.IconID))
        {
            warning("@SYS35601");
            ret = false;
        }
		

        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>testForCyclicRedundancy</Name>
				<Source><![CDATA[
	public static boolean testForCyclicRedundancy(ResourceName _iconToTest, ResourceName _iconToAvoid)
    {        
		TFMImageAggregateLines lines;
        boolean					ret;
		while select lines where lines.IconID == _iconToTest
        {
            if (lines.IconToUse == _iconToAvoid)
            {
                return true;
            }
            ret = ret || TFMImageAggregateLines::testForCyclicRedundancy(lines.IconToUse,_iconToAvoid);
        }
        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>nextLineNum</Name>
				<Source><![CDATA[
    public static real nextLineNum(ResourceName _iconParentName)
    {
        TFMImageAggregateLines line;
        select firstonly line order by LineNum desc where line.IconID == _iconParentName;

        return line.lineNum +1;

    }

]]></Source>
			</Method>
			<Method>
				<Name>MoveUp</Name>
				<Source><![CDATA[
    public static void MoveUp(RefRecId _nodeToMove)
    {
        TFMImageAggregateLines lineAbove;
        TFMImageAggregateLines	lineChosen;
        LineNum		tempLineNum;
        ttsbegin;
        select forupdate firstonly lineChosen where lineChosen.RecId == _nodeToMove;
        select forupdate firstonly lineAbove order by LineNum desc where lineAbove.IconID == lineChosen.IconID && lineAbove.LineNum < lineChosen.LineNum;
        if (lineAbove)
        {
            tempLineNum = lineAbove.LineNum;

            lineAbove.LineNum = lineChosen.LineNum;
            lineChosen.LineNum = tempLineNum;
            lineAbove.update();
            lineChosen.update();
        }
        ttscommit;
    }

]]></Source>
			</Method>
			<Method>
				<Name>MoveDown</Name>
				<Source><![CDATA[
    public static void MoveDown(RefRecId _nodeToMove)
    {
        TFMImageAggregateLines lineBelow;
        TFMImageAggregateLines	lineChosen;
        LineNum		tempLineNum;
        ttsbegin;
        select forupdate firstonly lineChosen where lineChosen.RecId == _nodeToMove;
        select forupdate firstonly lineBelow order by LineNum asc where lineBelow.IconID == lineChosen.IconID && lineBelow.LineNum > lineChosen.LineNum;

        if (lineBelow)
        {
            tempLineNum = lineBelow.LineNum;

            lineBelow.LineNum = lineChosen.LineNum;
            lineChosen.LineNum = tempLineNum;
            lineBelow.update();
            lineChosen.update();
        }
        ttscommit;
    }

]]></Source>
			</Method>
		</Methods>
