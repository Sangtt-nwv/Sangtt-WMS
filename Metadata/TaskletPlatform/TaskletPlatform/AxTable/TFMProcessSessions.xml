				<Name>createIfNotExist</Name>
				<Source><![CDATA[
    public static void createIfNotExist(TFMProcessSessionID _sessionId, Description _desc, boolean _isPost, TFMDocumentDeviceId _device)
    {
        TFMProcessSessions sessions;
        List                descriptionSplit = TFMHelper::strSplit(_sessionId,'|');
        container           descCon = descriptionSplit.pack();
        TableName           tableName= conPeek(descCon,min(7, conLen(descCon)));
        SysDictTable        sdt = new SysDictTable(tableName2Id(tableName));
        IdentifierName      singularLabel = sdt ? SysLabel::labelId2String(sdt.singularLabel()) : '';
        if (!singularLabel)
        {
            singularLabel = sdt && !singularLabel? sdt.label() : "Order";
        }
        ttsbegin;
        select forupdate firstonly sessions where sessions.ProcessSessionID == _sessionId;
        sessions.ProcessSessionID = _sessionId;
        sessions.Description = _desc ? _desc : strFmt('%1 %2', singularLabel, conPeek(descCon,4));
        sessions.Posted = _isPost;
        sessions.DeviceId = _device;
        sessions.write();
        ttscommit;
    }

]]></Source>
