    /// </summary>
    public Map getFields()
    {
        Map                                         retMap = new Map(Types::String, Types::Class);
        TFMCustomFunctionFlowParmLinesReplacement   repLines;
        DictField                                   df;

        while select repLines where Replines.TFMMenu == this.TFMMenu && repLines.ParmName == this.ParmName
        {
            df = new DictField(tableName2Id(this.EDTName),fieldName2Id(tableName2Id(this.EDTName),repLines.FieldName));
            retMap.insert(repLines.Name ? repLines.Name : repLines.FieldName,df);
        }
        return retMap;
    }

]]></Source>
