]]></Declaration>
		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static TFMParameters find(boolean _forupdate = false)
    {
        TFMParameters parameter;
        
        parameter.selectForUpdate(_forupdate);
    
        select firstonly parameter
            index Key
            where parameter.Key == 0;
    
        if (!parameter && !parameter.isTmp())
        {
            Company::createParameter(parameter);
        }
    
        return parameter;
    }

]]></Source>
			</Method>
