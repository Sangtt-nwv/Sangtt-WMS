				<Source><![CDATA[
    public static TFMImageAggregate Find(ResourceName _resName, boolean _selectForUpdate = false)
    {
        TFMImageAggregate imgAggr;

        imgAggr.selectForUpdate(_selectForUpdate);

        select firstonly imgAggr where imgAggr.IconID == _resName;

        return imgAggr;
    }

]]></Source>
