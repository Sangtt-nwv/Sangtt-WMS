				<Source><![CDATA[
    public static TFMListAttribute Find(RecId _parentNode, TFMAttributeName _attributeName, boolean _selectForUpdate = false)
    {
        TFMListAttribute attributeNode;

        attributeNode.selectForUpdate(_selectForUpdate);

        select firstonly attributeNode where attributeNode.ParentNode == _parentNode && attributeNode.AttributeName == _attributeName;

        return attributeNode;
    }

]]></Source>
