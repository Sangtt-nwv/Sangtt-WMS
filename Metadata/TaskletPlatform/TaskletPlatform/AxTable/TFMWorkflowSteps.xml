		<Methods>
			<Method>
				<Name>insert</Name>
				<Source><![CDATA[
    public void insert()
    {
        TFMWorkflowSteps steps;

        select firstonly WorkflowStepId from steps order by WorkflowStepId desc where steps.WorkflowName == this.WorkflowName;

        this.WorkflowStepId = steps.WorkflowStepId + 10;

        super();
    }

]]></Source>
			</Method>
			<Method>
				<Name>stepName</Name>
				<Source><![CDATA[
    public edit Name stepName(boolean _set, Name _className)
    {
        ClassId				classId;
        Name				ret = '';
        

		if (_set)
        {
            this.CallClass = _className;
        }

        classId = ClassName2Id(this.CallClass);
		if (classId)
        {
            ret = subStr(this.CallClass,strLen(classStr(TFMWorkflowBlock))+1,1000);
        }
        return ret;
    }

]]></Source>
			</Method>
		</Methods>
