		<Methods>
			<Method>
				<Name>tableOverride</Name>
				<Source><![CDATA[
    public edit TFMTableName tableOverride(boolean _set, TableName _tableName)
    {
        TableName tblName;
        
        if (_set)
        {
            this.ClassOverrideID = className2Id(_tableName);
            
        }
        tblName = TFMDisplayLineOverride::classId2Attribute(this.ClassOverrideID);
        
        return tblName;
    }

]]></Source>
			</Method>
			<Method>
				<Name>isCacheActive</Name>
				<Source><![CDATA[
	public static boolean isCacheActive(ClassId _classId, TFMOrderTypes _orderTypes = '')
    {
        TFMOutputCacheSetup cacheSetup;

        select firstonly cacheSetup where cacheSetup.ClassOverrideID == _classId && cacheSetup.Active && (cacheSetup.OrderType == _orderTypes || !_orderTypes || _orderTypes=='*');

        return cacheSetup.Active;
    }

]]></Source>
			</Method>
