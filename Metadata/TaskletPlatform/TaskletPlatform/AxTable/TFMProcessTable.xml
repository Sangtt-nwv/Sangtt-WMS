	<SourceCode>
		<Declaration><![CDATA[
public class TFMProcessTable extends common
{
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>insert</Name>
				<Source><![CDATA[
    public void insert()
    {
        TFMProcessVersion pVersion;
        super();

        pVersion.ProcessID = this.ProcessID;
        pVersion.Version = 1;
        pVersion.insert();
    }

]]></Source>
			</Method>
			<Method>
				<Name>currentVersion</Name>
				<Source><![CDATA[
    public display Version currentVersion()
    {
        return TFMProcessVersion::newestVersion(this.ProcessID);
    }

]]></Source>
			</Method>
			<Method>
				<Name>deltaLevel</Name>
				<Source><![CDATA[
    public display TFMDeltaLevel deltaLevel()
    {
        TFMProcess process = TFMProcessProvider::GetAllProcessesImpl().getProcessInfo(this.ProcessID);
        return process ? process.parmDeltaLevel() : TFMDeltaLevel::Custom;
    }

]]></Source>
			</Method>
			<Method>
				<Name>processIdDisplayName</Name>
				<Source><![CDATA[
    display str processIdDisplayName()
    {
        str value = this.ProcessID;
        if(this.RevertToClassic)
        {
            value = strFmt('%1 %2', value, "(Classic)");
        }
        return value;
    }

]]></Source>
			</Method>
		</Methods>
	</SourceCode>
