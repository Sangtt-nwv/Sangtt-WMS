		<Methods>
			<Method>
				<Name>Find</Name>
				<Source><![CDATA[
    public static TFMLists Find(TFMListId _listId, boolean _selectForUpdate = false)
    {
        TFMLists lists;
        lists.selectForUpdate(_selectForUpdate);
        select firstonly lists where lists.ListId == _listId;
        return lists;
    }

]]></Source>
			</Method>
			<Method>
				<Name>newestVersion</Name>
				<Source><![CDATA[
	public display Name newestVersion()
    {
        TFMListsVersion version = TFMListsVersion::Find(this.ListId);
        TFMList list = TFMListsProvider::getAllLists().getList(this.ListId);
        str versionStr = "@SYS16131" + ': ' + int2Str(version.Version) + (list.parmDeltaLevel() == TFMDeltaLevel::Code || version.Locked ? ' ('+"@SYS8709"+')' : ' ('+"@SYS80095"+')');
        str deltaLevel = enum2Str(list.parmDeltaLevel());
        return versionStr + ' - ' + deltaLevel;
    }

]]></Source>
			</Method>
			<Method>
				<Name>showUsageInfoinHTMLViewer</Name>
				<Source><![CDATA[
    public void showUsageInfoinHTMLViewer(TFMHtmlViewerCtrl _htmlViewer)
    {
        str			htmlText = '<h3>' + strFmt("@TFM:List1isusedonthefollowingpages",this.ListId)+ '</h3><ul>';
        MapEnumerator	pageEnum;
        TFMPage			page;
        TFMListId		listId;

        pageEnum = TFMPagesProvider::getAllPages().getPages().getEnumerator();
        while (pageEnum.moveNext())
        {
            page = pageEnum.currentValue();
            listId = page.getListId();
			if (listId == this.ListId)
            {
                htmlText += '<li><a href="/?cmp=' + curExt() + '&mi=' + menuItemDisplayStr(TFMPageOverview) + '&PageId=' + page.parmId() + '">'+page.parmId()+'</a></li>';
            }
        }

        _htmlViewer.parmHtml(htmlText + '</ul>');
    }

]]></Source>
			</Method>
