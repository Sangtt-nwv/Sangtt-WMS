				<Name>addActionToXML</Name>
				<Source><![CDATA[
    /// <summary>
    ///
    /// </summary>
    public static void addActionToXML(Name _pageName, XmlElement _actionsNode)
    {
        TFMPageActions	actions;
        XmlElement		openNode;
		while select actions where actions.Name == _pageName
        {
            openNode = _actionsNode.ownerDocument().createElement('open');

            openNode.setAttribute('id',actions.Id);
            openNode.setAttribute('icon',actions.Icon);
            openNode.setAttribute('title',actions.Title);
            _actionsNode.appendChild(openNode);
        }
    }

]]></Source>
