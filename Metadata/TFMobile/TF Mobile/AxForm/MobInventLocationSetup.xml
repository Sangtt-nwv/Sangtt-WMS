					<Method>
						<Name>setDefaultLocation</Name>
						<Source><![CDATA[
        /// <summary>
        ///
        /// </summary>
        public edit InventLocationId setDefaultLocation(boolean _set, UserGroupInfo _buffer, InventLocationId _value)
        {
            MobInventLocationsGroupRights rights;

            select firstonly rights where rights.UserGroupId == _buffer.id && rights.DefaultLocation;
            if (_set)
            {
                ttsbegin;
                update_recordset rights
                    setting DefaultLocation = 0
                    where rights.UserGroupId == _buffer.id;
                select firstonly forupdate rights where rights.UserGroupId == _buffer.id && rights.InventLocationId == _value;
                rights.DefaultLocation = NoYes::Yes;
                if (rights)
                {
                    rights.update();
                }
                ttscommit;
            }

            return rights.InventLocationId;
        }

]]></Source>
