		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static MobParameters find(boolean _forupdate = false)
    {
        MobParameters parameter;
        
        parameter.selectForUpdate(_forupdate);
    
        select firstonly parameter
            index Key
            where parameter.Key == 0;
    
        if (!parameter && !parameter.isTmp())
        {
            Company::createParameter(parameter);
        }
    
        return parameter;
    }

]]></Source>
			</Method>
			<Method>
				<Name>initValue</Name>
				<Source><![CDATA[
    /// <summary>
    ///
    /// </summary>
    public void initValue()
    {
        ProdJournalName pjn;
        UserGroupInfo   userGroup_admin;
        UserGroupInfo   userGroup_user;
        
        this.InventJournalNameCount         = InventJournalName::standardJournalName(InventJournalType::Count);
        this.InventJournalNameLossProfit    = InventJournalName::standardJournalName(InventJournalType::LossProfit);
        this.InventJournalNameTagCounting   = InventJournalName::standardJournalName(InventJournalType::TagCounting);
        this.InventJournalNameTransfer      = InventJournalName::standardJournalName(InventJournalType::Transfer);
        select firstonly pjn
            where pjn.JournalType == ProdJournalType::ReportFinished;
        this.ProdJournalNameFinish          = pjn.JournalNameId;

        this.PickPickingRoute               = NoYes::Yes;
        this.PickProd                       = NoYes::Yes;
        this.PickTransfer                   = NoYes::Yes;
        this.ReceivePurch                   = NoYes::Yes;
        this.ReceiveTransfer                = NoYes::Yes;
        this.ReceiveProductionInput         = NoYes::Yes;
        this.ReceiveRMA                     = NoYes::Yes;
        this.CancelQtyOnOrder               = NoYes::Yes;
        this.DocuTypeId                     = DocuType::typeImage();

        super();

        ttsBegin;

        select firstOnly userGroup_admin where userGroup_admin.id == TFMConstants::TFMAdmin();
        if(!userGroup_admin)
        {
            userGroup_admin.id = TFMConstants::TFMAdmin();
            userGroup_admin.name = "@MobileWMS:MobileWMS177";
            userGroup_admin.insert();

        }

        select firstOnly userGroup_user where userGroup_user.id == TFMConstants::TFMUser();
        if(!userGroup_user)
        {
            userGroup_user.id = TFMConstants::TFMUser();
            userGroup_user.name = "@MobileWMS:MobileWMS178";
            userGroup_user.insert();
        }

        ttsCommit;
        TFMGS1Table::defaultSetup();
    }

]]></Source>
			</Method>
			<Method>
				<Name>validateFieldValue</Name>
				<Source><![CDATA[
    /// <summary>
    ///
    /// </summary>
    /// <param name = "_fieldName"></param>
    /// <param name = "_arrayIndex"></param>
    /// <returns></returns>
    public boolean validateFieldValue(FieldName _fieldName, int _arrayIndex = 1)
    {
        boolean ret;
    
        ret = super(_fieldName, _arrayIndex);
    
        if (_fieldName == fieldStr(MobParameters, PickPickingRoute) && this.PickPickingRoute)
        {
            this.PickSale = NoYes::No;
        }
        else if (_fieldName == fieldStr(MobParameters, PickSale) && this.PickSale)
        {
            this.PickPickingRoute = NoYes::No;
        }
        else if (_fieldName == fieldStr(MobParameters, ReceiveArrival) && this.ReceiveArrival)
        {
            this.ReceivePurch = NoYes::No;
        }
        else if (_fieldName == fieldStr(MobParameters, ReceivePurch) && this.ReceivePurch)
        {
            this.ReceiveArrival = NoYes::No;
        }

        return ret;
    }

]]></Source>
