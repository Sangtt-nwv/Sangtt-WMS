				<Name>Find</Name>
				<Source><![CDATA[
    /// <summary>
    ///
    /// </summary>
    public static MobInventAdjustmentCauses Find(Description _description, boolean _select4Update = false)
    {
        MobInventAdjustmentCauses adjCause;

        adjCause.selectForUpdate (_select4Update);
        select firstonly adjCause where adjCause.Description == _description;

        return adjCause;
    }

]]></Source>
