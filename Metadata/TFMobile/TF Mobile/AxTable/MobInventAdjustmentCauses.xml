			<Method>
				<Name>getAllCauses</Name>
				<Source><![CDATA[
    /// <summary>
    ///
    /// </summary>
    public static Map getAllCauses()
    {
        MobInventAdjustmentCauses adjustCauses;
        Map allCauses = new Map(Types::String,Types::String);
        while select adjustCauses
        {
            allCauses.insert(adjustCauses.Description,adjustCauses.InventJournalNameLossProfit);
        }
        return allCauses;
    }

]]></Source>
