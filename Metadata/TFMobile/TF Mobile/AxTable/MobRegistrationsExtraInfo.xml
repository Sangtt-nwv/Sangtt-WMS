		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Find buffer
    /// </summary>
    /// <param name = "_mobRegistration">MobRegistraion Rec ID</param>
    /// <param name = "_key">Extra info key value</param>
    /// <returns>MobregistrationExtraInfo buffer</returns>
    public static MobRegistrationsExtraInfo find(RefRecId _mobRegistration, KeyValueLong _key)
    {
        MobRegistrationsExtraInfo extraInfo;

        select firstonly extraInfo
            where   extraInfo.MobRegistration   == _mobRegistration
            &&      extraInfo.Key               == _key;

        return extraInfo;
    }

]]></Source>
			</Method>
			<Method>
				<Name>getExtraInfoValue</Name>
				<Source><![CDATA[
    /// <summary>
