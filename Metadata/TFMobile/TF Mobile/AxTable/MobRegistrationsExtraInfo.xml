    /// <param name = "_key">Extra info key value</param>
    /// <returns>Value from key</returns>
    public static description getExtraInfoValue(RefRecId _mobRegistration, KeyValueLong _key)
    {
        return MobRegistrationsExtraInfo::find(_mobRegistration, _key).Value;
    }

]]></Source>
