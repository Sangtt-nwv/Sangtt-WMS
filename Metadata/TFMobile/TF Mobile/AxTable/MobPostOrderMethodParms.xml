		<Methods>
			<Method>
				<Name>nameOverride</Name>
				<Source><![CDATA[
    public edit Name nameOverride(boolean _set, Name _name)
    {
        Name name;
        MobPostOrderPromptOverrideLines line;

        if (_set)
        {
            select firstonly line where line.MobPostOrderPromptOverrideRecID == this.PostOrderPromptOverrideRecID && line.Name == _name;
            this.PostOrderPromptOverrideLinesRecId = line.RecId;
            
        }

        name = MobPostOrderPromptOverrideLines::FindRecID(this.PostOrderPromptOverrideLinesRecId).name;

        return name;
    }

]]></Source>
			</Method>
			<Method>
				<Name>lookupLineNames</Name>
				<Source><![CDATA[
    public void lookupLineNames(FormControl _callingControl)
    {
        SysTableLookup          sysTableLookup  = SysTableLookup::newParameters(tablenum(MobPostOrderPromptOverrideLines), _callingControl);
        Query                   query = new Query();
        QueryBuildDataSource    queryBuildDataSource;
        
        sysTableLookup.addLookupfield(fieldNum(MobPostOrderPromptOverrideLines, name),true);
        sysTableLookup.addLookupfield(fieldNum(MobPostOrderPromptOverrideLines, InputType));
        queryBuildDataSource = query.addDataSource(tableNum(MobPostOrderPromptOverrideLines));
        queryBuildDataSource.addSortField(fieldnum(MobPostOrderPromptOverrideLines, name));

        queryBuildDataSource.addOrderByField(fieldnum(MobPostOrderPromptOverrideLines, Name));

        queryBuildDataSource.orderMode(OrderMode::GroupBy);//Used to Group the Field Value
        queryBuildDataSource.addRange(fieldnum(MobPostOrderPromptOverrideLines,MobPostOrderPromptOverrideRecID)).value(queryValue(this.PostOrderPromptOverrideRecID));
        
        sysTableLookup.parmQuery(query);

        SysTableLookup.parmUseLookupValue(false);
        
        sysTableLookup.performFormLookup();        
    }

]]></Source>
