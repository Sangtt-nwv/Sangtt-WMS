		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Returns MobInventLocationsPickReceiveTypes if it exists else it returns null
    /// </summary>
    /// <param name="_inventLocationId"></param>
    /// <param name="_forupdate"></param>
    public static MobInventLocationsPickReceiveTypes find(InventLocationId _inventLocationId, boolean _forupdate = false)
    {
        MobInventLocationsPickReceiveTypes pickReceiveInfo;
    
        pickReceiveInfo.selectForUpdate(_forupdate);
    
        select firstOnly pickReceiveInfo
            where pickReceiveInfo.InventLocationId == _inventLocationId;
    
        return pickReceiveInfo;
    }

]]></Source>
			</Method>
			<Method>
				<Name>validateFieldValue</Name>
				<Source><![CDATA[
    /// <summary>
    ///
    /// </summary>
    /// <param name = "_fieldName"></param>
    /// <param name = "_arrayIndex"></param>
    /// <returns></returns>
    public boolean validateFieldValue(FieldName _fieldName, int _arrayIndex = 1)
    {
        boolean ret;
    
        ret = super(_fieldName, _arrayIndex);
    
        if (_fieldName == fieldStr(MobParameters, PickPickingRoute) && this.PickPickingRoute)
        {
            this.PickSale = NoYes::No;
        }
        else if (_fieldName == fieldStr(MobParameters, PickSale) && this.PickSale)
        {
            this.PickPickingRoute = NoYes::No;
        }
        else if (_fieldName == fieldStr(MobParameters, ReceiveArrival) && this.ReceiveArrival)
        {
            this.ReceivePurch = NoYes::No;
        }
        else if (_fieldName == fieldStr(MobParameters, ReceivePurch) && this.ReceivePurch)
        {
            this.ReceiveArrival = NoYes::No;
        }

        return ret;
    }

]]></Source>
