				<Name>Exists</Name>
				<Source><![CDATA[
    public static boolean Exists(MobConsolidatedPickingRouteId _routeId)
    {
        MobConsolidatedPickingRoutes	routeOrders;
        select firstonly RecId,ConsolidatedPickingRouteId from routeOrders where routeOrders.ConsolidatedPickingRouteId == _routeId;
        return routeOrders.RecId;
    }

]]></Source>
			</Method>
			<Method>
				<Name>Find</Name>
				<Source><![CDATA[
    public static MobConsolidatedPickingRoutes Find(MobConsolidatedPickingRouteId _routeId, boolean _selectForUpdate = false)
    {
        MobConsolidatedPickingRoutes	routeOrders;
        routeOrders.selectForUpdate(_selectForUpdate);
        select firstonly routeOrders where routeOrders.ConsolidatedPickingRouteId == _routeId;
        return routeOrders;
    }

]]></Source>
