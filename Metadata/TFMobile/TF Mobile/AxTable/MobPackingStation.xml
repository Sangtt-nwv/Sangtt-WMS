		<Methods>
			<Method>
				<Name>Find</Name>
				<Source><![CDATA[
    public static MobPackingStation Find(MobPackingStationID _packingStationId, boolean _selectForUpdate = false)
    {
        MobPackingStation PackStation;

        PackStation.selectForUpdate(_selectForUpdate);
        select firstonly PackStation where PackStation.PackingStationId == _packingStationId;
        return PackStation;
    }

]]></Source>
			</Method>
			<Method>
				<Name>FindByLocation</Name>
				<Source><![CDATA[
    public static MobPackingStation FindByLocation(InventLocationId _locId, WMSLocationId _wmsLoc, boolean _selectForUpdate = false)
    {
        MobPackingStation PackStation;

        PackStation.selectForUpdate(_selectForUpdate);
        select firstonly PackStation where PackStation.InventLocationId == _locId && PackStation.WMSLocationId == _wmsLoc;
        return PackStation;
    }

]]></Source>
			</Method>
			<Method>
				<Name>FindOrCreate</Name>
				<Source><![CDATA[
    public static MobPackingStation FindOrCreate(MobPackingStationID _packingStationId, InventLocationId _locId, WMSLocationId _wmsLoc)
    {
        MobPackingStation PackStation;

        ttsbegin;
        select firstonly forupdate PackStation where PackStation.PackingStationId == _packingStationId;

        PackStation.PackingStationId = _packingStationId;
        PackStation.InventLocationId = _locId;
        PackStation.WMSLocationId = _wmsLoc;
        PackStation.InventSiteId = InventLocation::find(_locId).InventSiteId;

        PackStation.write();
        ttscommit;
        return PackStation;
    }

]]></Source>
			</Method>
			<Method>
				<Name>addLicensePlate</Name>
				<Source><![CDATA[
    public static MobPackingStation addLicensePlate(MobPackingStationID _packingStationId)
    {
        MobPackingStation	PackStation;
        NumberSeq			num = NumberSeq::newGetNum(WHSParameters::numRefWHSLicensePlateId());

        ttsbegin;
        PackStation = MobPackingStation::Find(_packingStationId,true);
        PackStation.WhsLicensePlateId = num.num();
        
        num.used(); // mark the number as used
        PackStation.update();
        WHSLicensePlate::createLicensePlate(PackStation.WhsLicensePlateId);
        ttscommit;
        return PackStation;
    }

]]></Source>
			</Method>
