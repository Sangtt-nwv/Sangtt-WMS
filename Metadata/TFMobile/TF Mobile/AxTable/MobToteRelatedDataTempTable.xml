		<Methods>
			<Method>
				<Name>populateTmpData</Name>
				<Source><![CDATA[
    public static MobToteRelatedDataTempTable populateTmpData()
    {
        MobToteRelatedDataTempTable tmpTable;
        MobToteRelatedDataTempTable tmpTableCheck;
        MobToteTable				totes;
        RecordInsertList            recordInsertList;

        recordInsertList = new RecordInsertList(tableNum(MobToteRelatedDataTempTable));

        while select totes notexists join tmpTableCheck where tmpTableCheck.ToteId == totes.ToteId
        {
            tmpTable.ToteId			= totes.ToteId;
            tmpTable.PickingRouteID	= totes.pickingRoutes();
            tmpTable.ShipmentId		= totes.shipments();
            recordInsertList.add(tmpTable);
        }
        recordInsertList.insertDatabase();
        
        return tmpTable;
    }

]]></Source>
			</Method>
