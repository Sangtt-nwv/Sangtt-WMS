			<Method>
				<Name>FindCartTypeSubClass</Name>
				<Source><![CDATA[
    public static MobCartType FindCartTypeSubClass(str _scannedValue)
    {
        ListEnumerator	subClassEnum = new SysDictClass(classNum(MobCartType)).extendedBy(true).getEnumerator();
        SysDictClass	subClass;
        MobCartType		cartType;
        while (subClassEnum.moveNext())
        {
            subClass = new SysDictClass(subClassEnum.current());
            cartType = subClass.makeObject();
            if (cartType.handleScan(_scannedValue))
            {
                return cartType;
            }
        }
        return null;
    }

]]></Source>
